<partial name="_Register" />


<style>
    /* Video container styles */
    .videoitem {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* 16:9 aspect ratio */
        background: #000;
        overflow: hidden;
    }

        .videoitem img,
        .videoitem iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Play button overlay */
    .video-play-button {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s ease;
    }

        .video-play-button:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        .video-play-button svg {
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
        }

    /* Loading spinner */
    .video-loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 20;
    }

        .video-loading::after {
            content: "";
            display: block;
            width: 60px;
            height: 60px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #0066CC;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Fade animations */
    .fade-out {
        animation: fadeOut 0.3s forwards;
    }

    .fade-in {
        animation: fadeIn 0.5s forwards;
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>
<script>
   
    function openVideo(imgElement) {
        // Nếu click vào play button, lấy img element
        const videoContainer = imgElement.closest('.videoitem');
        const thumbnail = videoContainer.querySelector('.video-thumbnail');
        const playButton = videoContainer.querySelector('.video-play-button');

        if (!thumbnail) {
            console.error('Không tìm thấy thumbnail');
            return;
        }

        // Lấy URL iframe từ data-iframe attribute
        const iframeUrl = thumbnail.getAttribute('data-iframe');

        if (!iframeUrl) {
            console.error('Không tìm thấy data-iframe attribute');
            return;
        }

        // Ẩn play button với fade effect
        if (playButton) {
            playButton.classList.add('fade-out');
            setTimeout(() => playButton.remove(), 300);
        }

        // Thêm loading spinner
        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'video-loading';
        videoContainer.appendChild(loadingDiv);

        // Fade out thumbnail
        thumbnail.classList.add('fade-out');

        // Tạo iframe element với lazy loading
        const iframe = document.createElement('iframe');
        iframe.title = thumbnail.getAttribute('title') || 'video giới thiệu';
        iframe.frameBorder = '0';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy'; // Lazy loading attribute

        // Thêm class để iframe responsive
        iframe.className = 'fade-in';
        iframe.style.opacity = '0';

        // Event khi iframe load xong
        iframe.onload = function() {
            // Xóa loading spinner
            loadingDiv.remove();

            // Xóa thumbnail
            thumbnail.remove();

            // Hiển thị iframe
            iframe.style.opacity = '1';
        };

        // Thêm iframe vào container
        videoContainer.appendChild(iframe);

        // Set src sau khi append để trigger lazy load
        setTimeout(() => {
            iframe.src = iframeUrl;
        }, 100);

        // Fallback: Nếu iframe không load sau 5s, vẫn hiển thị
        setTimeout(() => {
            if (loadingDiv.parentNode) {
                loadingDiv.remove();
            }
            iframe.style.opacity = '1';
        }, 5000);
    }

    // Preconnect to YouTube để tăng tốc load video
    (function() {
        const preconnect = document.createElement('link');
        preconnect.rel = 'preconnect';
        preconnect.href = 'https://www.youtube.com';
        document.head.appendChild(preconnect);

        const preconnectCdn = document.createElement('link');
        preconnectCdn.rel = 'preconnect';
        preconnectCdn.href = 'https://i.ytimg.com';
        document.head.appendChild(preconnectCdn);
    })();
</script>