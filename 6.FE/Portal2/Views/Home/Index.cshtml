                        </div>
                    </div>

                    <div class="clearfix mb-6"></div>
                }
                else
                {
                    <div class="col-lg-5 col-sm-12">
                        <div class="why-title"><a href="@path">@item.Name</a></div>
                        <svg width="156" height="2" viewBox="0 0 156 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="0.666626" width="156" height="4" fill="url(#paint0_linear_4337_26784)" />
                            <defs>
                                <linearGradient id="paint0_linear_4337_26784" x1="-22.7334" y1="0.7" x2="-22.0174" y2="14.2709" gradientUnits="userSpaceOnUse">
                                    <stop offset="0.384615" stop-color="#034EA2" />
                                    <stop offset="1" stop-color="#53DFFF" />
                                </linearGradient>
                            </defs>
                        </svg>
                        <p class="why-desc">@Html.Raw(item.Summary)</p>
                        <div class="hotro-list">
                            <div class="row">
                                @for (int j = 0; j < item.Relateds.Count; j++)
                                {
                                    string pathItem = PT.Shared.Functions.FormatUrl(item.Relateds[j].Language, item.Relateds[j].Link?.Slug);
                                    @* string cssCol = (j % 2 == 0) ? "col-sm-5" : "col-sm-7"; *@
                                    <div class="mb-3 item d-flex flex-row flex-wrap col-sm-12">
                                        <div class="left"><img src="/Data/Banner/iconht.svg" alt="@item.Relateds[j].Input2" /></div>
                                        <div class="right"><a href="@pathItem"><span>@item.Relateds[j].Input2</span></a></div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="pt-4">
                            <a class="show-more" href="@path">Khám phá thêm <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
                        </div>
                    </div>
                    <div class="col-sm-7 d-none d-md-block text-right">
                        <a href="@path" title="Hỗ trợ">
                            <img src="@item.Banner" class="img-hotro" alt="Hỗ trợ" loading="lazy" />
                        </a>
                    </div>
                    <div class="clearfix mb-6"></div>
                }
                { flowi++; }
            }
        </div>
        <div class="text-center p-dangky">
            <a class="btn btn-primary btn-join" href="#DangKy" title="Đăng kí để nhận tư vấn">Đăng kí để nhận tư vấn</a>
