@using Microsoft.Extensions.Options
@inject PT.Infrastructure.Interfaces.IContactRepository _iContactRepository;
@inject IOptions<BaseSettings> _baseSettings;
@inject IViewLocalizer Localizer;
@model PT.UI.Models.ContactHomeModel;
@inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.AuthorizeSettings> _authorizeSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@{
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var listLanguage = PT.Shared.ListData.ListLanguage;
  
    var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
    var portalId = _baseSettings.Value.PortalId;
    var listServies = await _iContactRepository.ServiesList(language, portalId);
    var listProducts = await _iContactRepository.ProductList(language, portalId);
}

<section class="py-5 mb-3 mt-3" id="DangKy">
    <div class="container">
        <h2 class="price-title mb-5">@Localizer["Title"]</h2>
        <div class="row">
            <div class="col-lg-6 col-sm-12">
                <input type="hidden" id="languageId" value="@language" />
                <form id="formLienHe" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <input type="hidden" asp-for="Language" value="@language" />
                        <div class="col-sm-12 mb-2"><label class="form-label" asp-for="FullName"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="FullName" placeholder=""><span class="validate-style" asp-validation-for="FullName"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="Phone"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="Phone" placeholder=""><span class="validate-style" asp-validation-for="Phone"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="Email"></label> <strong class="error">*</strong><input type="email" class="form-control" asp-for="Email" placeholder=""><span class="validate-style" asp-validation-for="Email"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="ConpanyName"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="ConpanyName" placeholder=""><span class="validate-style" asp-validation-for="ConpanyName"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="Position"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="Position" placeholder=""><span class="validate-style" asp-validation-for="Position"></span></div>
                        <div class="col-sm-12 mb-2"><label class="form-label" for="dichVuQT" asp-for="ServiceId"></label> <strong class="error">*</strong><select asp-for="ServiceId" asp-items="listServies" class="form-select" id="dichVuQT"><option value="">@Localizer["SelectServiceId"]</option></select><span asp-validation-for="ServiceId" class="validate-style"></span></div>
                       
                        <div class="col-sm-12 mb-2">
                            <label class="form-label" asp-for="Products" for="sanPhamQT"></label> 
                            <strong class="error">*</strong>
                            <select class="form-select" id="sanPhamQT" asp-items="listProducts" multiple="multiple"></select>
                            <span class="validate-style" asp-validation-for="Products"></span>
                        </div>

                        <div class="col-sm-12 mb-2"><label class="form-label" for="yeuCauCT" asp-for="Content"></label><textarea type="text" maxlength="1000" asp-for="Content" class="form-control txt-area" id="yeuCauCT" placeholder="@Localizer["ContentPlaceholder"]"></textarea><span class="validate-style" asp-validation-for="Content"></span><input type="hidden" class="form-control" id="products" asp-for="Products"></div>
                        @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ContactFormMsg", language = language, portalId = portalId })
                    </div><div class="mb-2"></div><button type="submit" class="btn btn-primary col-sm-12 btn-yeucau" btnSendLH>@Localizer["BtnSend"]</button><input type="hidden" class="Capcha" id="g-recaptcha-response" name="capcha" />
                </form>
            </div><div class="col-lg-6 col-sm-12 img">@await Component.InvokeAsync("ViewModule", new { type = ModuleType.AdvertisingBanner, code = "HomeBannerRegister", language = language, portalId = portalId })</div>
        </div>
    </div>
</section>

<script>
    // ⭐ Khởi tạo config object với tất cả giá trị cần thiết
    window.registerFormConfig = {
        // URLs
        urls: {
            contact: '@Url.Action("Contact", "ContactHome")',
            flowSelectList: '@Url.Action("FlowSelectList", "ContactHome")'
        },
        // Localized strings
        i18n: {
            selectProducts: '@Localizer["SelectProducts"]',
            otherProduct: '@Localizer["OtherProduct"]',
            msgNotUse: '@Localizer["MsgNotUse"]',
            noProducts: '@Localizer["NoProducts"]',
            errorMessage: 'Đã xảy ra lỗi, vui lòng F5 trình duyệt và thử lại!'
        },
        // Data
        language: '@language',
        portalId: @portalId
    };

    // ⭐ Gọi function từ site.js khi document ready
    $(document).ready(function() {
        if (typeof initRegisterForm === 'function') {
            initRegisterForm(window.registerFormConfig);
        } else {
            console.error('initRegisterForm function not found in site.js');
        }
    });
</script>