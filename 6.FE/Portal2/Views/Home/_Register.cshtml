<link href="/plugins/select2/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="/plugins/alertifyjs/css/alertify.min.css" />
<link rel="stylesheet" href="/plugins/alertifyjs/css/themes/default.min.css" />
<script src="/plugins/jquery-validate/jquery.validate.min.js"></script>
<script src="/plugins/jquery-validate/jquery.validate.unobtrusive.min.js"></script>
<script src="/plugins/alertifyjs/alertify.min.js"></script>
<script src="/plugins/select2/select2.min.js"></script>
<script>
	$(function () {
	  const $form = $('#formLienHe');
	  $form.on('submit', function (e) {
		e.preventDefault();
		if (!$form.valid()) {
		  return;
		}
		const token = $form.find('input[name="__RequestVerificationToken"]').val();
		$.ajax({
		  url: '@Url.Action("Contact", "ContactHome")',
		  type: 'POST',
		  data: $form.serialize(),
		  headers: { 'RequestVerificationToken': token },
		  success: function (res) {
			alertify.success(res.message);
			$form[0].reset();
		  },
		  error: function (xhr) {
			alertify.warning('Đã xảy ra lỗi, vui lòng F5 trình duyệt và thử lại!');
		  }
		});
	  });
	});

	 $('#sanPhamQT').select2({
			placeholder: "Chọn Sản phẩm & dịch vụ quan tâm",
			closeOnSelect: false,
			allowHtml: true,
			allowClear: true,
			tags: true
		});
	$("#sanPhamQT").on("change", function () {
        let selected = $(this).val(); 
        if (selected && selected.length > 0) {
            $("#products").val(selected.join("; "));
        } else {
            $("#products").val("");
        }
    });

	$("#dichVuQT").on("change", function () {
		let serviceId = $(this).val();      
		let language = $("#languageId").val();;             
		let portId = @portalId; 
		let parentId = serviceId;
		$("#products").val("");
		if (!serviceId) {
			$("#sanPhamQT").empty()
				.append('<option value="">Chọn sản phẩm & dịch vụ quan tâm</option>');
			return;
		}

		$.ajax({
			url: '@Url.Action("FlowSelectList", "ContactHome")',
			method: "POST",
			data: {
				language: language,
				portId: portId,
				parrentId: parentId
			},
			success: function (res) {
				console.log(res);
				if (res.output === 1 || res.output === "1") {
					$("#sanPhamQT").empty();
					let lst = res.data;
					if (lst && lst.length > 0) {
						lst.forEach(x => {
							$("#sanPhamQT").append(
								`<option value="${x.id}">${x.name}</option>`
							);
						});
					} else {
						$("#sanPhamQT").append('<option value="">Không có sản phẩm</option>');
					}
				}
				else {
					//alert(res.message || "Không thể tải danh sách!");
				}
			},
			error: function () {
				//alert("Lỗi kết nối máy chủ.");
			}
		});
	});

</script>
