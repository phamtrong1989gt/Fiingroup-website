}
<style>

</style>
<section class="py-5 mb-3 mt-3" id="DangKy">
    <div class="container">
        <h2 class="price-title mb-5">@Localizer["Title"]</h2>
        <div class="row">
            <div class="col-lg-6 col-sm-12">
                <input type="hidden" id="languageId" value="@language" />
                <form id="formLienHe" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-sm-12 mb-2">
                            <label class="form-label" asp-for="FullName"></label> <strong class="error">*</strong>
                            <input type="text" class="form-control" asp-for="FullName" placeholder="">
                            <span class="validate-style" asp-validation-for="FullName"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label class="form-label" asp-for="Phone"></label> <strong class="error">*</strong>
                            <input type="text" class="form-control" asp-for="Phone" placeholder="">
                            <span class="validate-style" asp-validation-for="Phone"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label class="form-label" asp-for="Email"></label> <strong class="error">*</strong>
                            <input type="email" class="form-control" asp-for="Email" placeholder="">
                            <span class="validate-style" asp-validation-for="Email"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label class="form-label" asp-for="ConpanyName"></label> <strong class="error">*</strong>
                            <input type="text" class="form-control"  asp-for="ConpanyName" placeholder="">
                            <span class="validate-style" asp-validation-for="ConpanyName"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label class="form-label" asp-for="Position"></label> <strong class="error">*</strong>
                            <input type="text" class="form-control" asp-for="Position" placeholder="">
                            <span class="validate-style" asp-validation-for="Position"></span>
                        </div>

                        <div class="col-sm-12 mb-2">
                            <label class="form-label">
                                @if (language == "vi") 
                                { 
                                    <text>Nhóm ngành</text> 
                                } 
                                else 
                                { 
                                    <text>Sector Expertise</text> 
                                }
                            </label> <strong class="error">*</strong>
                            <select asp-for="ServiceId" asp-items="sectorExpertiseList" class="form-select" id="dichVuQT">
                                <option value="">@Localizer["SelectServiceId"]</option>
                            </select>
                            <span asp-validation-for="ServiceId" class="validate-style"></span>
                        </div>

                        <div class="col-sm-12 mb-2">
                            <label class="form-label" asp-for="Products"></label> <strong class="error">*</strong>
                            <select class="form-select" id="sanPhamQT" asp-items="productsServicesList" multiple="multiple">
                            </select>
                            <span class="validate-style" asp-validation-for="Products"></span>
                        </div>
                        <div class="col-sm-12 mb-2">
                            <label class="form-label" asp-for="Content"></label>
                            <textarea type="text" maxlength="1000" asp-for="Content" class="form-control txt-area" id="yeuCauCT" placeholder=""></textarea>
                            <span class="validate-style" asp-validation-for="Content"></span>
                            <input type="hidden" class="form-control" id="products" asp-for="Products">
                        </div>
                    </div>
                    <div class="mb-2"></div>
                    <button type="submit" class="btn btn-primary col-sm-12 btn-yeucau" btnSendLH>@Localizer["BtnSend"]</button>
                    <input type="hidden" class="Capcha" id="g-recaptcha-response" name="capcha" />
                </form>
            </div>
            <div class="col-lg-6 col-sm-12 img">
                @await Component.InvokeAsync("ViewModule", new { type = ModuleType.AdvertisingBanner, code = "HomeBannerRegister", language = language, portalId = portalId })
            </div>
        </div>
    </div>
</section>
@section Scripts
{
}

<script>

    $(function () {
            $('#sanPhamQT').select2({
               placeholder: "@Localizer["SelectProducts"]",
               closeOnSelect: false,
               allowHtml: true,
               allowClear: true,
               tags: true
            });
      const $form = $('#formLienHe');
      $form.on('submit', function (e) {
        e.preventDefault();

        // Validate ServiceId
        var serviceVal = $('#dichVuQT').val();
        var $serviceMsg = $('[data-valmsg-for="ServiceId"]');
        if (!serviceVal || serviceVal.toString().trim() === '') {
          $serviceMsg.text('@Localizer["MsgNotUse"]');
          $serviceMsg.addClass('field-validation-error').removeClass('field-validation-valid');
          $('#dichVuQT').focus();
          return;
        } else {
          $serviceMsg.text('');
          $serviceMsg.addClass('field-validation-valid').removeClass('field-validation-error');
        }

        // Validate products (select2 -> hidden input #products)
        var productsVal = $('#products').val();
        var $prodMsg = $('[data-valmsg-for="Products"]');
        if (!productsVal || productsVal.toString().trim() === '') {
          $prodMsg.text('@Localizer["MsgNotUse"]');
          $prodMsg.addClass('field-validation-error').removeClass('field-validation-valid');
          $('#sanPhamQT').select2('open');
          return;
        } else {
          $prodMsg.text('');
          $prodMsg.addClass('field-validation-valid').removeClass('field-validation-error');
        }

        if (!$form.valid()) {
          return;
        }
        const token = $form.find('input[name="__RequestVerificationToken"]').val();
        $.ajax({
          url: '@Url.Action("Contact", "ContactHome")',
          type: 'POST',
          data: $form.serialize(),
          headers: { 'RequestVerificationToken': token },
          success: function (res) {
            if(res.output == 1)
            {
                alertify.success(res.message);
                $form[0].reset();
                $("#products").val("");
                $('#sanPhamQT').val(null).trigger('change');
                hideRecaptchaPopup();
                if (recaptchaWidgetId !== null) {
                    grecaptcha.reset(recaptchaWidgetId);
                }
            }
            else if (res.output == 69) {
                showRecaptchaPopup("[btnSendLH]");
                return;
            }
          },
          error: function (xhr) {
            alertify.warning('@Localizer["ErrorMessage"]');
          }
        });
      });
    });

    $("#sanPhamQT").on("change", function () {
        let selected = $(this).val();
        if (selected && selected.length > 0) {
            $("#products").val(selected.join("; "));
            $('[data-valmsg-for="Products"]').text('').addClass('field-validation-valid').removeClass('field-validation-error');
        } else {
            $("#products").val("");
        }
    });

</script>
