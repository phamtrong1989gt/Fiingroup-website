@inject PT.Infrastructure.Interfaces.IContactRepository _iContactRepository;

@{
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var listLanguage = PT.Shared.ListData.ListLanguage;
	@model PT.UI.Models.ContactSolotionModel;
	@inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.AuthorizeSettings> _authorizeSettings;
	@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
	var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
	var portalId = 2;
	var listServies = await _iContactRepository.ServiesNewsList(language, portalId);
	var contactType = (int)Contact.ContactType.Contact;
}

<div class="modal" tabindex="-1" role="dialog" id="popsolutionmore">
	<div class="modal-dialog" role="document" style="margin-top:10%;">
		<div class="modal-content" style="background:#fff;">
			<div class="text-right">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close" style="background:transparent;border:none;width:26px;">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<div class="col-lg-12 col-sm-12">
					@* <form form-edit method="post" asp-action="Contact" asp-controller="ContactHome"> *@
					<input type="hidden" id="languageId" value="@language" />
					<form id="formLienHe" method="post">
						@Html.AntiForgeryToken()
						<div class="row">
							<div class="col-sm-6 mb-3">
								<label for="hoTen" class="form-label">Họ và tên <span class="error">*</span></label>
								<input type="text" class="form-control" id="hoTen" asp-for="FullName" placeholder="Nhập họ và tên">
								<span class="validate-style" asp-validation-for="FullName"></span>
							</div>
							<div class="col-sm-6 mb-3">
								<label for="soDienThoai" class="form-label">Số điện thoại <span class="error">*</span></label>
								<input type="text" class="form-control" id="soDienThoai" asp-for="Phone" placeholder="Nhập số điện thoại">
								<span class="validate-style" asp-validation-for="Phone"></span>
							</div>
							<div class="col-sm-12 mb-3">
								<label for="email" class="form-label">Email <span class="error">*</span></label>
								<input type="email" class="form-control" id="email" asp-for="Email" placeholder="Nhập email">
								<span class="validate-style" asp-validation-for="Email"></span>
							</div>

							<div class="col-sm-12 mb-3">
								<label for="dichVuQT" class="form-label">Nhận tin tức liên quan đến lĩnh vực</label>
								<select asp-items="listServies" class="form-select" id="dichVuQT" multiple="multiple">
									<option value="">Chọn nhận tin tức liên quan đến lĩnh vực</option>
								</select>
								<input type="hidden" class="form-control" id="type" asp-for="Type" value="@contactType">
								<input type="hidden" class="form-control" id="products" asp-for="Products">
							</div>
						</div>
						<button type="submit" class="btn btn-primary col-sm-12 btn-yeucau" btnSendLH>Nhận tin tức</button>
						@* <div class="row">
						<div class="sumaryValidateForm" asp-validation-summary="All"></div>
					</div> *@
						@* <input type="hidden" id="g-recaptcha-response" name="capcha" /> *@
					</form>
				</div>
			</div>
			@* <div class="modal-footer">
				<button type="button" class="btn btn-primary">Save changes</button>
				<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
			</div> *@
		</div>
	</div>
</div>
