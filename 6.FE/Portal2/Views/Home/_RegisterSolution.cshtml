@using Microsoft.Extensions.Options
@inject PT.Infrastructure.Interfaces.IContactRepository _iContactRepository;
@inject IOptions<BaseSettings> _baseSettings;
@inject IViewLocalizer Localizer;
@model PT.UI.Models.ContactSolotionModel;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;

@{
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var listLanguage = PT.Shared.ListData.ListLanguage;
    @inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.AuthorizeSettings> _authorizeSettings;
    @inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
    var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
    var portalId = _baseSettings.Value.PortalId;
    var listFlow = await _iContentPageRepository.SearchAsync(true,0, 0 , x => x.Language == language && x.PortalId == portalId && x.CategoryType == ECategoryType.ContentPage_Flow && x.Status);
    var listServies = listFlow.Select(x => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem
    {
        Value = x.Id.ToString(),
        Text = x.Name
    }).ToList();
}

<div class="modal" tabindex="-1" role="dialog" id="popsolutionmore">
    <div class="modal-dialog" role="document" style="margin-top:10%;width: 800px;max-width: 800px;">
        <div class="modal-content" style="background:#fff;">
            <button type="button" id="btnClose" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-lg-12 col-sm-12">
                    <input type="hidden" id="languageId" value="@language" />
                    <form id="formLienHe2" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-sm-6 mb-2">
                                <label class="form-label" for="hoTen" asp-for="FullName"></label> <strong class="error">*</strong>
                                <input type="text" class="form-control" id="hoTen" asp-for="FullName" placeholder="">
                                <span class="validate-style" asp-validation-for="FullName"></span>
                            </div>
                            <div class="col-sm-6 mb-2">
                                <label asp-for="Phone" for="soDienThoai" class="form-label"></label><span class="error">*</span>
                                <input type="text" class="form-control" id="soDienThoai" asp-for="Phone" placeholder="">
                                <span class="validate-style" asp-validation-for="Phone"></span>
                            </div>
                            <div class="col-sm-12 mb-2">
                                <label asp-for="Email" for="email" class="form-label"></label><span class="error">*</span>
                                <input type="email" class="form-control" id="email" asp-for="Email" placeholder="">
                                <span class="validate-style" asp-validation-for="Email"></span>
                            </div>

                            <div class="col-sm-6 mb-2">
                                <label class="form-label"  asp-for="ConpanyName"></label> <strong class="error">*</strong>
                                <input type="text" class="form-control" asp-for="ConpanyName" placeholder="">
                                <span class="validate-style" asp-validation-for="ConpanyName"></span>
                            </div>
                            <div class="col-sm-6 mb-2">
                                <label class="form-label" asp-for="Position"></label> <strong class="error">*</strong>
                                <input type="text" class="form-control" asp-for="Position" placeholder="">
                                <span class="validate-style" asp-validation-for="Position"></span>
                            </div>

                            <div class="col-sm-12 mb-3">
                                <label asp-for="Products" for="dichVuQT2" class="form-label"></label>
                                <input class="Capcha" type="hidden" id="g-recaptcha-response" name="capcha" />
                                <select asp-items="listServies" class="form-select" id="dichVuQT2" multiple="multiple" style="width:100%;">
                                </select>
                                <input type="hidden" class="form-control" id="products2" asp-for="Products">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary col-sm-12 btn-yeucau" btnSendLH2>@Localizer["BtnSend"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts
{
}
<script>
    $(function () {
            $('#dichVuQT2').select2({
            placeholder: "",
            closeOnSelect: false,
            allowHtml: true,
            allowClear: true,
            tags: true
            });
      const $form = $('#formLienHe2');
      $form.on('submit', function (e) {
        e.preventDefault();
              
        // Validate products (select2 -> hidden input #products2)
        var productsVal = $('#products2').val();
        var $prodMsg = $('[data-valmsg-for="Products"]');

        if (!productsVal || productsVal.toString().trim() === '') {
          // show validation message and prevent submit
          $prodMsg.text('@Localizer["MsgNotUse"]');
          $prodMsg.addClass('field-validation-error').removeClass('field-validation-valid');
          $('#dichVuQT2').select2('open');
          return;
        } else {
          // clear previous message
          $prodMsg.text('');
          $prodMsg.addClass('field-validation-valid').removeClass('field-validation-error');
        }

        if (!$form.valid()) {
          return;
        }

        const token = $form.find('input[name="__RequestVerificationToken"]').val();
        $.ajax({
          url: '@Url.Action("ContactSolution", "ContactHome")',
          type: 'POST',
          data: $form.serialize(),
          headers: { 'RequestVerificationToken': token },
          success: function (res) {

            if(res.output == 1)
            {
                alertify.success(res.message);
                $form[0].reset();
                $('#popsolutionmore').modal('hide');
                $("#products2").val("");
                hideRecaptchaPopup();
                if (recaptchaWidgetId !== null) {
                    grecaptcha.reset(recaptchaWidgetId);
                }
            }
            else if (res.output == 69) {
                showRecaptchaPopup("[btnSendLH2]");
                return;
            }
          },
          error: function (xhr) {
            alertify.warning('Đã xảy ra lỗi, vui lòng F5 trình duyệt và thử lại!');
          }
        });
      });
    });

    $("#btnClose").on("click", function () {
        $('#popsolutionmore').modal('hide');
    });
        $(document).on("change", "#dichVuQT2", function () {
            let selected = $(this).val();
            let $popup = $(this).closest(".modal"); // lấy đúng popup đang mở
            if (Array.isArray(selected) && selected.length > 0) {
                $popup.find("#products2").val(selected.join("; "));
                // clear validation message when user selects
                $popup.find('[data-valmsg-for="Products"]').text("").addClass('field-validation-valid').removeClass('field-validation-error');
            }
            else {
                $popup.find("#products2").val("");
            }
        });
</script>
