@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using PT.Domain.Model;
@using PT.Infrastructure.Interfaces;
@using PT.Shared;
@inject IViewLocalizer Localizer;
@using System.Linq.Expressions;
@using PT.UI.Models

@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = 2;
}

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDetailNewsDetail", language = language, portalId = portalId }))
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDetailNewsFeatured", language = language, portalId = portalId }))
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDetailDeliver", language = language, portalId = portalId }))
