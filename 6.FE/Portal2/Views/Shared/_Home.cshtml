@using PT.Base.Services
@using PT.Domain.Model;
@using PT.UI.Models
@addTagHelper *, PT.UI
@inject Microsoft.Extensions.Options.IOptions<AuthorizeSettings> _authorizeSettings;
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Options.IOptions<BaseSettings> _baseSettings;
@inject ISettingService _settingService;

@{
	string domain = Context.Request.Host.ToString();
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var listLanguage = PT.Shared.ListData.ListLanguage;
	var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
	var portalId = _baseSettings.Value.PortalId;
	var seoSettings = await _settingService.SeoSettingGet(language, portalId);
    var bindContentSetting = await _settingService.BindContentSettingGet(portalId);
	var homeModel = new HomeModel
	{
		Domain = domain,
		SeoSetting = seoSettings ?? new SeoSetting()
	};
	var currentType = PT.Base.CookieExtensions.Get("CurrentPrice");

	var linkData = new Link();
	if (ViewData["linkData"] != null)
	{
		linkData = (Link)ViewData["linkData"];
	}
}

<!DOCTYPE html>
<html lang="en">

<head>
	<!-- meta tags -->
	<meta charset="UTF-8">

	<meta name="robots" content="noindex">
	<meta name="googlebot" content="noindex">

	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/x-icon" href="assets/img/logo/favicon.png">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/assets/lib/bootstrap-5.2.2-dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="/assets/css/fonts/font-awesome/4.7.0/css/font-awesome.min.css" />
	<link asp-append-version="true" rel="stylesheet" href="/assets/css/style.css?v=1.1.6" />
	<link rel="stylesheet" href="/assets/lib/OwlCarousel2-2.3.4/dist/assets/owl.carousel.min.css" />
	<link rel="stylesheet" href="/assets/lib/OwlCarousel2-2.3.4/dist/assets/owl.theme.default.min.css" />
	<link rel="stylesheet" href="/plugins/alertifyjs/css/alertify.min.css" />
	<link href="/plugins/select2/select2.min.css" rel="stylesheet" />
	<link rel="stylesheet" href="/plugins/alertifyjs/css/themes/default.min.css" />
	<link asp-append-version="true" rel="stylesheet" href="/assets/css/custom.css" />
	<link asp-append-version="true" rel="stylesheet" href="/assets/css/custom2.css" />
	<link href="/assets/lib/fancybox/dist/jquery.fancybox.min.css" rel="stylesheet" />
	<script src="/assets/js/jquery.min.js"></script>
	<partial name="_HomeHead" model="@(new Tuple<HomeModel, Link>(homeModel, linkData))" />
	@Html.Raw(bindContentSetting.Head)
	<style>
		.field-validation-error {
			font-size: 12px;
			position: absolute;
		}

		.form-select
		{
            font-size: 14px !important;
			border-radius: 4px !important;
		}
		.select2-container--default .select2-selection--multiple .select2-selection__rendered
		{
			padding: 0 10px !important;
		}
		.select2-selection__choice
		{
			font-size: 13px !important;
			background-color: #034ea2 !important;
			border: 1px solid #023b7b !important;
			color: #fff;
		}

		.select2-results__option
		{
			font-size: 14px !important;	
		}

		/* Backdrop overlay - làm mờ background */
		#recaptcha-backdrop {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: rgba(0, 0, 0, 0.6);
			backdrop-filter: blur(5px);
			z-index: 9998;
		}

		/* reCAPTCHA popup wrapper */
		#recaptcha-wrapper {
			display: none;
			position: fixed;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: white;
			padding: 20px;
			border-radius: 8px;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			z-index: 9999;
			min-width: 340px;
		}

		/* reCAPTCHA container - MUST be empty for Google API */
		#recaptcha-container {
			min-width: 304px;
		}

		/* Loading spinner */
		#recaptcha-loading {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 78px;
		}

		.spinner {
			border: 4px solid #f3f3f3;
			border-top: 4px solid #3498db;
			border-radius: 50%;
			width: 40px;
			height: 40px;
			animation: spin 1s linear infinite;
		}

		@@keyframes spin {
			0% {
				transform: rotate(0deg);
			}

			100% {
				transform: rotate(360deg);
			}
		}

		#recaptcha-loading p {
			margin-top: 15px;
			color: #666;
			font-size: 14px;
		}

		/* Close button cho popup */
		#recaptcha-close-btn, #btnClose {
			position: absolute;
			top: -15px;
			right: -15px;
			background: #034ea2;
			color: white;
			border: none;
			border-radius: 50%;
			width: 30px;
			height: 30px;
			cursor: pointer;
			font-size: 18px;
			line-height: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			z-index: 10000;
		}

			#recaptcha-close-btn:hover {
				background: #d32f2f;
			}
	</style>
</head>

<body id="Body">
	@* <h1>@language</h1> *@
	<div class="body">
		<!-- header area -->
		<section id="Header">
			@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "HomeBannerTop", language = language, portalId = portalId })
			@await Component.InvokeAsync("ViewModule", new { type = ModuleType.Menu, code = "MenuPC", language = language, portalId = portalId })
			
		</section>
		<!-- header area end -->
		@RenderBody()
		<!-- footer area -->
		<div class="footter hidden-login">
			@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "HomeFooter", language = language, portalId = portalId })
			@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "HomeFooterMenu", language = language, portalId = portalId })
		</div>
		<!-- footer area end -->
		@await Component.InvokeAsync("ViewModule", new { type = ModuleType.Menu, code = "MenuMobile", language = language, portalId = portalId })
		<partial name="~/Views/Home/_RegisterSolution.cshtml" model="@(new ContactSolotionModel { })" /> 

		<!-- scroll-top -->
		<button class="btn btn-info rounded-circle btn-lg" id="scroll-top"><i class="fa fa-chevron-up" style="color:white;"></i></button>
		<!-- scroll-top end -->
		<div id="recaptcha-backdrop"></div>
		<div id="recaptcha-wrapper">
			<button id="recaptcha-close-btn" type="button">&times;</button>
			<div id="recaptcha-loading">
				<div class="spinner"></div>
				<p>@Localizer["Đang tải xác thực..."]</p>
			</div>
			<div id="recaptcha-container"></div>
		</div>
	</div>
	<!-- js -->
	<script src="/plugins/jquery-validate/jquery.validate.min.js"></script>
	<script src="/plugins/jquery-validate/jquery.validate.unobtrusive.min.js"></script>
	<script src="/plugins/alertifyjs/alertify.min.js"></script>
	<script src="/plugins/select2/select2.min.js"></script>
	<script src="/assets/lib/bootstrap-5.2.2-dist/js/bootstrap.bundle.min.js"></script>
	<script src="/assets/js/bootstrap.js?v=5.5.9"></script>
	<script src="/assets/js/owl.carousel.min.js?v=5.5.9"></script>
	<script asp-append-version="true" src="/assets/js/site.js?v=1.0"></script>
	<script src="/assets/js/waypoints.min.js"></script>
	<script src="/assets/js/jquery.counterup.min.js"></script>
	<script src="/assets/lib/fancybox/dist/jquery.fancybox.min.js"></script>
	<script src="https://www.google.com/recaptcha/api.js" async defer></script>



	<script>
		$(document).ready(
			function () {

				$("#keySearch").on('change keyup paste', function () {
				$("#search-content").show();
				var key = $(this).val();
					if (key.length >= 3 || key.length == 0) {
							var url = '@Url.Action("Search", "Home")';
							// Call API Search and bind results into #search-content
							function bindSearchResults(data) {
								var $container = $('#search-content');
								$container.empty();
								if (!data || !Array.isArray(data) || data.length === 0) {
									$container.append('<ul class="list-unstyled"><li>Không có kết quả tìm kiếm</li></ul>');
									return;
								}
								var $ul = $('<ul class="list-unstyled"></ul>');
								data.forEach(function (item) {
									var title = item.Title || item.title || item.Name || item.name || item.Text || item.text || 'Không có tiêu đề';
									var href = item.href || item.Href || item.url || item.Link || item.link || '#';
									var $li = $('<li></li>');
									var $a = $('<a></a>').attr('href', href).text(title);
									$li.append($a);
									$ul.append($li);
								});
								$container.append($ul);
							}

							// perform GET
							$.get(url, { key: key, language: '@language' })
								.done(function (res) {
									var data = res && res.data ? res.data : res;
									bindSearchResults(data);
								})
								.fail(function () {
									$('#search-content').empty().append('<ul class="list-unstyled"><li>Không có kết quả tìm kiếm</li></ul>');
								});

						}
					});

					let owl = $('#owlour');
					owl.owlCarousel({
						margin: 0,
						autoplay: true,
						autoplayTimeout: 5000,
						nav: false,
						loop: true,
						dots: false,
						dotsData: true,
						pagination: false,
						margin: 0,
						responsive: {
							0: { items: 1 },
							600: { items: 2 },
							1000: { items: 3 }
						}
					})
					let owl2 = $('#manualsct');
					owl2.owlCarousel({
						margin: 0,
						autoplay: true,
						autoplayTimeout: 5000,
						nav: false,
						loop: true,
						dots: false,
						dotsData: true,
						pagination: false,
						responsive: {
							0: { items: 1 },
							600: { items: 3 },
							1000: { items: 7 }
						}
					});
					$('.counter').counterUp({
						delay: 10,
						time: 1200
					});
				}
			);
		 $(function () {
			let star = '.star',
				selected = '.selected';

			$(star).on('click', function () {
				$(selected).each(function () {
					$(this).removeClass('selected');
				});
				$(this).addClass('selected');
			});
		});
		 $(document).ready(function () {
			$(window).scroll(function () {
				if ($(this).scrollTop() > 200) {
					$('#scroll-top').fadeIn();
				} else {
					$('#scroll-top').fadeOut();
				}
			});
			$('#scroll-top').click(function () {
				$('html, body').animate({ scrollTop: 0 }, 500);
				return false;
			});
		});
	</script>
	<script>
		var recaptchaSiteKey = '@_authorizeSettings.Value.CapChaDataSitekey';
		var recaptchaWidgetId = null;
		var isRecaptchaShown = false;
		var btnSend = null;	
		// Initialize reCAPTCHA V2
		function initRecaptcha() {
			if (typeof grecaptcha !== 'undefined' && recaptchaWidgetId === null) {
				// Clear container to ensure it's empty
				$('#recaptcha-container').empty();

				recaptchaWidgetId = grecaptcha.render('recaptcha-container', {
					'sitekey': recaptchaSiteKey,
					'callback': onRecaptchaSuccess,
					'expired-callback': onRecaptchaExpired
				});

				// Hide loading, show reCAPTCHA
				$('#recaptcha-loading').hide();
				$('#recaptcha-container').show();
			}
		}

		// Callback when reCAPTCHA is successfully verified
		function onRecaptchaSuccess(token) {
			$(".Capcha").val(token);
			hideRecaptchaPopup();
			// Auto submit form after getting token
            $(this.btnSend).click();
		}

		// Callback when reCAPTCHA expires
		function onRecaptchaExpired() {
			$(".Capcha").val("");
			if (recaptchaWidgetId !== null) {
				grecaptcha.reset(recaptchaWidgetId);
			}
		}

		// Show reCAPTCHA popup
		function showRecaptchaPopup(btnElement) {
            this.btnSend = btnElement;
			if (!isRecaptchaShown) {
				// Show popup immediately with loading
				$('#recaptcha-loading').show();
				$('#recaptcha-container').hide();
				$("#recaptcha-backdrop").fadeIn(200);
				$("#recaptcha-wrapper").fadeIn(200);
				isRecaptchaShown = true;

				// Initialize reCAPTCHA (will hide loading when ready)
				if (typeof grecaptcha === 'undefined' || recaptchaWidgetId === null) {
					// Wait for grecaptcha to be ready
					var checkInterval = setInterval(function() {
						if (typeof grecaptcha !== 'undefined' && grecaptcha.render) {
							clearInterval(checkInterval);
							initRecaptcha();
						}
					}, 100);

					// Timeout after 5 seconds
					setTimeout(function() {
						clearInterval(checkInterval);
						if (recaptchaWidgetId === null) {
							$('#recaptcha-loading p').text('Lỗi tải reCAPTCHA. Vui lòng thử lại.');
						}
					}, 5000);
				} else {
					grecaptcha.reset(recaptchaWidgetId);
					$('#recaptcha-loading').hide();
					$('#recaptcha-container').show();
				}
			}
		}

		// Hide reCAPTCHA popup
		function hideRecaptchaPopup() {
			$("#recaptcha-backdrop").fadeOut(300);
			$("#recaptcha-wrapper").fadeOut(300);
			isRecaptchaShown = false;
		}

		$("#recaptcha-close-btn").on("click", function () {
			hideRecaptchaPopup();
        });
	</script>
	@Html.Raw(bindContentSetting.Body)
</body>
</html>
@Html.Raw(bindContentSetting.Footer)
<partial name="_SettingHome" />
@RenderSection("Scripts", required: false)
