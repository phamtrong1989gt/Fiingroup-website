					let owl = $('#owlour');
					owl.owlCarousel({
						margin: 0,
						autoplay: true,
						autoplayTimeout: 5000,
						nav: false,
						loop: true,
						dots: false,
						dotsData: true,
						pagination: false,
						margin: 0,
						responsive: {
							0: { items: 1 },
							600: { items: 2 },
							1000: { items: 3 }
						}
					})
					let owl2 = $('#manualsct');
					owl2.owlCarousel({
						margin: 0,
						autoplay: true,
						autoplayTimeout: 5000,
						nav: false,
						loop: true,
						dots: false,
						dotsData: true,
						pagination: false,
						responsive: {
							0: { items: 1 },
							600: { items: 3 },
							1000: { items: 7 }
						}
					});
					$('.counter').counterUp({
						delay: 10,
						time: 3000
					});
				}
			);
			 $(function () {
				let star = '.star',
					selected = '.selected';

				$(star).on('click', function () {
					$(selected).each(function () {
						$(this).removeClass('selected');
					});
					$(this).addClass('selected');
				});
			});
			 $(document).ready(function () {
				$(window).scroll(function () {
					if ($(this).scrollTop() > 200) {
						$('#scroll-top').fadeIn();
					} else {
						$('#scroll-top').fadeOut();
					}
				});
				$('#scroll-top').click(function () {
					$('html, body').animate({ scrollTop: 0 }, 500);
					return false;
				});
			});
		</script>
