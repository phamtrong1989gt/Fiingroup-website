<style>
    body {
        background: #fff;
    }

    #Banner {
        background: url(/Data/news-bg.jpg) no-repeat top;
        background-size: cover;
        height: 637px;
    }

        #Banner h1 {
            font-style: normal;
            font-weight: 700;
            font-size: 36px;
            line-height: 150%;
        }

        #Banner h2 {
            font-weight: 700;
            font-size: 24px;
            line-height: 28px;
        }

        #Banner img {
            border-radius: 16px;
        }

    .item-date {
        font-weight: 400;
        font-size: 18px;
        line-height: 150%;
        display: flex;
        align-items: center;
        color: #fff;
    }

        .item-date i {
            padding: 0 10px 0 0;
            width: 30px;
        }

        .item-date .item-label {
            padding: 0 10px 0 0;
            width: 126px;
        }

    #NewButton {
        align-items: center;
        justify-content: center;
        margin: 2.5% 0 0 0;
    }

    .btn-active {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 12px 40px;
        gap: 40px;
        width: 302px;
        height: 72px;
        background: #FFFFFF;
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        font-size: 24px;
        font-weight: 500;
        color: #093461;
        margin: 0 10px;
    }

        .btn-active:hover {
            background: #f6f6f6;
        }

    .btn-noactive {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 12px 40px;
        gap: 40px;
        width: 302px;
        height: 72px;
        background: #0066CC;
        box-shadow: 0px 8px 20px rgba(0, 102, 204, 0.12), 0px -8px 20px rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        font-size: 24px;
        font-weight: 500;
        color: #fff;
    }

        .btn-noactive:hover {
            background: #0f65ba;
            color: #fff;
        }

    .btn-reset {
        color: #0066CC;
    }

    #search #search-input {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 12px;
        gap: 10px;
        width: 485px;
        height: 38px;
        background: #FFFFFF;
        border: 1px solid #034EA2;
        border-radius: 4px;
    }

    #search {
        position: relative;
        font-size: 18px;
    }

        #search label {
            position: absolute;
            right: 8px;
            top: 6px;
            color: #034EA2;
        }

    .date-input {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 6px;
        gap: 10px;
        /*width: 198.5px;*/
        height: 38px;
        background: #FFFFFF;
        border: 1px solid #034EA2;
        border-radius: 4px;
        color: #838282;
    }

    .mr-2 {
        margin: 0 1rem 0;
    }

    .btn-search {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 10px 50px;
        height: 40px;
        background: #0066CC;
        border-radius: 200px;
    }

    .news-title {
        font-weight: 700;
        font-size: 28px;
        line-height: 120%;
        min-height: calc(28px * 1.2 * 3); /* 3 dòng */
        display: -webkit-box;
      -webkit-line-clamp: 3;
     -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
   color: #1D2939;
    }

    .no-data-messege {
        font-style: normal;
        font-weight: 700;
        font-size: 28px;
        text-align: center;
        color: #093461;
    }

    .news-img
    {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: center;
        border-radius: 12px;
        border: 1px solid #eee;
    }
</style>
