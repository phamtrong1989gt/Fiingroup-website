<section id="NewButton">
    <div class="container">
        <div class="row d-flex justify-content-center">
            @if (Model.ParentId == 0)
            {
                @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsLinkTab", language = language, portalId = portalId })
            }
            else
            {
                string url = @PT.Shared.Functions.FormatUrl(@language, Model.Link?.Slug);
                <div class="text-center">
                    <div class="tab-container mb-2">
                        <a class="tab active" title="@Model.Name" href="@url">@Model.Name</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="FiinGroup">
    <div class="container">
        <form method="get">
            <div class="d-flex justify-content-start mt-5">
                <section id="search" class="mr-2">
                    <input id="search-input" name="key" type="text" class="form-control input-lg" placeholder="Search here..." autocomplete="off" spellcheck="false" autocorrect="off" tabindex="1">
                    <label for="search-input"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search icons</span></label>
                </section>
                <input id="startDate" name="startDate" class="date-input mr-2" value="@DateTime.Now.Year-01-01" type="date" placeholder="Từ ngày" />
                <input id="endDate" name="endDate" class="date-input mr-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" type="date" placeholder="Đến ngày" />

                <button type="reset" class="btn btn-reset btn-clear">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.0007 15.1666C4.53404 15.1666 1.7207 12.3466 1.7207 8.88659C1.7207 7.63993 2.08737 6.43326 2.7807 5.39326C2.93404 5.16659 3.24737 5.09993 3.47404 5.25326C3.7007 5.4066 3.76737 5.71993 3.61404 5.94659C3.03404 6.81326 2.72737 7.83326 2.72737 8.87993C2.72737 11.7933 5.09404 14.1599 8.00737 14.1599C10.9207 14.1599 13.2874 11.7933 13.2874 8.87993C13.2874 5.96659 10.914 3.59993 8.0007 3.59993C7.38737 3.59993 6.78737 3.68659 6.2207 3.85993C5.95404 3.93993 5.67404 3.79326 5.59404 3.52659C5.51404 3.25993 5.6607 2.97993 5.92737 2.89993C6.59404 2.69993 7.28737 2.59326 8.0007 2.59326C11.4674 2.59326 14.2807 5.41326 14.2807 8.87326C14.2807 12.3333 11.4674 15.1666 8.0007 15.1666Z" fill="#0066CC" />
                        <path d="M5.24625 4.04658C5.13292 4.04658 5.01292 4.00658 4.91959 3.92658C4.70626 3.73992 4.68626 3.42658 4.86626 3.21992L6.79292 1.00658C6.97292 0.799918 7.29292 0.773251 7.49959 0.959918C7.70625 1.13992 7.72625 1.45992 7.54625 1.66658L5.61959 3.87325C5.51959 3.98658 5.37959 4.04658 5.24625 4.04658Z" fill="#0066CC" />
                        <path d="M7.49241 5.68659C7.39241 5.68659 7.28574 5.65325 7.19907 5.59325L4.94574 3.94659C4.72574 3.78659 4.67907 3.47325 4.83907 3.25325C4.99907 3.02659 5.31241 2.97992 5.53907 3.13992L7.78574 4.77992C8.00574 4.93992 8.05907 5.25325 7.89241 5.47992C7.79907 5.61992 7.64574 5.68659 7.49241 5.68659Z" fill="#0066CC" />
                    </svg>
                    Xóa lọc
                </button>
                <button type="submit" class="btn btn-primary btn-search">Tìm kiếm</button>
            </div>
        </form>
        <div class="row mt-5">
            @if (Model.DataAPI != null)
            {
                @foreach (var item in Model.DataAPI.Items)
                {
                    string url = $"/{language}/tin-tuc-fg/{item.FriendlyTitle}-id{item.Id}.html".ToLower();
                    <div class="col-lg-4 col-sm-6">
                        <a href="@url" title="@item.Title">
                            <img class="news-img" onerror="this.onerror=null;this.src='/Data/Banner/no-img.jpg';" src="@(item.ImageUrl ?? "/Data/Banner/no-img.jpg")" alt="@item.Title">
                        </a>
                        <h3 class="pt-4">
                            <a href="@url" title="@item.Title" class="news-title">@item.Title</a>
                        </h3>
                        <div class="pt-2 pb-4 mb-4">
                            <a href="@url" title="@item.Title" class="show-more">Show more <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-lg-12 col-sm-12 text-center my-5">
                    <img src="/Data/no-data.jpg" alt="No data" />
                    <p class="no-data-messege my-5">Chưa có tin tức, sự kiện nào sắp diễn ra.</p>
                </div>
            }
            <!-- pagination -->
          @*   <div class="pagination-area">
                <div aria-label="Page navigation example">
                    <ul class="pagination justify-content-center">
                        @Html.Raw(PT.Shared.Functions.GenPageList("", Model.PageBlog.Page, Model.PageBlog.TotalRows, Model.PageBlog.Limit, $"&key={Context.Request.Query["key"]}" + $"&startDate={Context.Request.Query["startDate"]}" + $"&endDate={Context.Request.Query["endDate"]}", "page-item"))
                    </ul>
                </div>
            </div> *@
            <!-- pagination end -->
        </div>
    </div>
</section>
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDeliver", language = language, portalId = portalId }))
<script>
    $(function() {
        $('.btn-clear').on('click', function() {
            $('#search-input').val('');
            $('#startDate, #endDate').val('');
        });
    });
</script>