                <section id="search" class="mr-2" style="margin-left:0px;">
                    <input id="search-input" name="key" type="text" class="form-control input-lg" placeholder="Search here..." autocomplete="off" spellcheck="false" autocorrect="off" tabindex="1">
                    <label for="search-input"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search icons</span></label>
                </section>
                <input id="startDate" name="startDate" class="date-input mr-2" value="@DateTime.Now.Year-01-01" type="date" placeholder="Từ ngày" />
                <input id="endDate" name="endDate" class="date-input mr-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" type="date" placeholder="Đến ngày" />

                <button type="button" class="btn btn-reset btn-clear">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.0007 15.1666C4.53404 15.1666 1.7207 12.3466 1.7207 8.88659C1.7207 7.63993 2.08737 6.43326 2.7807 5.39326C2.93404 5.16659 3.24737 5.09993 3.47404 5.25326C3.7007 5.4066 3.76737 5.71993 3.61404 5.94659C3.03404 6.81326 2.72737 7.83326 2.72737 8.87993C2.72737 11.7933 5.09404 14.1599 8.00737 14.1599C10.9207 14.1599 13.2874 11.7933 13.2874 8.87993C13.2874 5.96659 10.914 3.59993 8.0007 3.59993C7.38737 3.59993 6.78737 3.68659 6.2207 3.85993C5.95404 3.93993 5.67404 3.79326 5.59404 3.52659C5.51404 3.25993 5.6607 2.97993 5.92737 2.89993C6.59404 2.69993 7.28737 2.59326 8.0007 2.59326C11.4674 2.59326 14.2807 5.41326 14.2807 8.87326C14.2807 12.3333 11.4674 15.1666 8.0007 15.1666Z" fill="#0066CC" />
                        <path d="M5.24625 4.04658C5.13292 4.04658 5.01292 4.00658 4.91959 3.92658C4.70626 3.73992 4.68626 3.42658 4.86626 3.21992L6.79292 1.00658C6.97292 0.799918 7.29292 0.773251 7.49959 0.959918C7.70625 1.13992 7.72625 1.45992 7.54625 1.66658L5.61959 3.87325C5.51959 3.98658 5.37959 4.04658 5.24625 4.04658Z" fill="#0066CC" />
                        <path d="M7.49241 5.68659C7.39241 5.68659 7.28574 5.65325 7.19907 5.59325L4.94574 3.94659C4.72574 3.78659 4.67907 3.47325 4.83907 3.25325C4.99907 3.02659 5.31241 2.97992 5.53907 3.13992L7.78574 4.77992C8.00574 4.93992 8.05907 5.25325 7.89241 5.47992C7.79907 5.61992 7.64574 5.68659 7.49241 5.68659Z" fill="#0066CC" />
                    </svg>
                    Xóa lọc
                </button>
                <button style="margin-right:0px;" type="button" class="btn btn-primary btn-search" id="btn-search" onclick="getNewsAjax(1)">Tìm kiếm <span id="news-loading" class="loader d-none" aria-hidden="true"></span></button>
            </div>
        </form>
        <div class="row" id="content-bind">
            <partial name="NewsAjax" model="Model.DataAPI" />
        </div>
    </div>
</section>
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDeliver", language = language, portalId = portalId })
@section Scripts {
    <script>
        (function ($) {
            var newsAjaxUrl = '@Url.Action("NewsAjax", "Category")';
            var currentLanguage = '@language';

            function toYMD(date) {
                var y = date.getFullYear();
                var m = (date.getMonth() +1).toString().padStart(2, '0');
                var d = date.getDate().toString().padStart(2, '0');
                return y + '-' + m + '-' + d;
            }

            function normalizeDateInput(selector) {
                var $el = $(selector);
                var val = $el.val();
                if (!val) return;

                // If already in yyyy-MM-dd, keep it
                if (/^\d{4}-\d{2}-\d{2}$/.test(val)) {
                    return;
                }

                // Try parsing common formats (dd/MM/yyyy or MM/dd/yyyy)
                var parts;
                if (/^\d{2}\/\d{2}\/\d{4}$/.test(val)) {
                    parts = val.split('/'); // dd/MM/yyyy
                    var d = parseInt(parts[0],10);
                    var m = parseInt(parts[1],10) -1;
                    var y = parseInt(parts[2],10);
                    var dt = new Date(y, m, d);
                    if (!isNaN(dt)) {
                        $el.val(toYMD(dt));
                    }
                    return;
                }

                // Try Date constructor fallback
                var dt = new Date(val);
                if (!isNaN(dt)) {
                    $el.val(toYMD(dt));
                }
            }

            function formatDateInputsBeforeSubmit() {
                normalizeDateInput('#startDate');
                normalizeDateInput('#endDate');
            }

            function buildParams(page) {
                var keyword = $('#search-input').val() || '';
                var fromDate = $('#startDate').val() || '';
                var toDate = $('#endDate').val() || '';

                return {
                    Page: page ||1,
                    Keyword: keyword,
                    FromDate: fromDate,
                    ToDate: toDate,
                    Language: currentLanguage,
                    CategoryIds: '@ViewData["ExCategoryIds"]'
                };
            }

            function showLoading() {
                $('#news-loading').removeClass('d-none');
                $('#btn-search').prop('disabled', true).attr('aria-busy', 'true');
            }

            function hideLoading() {
                $('#news-loading').addClass('d-none');
                $('#btn-search').prop('disabled', false).removeAttr('aria-busy');
            }

            window.getNewsAjax = function(page) {
                page = page ||1;
                var params = buildParams(page);

                // normalize dates before sending
                formatDateInputsBeforeSubmit();

                showLoading();

                $.get(newsAjaxUrl, params)
                    .done(function (html) {
                        $('#content-bind').html(html);
                    })
                    .fail(function () {
                        $('#content-bind').html('<div class="no-data-messege">No data</div>');
                    })
                    .always(function () {
                        hideLoading();
                    });
            };

            $(function () {
                // initial load (if page has query params, keep them)
                var urlParams = new URLSearchParams(window.location.search);
                var initialKey = urlParams.get('key');
                var initialFrom = urlParams.get('startDate');
                var initialTo = urlParams.get('endDate');

                if (initialKey) $('#search-input').val(initialKey);
                if (initialFrom) $('#startDate').val(initialFrom);
                if (initialTo) $('#endDate').val(initialTo);

                // Clear button should clear and submit form to reload server-side results
                $('.btn-clear').on('click', function () {
                    $('#search-input').val('');
                    $('#startDate, #endDate').val('');
                });
            });
        })(jQuery);
    </script>
}