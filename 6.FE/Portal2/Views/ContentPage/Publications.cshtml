@model PT.Domain.Model.ContentPage
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject ICategoryRepository _iCategoryRepository;
@inject IContentPageReferenceRepository _iContentPageReferenceRepository;
@using Microsoft.Extensions.Options
@using PT.Shared;
@using PT.UI.Models
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@{
	Layout = "~/Views/Shared/_Home.cshtml";
	var portalId = _baseSettings.Value.PortalId;
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var lstTinLienQuan = await _iContentPageRepository.SearchAdvanceAsync(0, 3,
			 null, null,
			 m => m.Status
				 && m.DatePosted <= DateTime.Now
				 && m.Id != Model.Id
				 && m.Language == language
				 && (m.CategoryType == ECategoryType.ContentPage_Publications),
			 m => m.OrderByDescending(x => x.DatePosted),
			 a => new ContentPage
			 {
				 Banner = a.Banner,
				 DatePosted = a.DatePosted,
				 Id = a.Id,
				 Name = a.Name,
				 Summary = a.Summary,
				 Language = a.Language,
				 Author = a.Author,
				 CategoryId = a.CategoryId,
				 Tags = a.Tags,
				 Type = a.Type,
				 Topic = a.Topic,
				 FilePath = a.FilePath,
				 Pages = a.Pages,
				 Extentions = a.Extentions,
				 DeliveryTime = a.DeliveryTime,
				 Link = a.Link
			 });
}

<style>
	/* --- HEADER --- */
	.report-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 30px;
		margin-bottom: 40px;
	}

		.report-header img {
			width: 380px;
			border-radius: 12px;
			box-shadow: 0 4px 10px rgba(0, 64, 128, 0.15);
		}

	.report-info {
		flex: 1;
		min-width: 300px;
	}

	.news-meta {
		display: flex;
		gap: 20px;
		color: #0066CC;
		font-size: 14px;
	}

		.news-meta p {
			margin: 0;
			position: relative;
		}

	.news-sers {
		color: #093461;
	}

		.news-sers i {
			color: #0066CC;
			font-size: 7px;
			vertical-align: middle;
		}

	.report-info h2 {
		font-size: 28px;
		font-weight: 700;
		margin-bottom: 15px;
		color: #002d72;
		border-bottom: 1px solid #F0F0F0;
		padding: 10px 0;
	}

	.report-meta-table {
		display: grid;
		grid-template-columns: 140px 1fr;
		row-gap: 6px;
		font-size: 15px;
		margin-bottom: 20px;
	}

		.report-meta-table p {
			margin: 0;
		}

	.report-meta-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 30px;
	}

	.meta-item {
		flex: 1;
		min-width: 120px;
	}

	.meta-label {
		font-size: 14px;
		color: #1D2939;
		margin-bottom: 5px;
	}

	.meta-value {
		font-size: 15px;
		font-weight: 600;
		color: #1d2939;
	}

	.report-price {
		font-size: 28px;
		color: #0066CC;
		font-weight: 700;
		margin: 10px 0 20px 0;
	}

	.report-buttons {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

		.report-buttons a {
			padding: 10px 0 0 0;
			border-bottom: 2px solid;
			color: #0066CC;
		}

	.btn-buy {
		background: #0066cc;
		color: white;
		padding: 10px 62px;
		border: none;
		border-radius: 30px;
		cursor: pointer;
		transition: all 0.3s ease;
	}

		.btn-buy:hover {
			background: #0078d4;
		}

	.btn-outline {
		background: transparent;
		border: 1.5px solid #0078d4;
		color: #0078d4;
		padding: 10px 25px;
		border-radius: 30px;
		transition: 0.3s;
	}

		.btn-outline:hover {
			background: #0078d4;
			color: #fff;
		}

	/* --- TABS --- */
	.report-tabs {
		display: flex;
		gap: 40px;
		border-bottom: 2px solid #e0e8f5;
		margin: 40px 0 20px;
	}

	.report-tab {
		font-size: 18px;
		font-weight: 600;
		/* color: #093461; */
		padding-bottom: 10px;
		cursor: pointer;
		border-bottom: 2px solid transparent;
		width: 200px;
		text-align: center;
	}

		.report-tab.active {
			color: #034ea2;
			border-color: #034ea2;
		}

	/* --- CONTENT --- */
	.report-content {
		margin-bottom: 40px;
	}

		.report-content p {
			line-height: 1.7;
			margin-bottom: 5px;
			font-size: 16px;
			text-align: justify;
			color: #093461;
		}

		.report-content h3 {
			color: #093461;
			font-size: 20px;
			margin: 20px 0 10px;
			font-weight: 700;
		}

		.report-content ul {
			padding-left: 30px;
			margin-bottom: 20px;
		}

			.report-content ul li {
				list-style: disc;
				margin-bottom: 10px;
				line-height: 1.6;
			}

				.report-content ul li b {
					color: #093461;
				}

	/* --- CONTACT --- */
	.report-contact {
		margin-top: 40px;
	}

		.report-contact h4 {
			color: #002d72;
			font-size: 30px;
			margin-bottom: 15px;
			font-weight: 600;
		}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 60px;
	}

	.contact-box {
		border-radius: 10px;
		border: 1px solid #d5e4ff;
		padding: 20px;
		box-shadow: 0 2px 10px rgba(0, 64, 128, 0.05);
		/* border gradient bo góc mượt */
		border: 1px solid transparent;
		background-image: linear-gradient(#f5f9ff, #f2f7ff), linear-gradient(to right, #0018A8, #166BF2, #3B7EEE);
		background-origin: border-box;
		background-clip: padding-box, border-box;
	}

		.contact-box h5 {
			color: #034ea2;
			margin-bottom: 10px;
		}

		.contact-box p {
			color: #034ea2;
			font-size: 14px;
			margin-bottom: 6px;
		}

		.contact-box a {
			color: #034ea2;
			border-bottom: 1px solid;
		}

		.contact-box p i {
			padding-right: 5px;
		}

	.vnd {
		font-weight: 400;
		color: #88b8e7;
	}

	.pdt20 {
		padding-top: 20px;
	}

	.tag {
		color: #0066CC !important;
		padding: 20px 0 10px;
		border-bottom: 1px solid #ccc;
	}

	.show-all {
		background-color: #ffffff;
		color: #0066cc;
		padding: 8px 60px;
		border-radius: 25px;
		cursor: pointer;
		margin-top: 20px;
		display: inline-block;
		border: 1px solid #0066cc;
	}

	#PubFeatured .news-title a {
		font-weight: 600;
		font-size: 30px;
	}

	#PubFeatured .news-meta {
		display: flex;
		gap: 20px;
		color: #0066CC;
		font-size: 14px;
		padding-top: 20px;
	}

	.news-meta p {
		margin: 0;
		position: relative;
	}

	.news-sers {
		color: #093461;
	}

		.news-sers i {
			color: #0066CC;
			font-size: 7px;
			vertical-align: middle;
		}

	.pub-price {
		font-size: 28px;
		color: #0066CC;
		font-weight: 700;
	}

	.pub-buttons {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

		.pub-buttons a {
			border-bottom: 2px solid;
			color: #0066CC;
			padding-top: 5px;
		}
</style>

<section id="ReportDetail" class="py-5">
	<div class="container">
		<div class="report-header">
			<img src="@Model.Banner" alt="@Model.Name" />
			<div class="report-info">
				<div class="news-meta">
					<p class="news-time">@Model.DatePosted.ToString("HH:mm dd/MM/yyyy")</p>
					<p class="news-sers">@Model.Topic <i class="fa fa-circle pd5"></i> @Model.Pages pages</p>
				</div>
				<h2>Vietnam Credit Card Market Report 2025</h2>
				<div class="report-meta-row">
					<div class="meta-item">
						<p class="meta-label">Tổng trang</p>
						<p class="meta-value">@Model.Pages trang</p>
					</div>
					<div class="meta-item">
						<p class="meta-label">Định dạng</p>
						<p class="meta-value">@Model.Extentions</p>
					</div>
					<div class="meta-item">
						<p class="meta-label">Chủ đề</p>
						<p class="meta-value">@Model.Topic</p>
					</div>
					<div class="meta-item">
						<p class="meta-label">Giao hàng</p>
						<p class="meta-value">@Model.DeliveryTime</p>
					</div>
				</div>
				<div class="report-buttons">
					<a href="@Model.FilePath" target="_blank">Download Preview</a>
				</div>
			</div>
		</div>

		@* <div class="report-tabs">
			<div class="report-tab active">Tổng hợp</div>
			<div class="report-tab">Danh mục</div>
		</div> *@

		<div class="report-content">
			<div class="col-lg-12 col-sm-12">
				@Html.Raw(Model.Content)
			</div>

			@if (@Model.Tags != null)
			{
				<p class="tag">
					Tags: 
					@foreach (var item in @Model.Tags)
					{
						<span>@item.Name</span>
					}
				</p>
			}
		</div>

	</div>
</section>

@if (lstTinLienQuan != null)
{
	<section id="PubFeatured" class="py-5 mb-5">
		<div class="container">
			<h2 class="price-title mb-5"><span style="color: #0066CC;">Featured </span> reports</h2>
			<div class="row news-grid">
				@foreach (var item in lstTinLienQuan)
				{
					string url = @PT.Shared.Functions.FormatUrl(@language, item.Link?.Slug);
					<div class="col-lg-4 col-sm-6">
						<a href="@url" title="@item.Name"><img src="@item.Banner" alt="@item.Name" class="img-fluid w-100" loading="lazy" /></a>
						<div class="news-meta">
							<p class="news-time">@item.DatePosted.ToString("HH:mm dd/MM/yyyy")</p>
							<p class="news-sers">@item.Topic <i class="fa fa-circle pd5"></i> @item.Pages pages</p>
						</div>
						<div class="pt-3 pb-3">
							<div class="news-title text-break">
								<a href="@url" class="pub-title" title="@item.Name">@item.Name</a>
							</div>
						</div>
						<div class="pub-buttons">
							<a href="@item.FilePath" target="_blank">Download Preview</a>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDeliver", language = language, portalId = portalId }))