@using Microsoft.Extensions.Options
@using PT.Shared;
@using PT.UI.Models

@model PT.Domain.Model.ContentPage
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject ICategoryRepository _iCategoryRepository;
@inject IContentPageReferenceRepository _iContentPageReferenceRepository;
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;

@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;
	var listFlowItems = await _iContentPageRepository.FlowGetsAsync(language, portalId, Model.Id);
	var lstTinLienQuan = await _iContentPageRepository.SearchAdvanceAsync(0, 3,
			   null, null,
			   m => m.Status
				   && m.DatePosted <= DateTime.Now
				   && m.Language == language
				   && (m.CategoryType == ECategoryType.ContentPage_Blog || m.CategoryType == ECategoryType.ContentPage_Event),
			   m => m.OrderByDescending(x => x.DatePosted),
			   a => new ContentPage
			   {
				   Banner = a.Banner,
				   DatePosted = a.DatePosted,
				   Id = a.Id,
				   Name = a.Name,
				   Summary = a.Summary,
				   Language = a.Language,
				   Author = a.Author,
				   CategoryId = a.CategoryId,
				   Link = a.Link
			   });
}

<style>
 #StockEconomy{background:url('@(Model.Input12 ?? "/Data/Banner/bg-giaiphap.jpg")') top/cover no-repeat}.hero-content{color:#fff;max-width:89%;z-index:2;padding-bottom:30px}.hero-subtitle{display:inline-block;font-size:40px;font-weight:500;color:#fff;padding-top:60px}.hero-title{font-size:54px;font-weight:700;line-height:1.4;margin-bottom:15px}.hero-text{font-size:18px;line-height:1.7;color:#d7e9ff;text-align:justify;position:relative;padding-left:25px}.hero-text::before{content:"";position:absolute;left:0;top:0;width:5px;height:100%;background:linear-gradient(to bottom,#5086c0,#e2f2FB7A,#badcf1);border-radius:2px}.customer-box{position:relative;border-radius:15px;border:1px solid transparent;background-image:linear-gradient(#f5f9ff,#fff),linear-gradient(to right,#e6e6e6 0,#034ea2 100%);background-origin:border-box;background-clip:padding-box,border-box;box-shadow:0 6px 15px rgba(3,78,162,.08);text-align:center;padding:50px 30px 30px}.decor{position:absolute;pointer-events:none;z-index:5}.decor-left{left:-45px;top:55%;width:75px}.decor-topright{right:12%;top:-35px;width:90px}.decor-bottomright{right:-2%;bottom:25px;width:60px}.customer-grid{display:flex;justify-content:space-around;flex-wrap:wrap}.customer-item{text-align:center;color:#1d2939;font-size:16px;font-weight:500}.customer-icon{width:60px;margin-bottom:15px;transition:transform .3s}.customer-item:hover .customer-icon{transform:scale(1.1)}.customer-name{font-size:18px;color:#093461;font-weight:700}.solution-item{margin-bottom:50px;margin-right:30px}.solution-item h4{font-size:28px;font-weight:700;color:#093461;margin-bottom:6px}.solution-item h4:hover{color:#034ea2}.solution-item p{font-size:13px;color:#093461;margin-bottom:6px}.solution-link{font-size:14px;color:#034ea2;text-decoration:none;font-weight:500;transition:.3s}.solution-link:hover{text-decoration:underline;padding-left:4px}.solution-img{border-radius:12px;box-shadow:0 8px 20px rgba(0,0,0,.12)}.pdt20{padding-top:20px}#WhatWe{background:url('/Data/Banner/bg-what.jpg') center center/cover no-repeat}#WhatWe h2{color:#fff}#WhatWe .itemwe{padding-right:35px}#WhatWe .number{font-weight:700;font-size:24px;color:#fff;margin:0}#WhatWe .tochuc{font-size:28px;color:#fff;margin:0}#WhatWe .desc{font-weight:500;font-size:16px;color:#fff;text-align:justify}#WhatWe .gach{border-bottom:1px solid #ffff;padding:0;margin:10px 0;width:155px}
</style>
<section id="StockEconomy" class="hero-section">
	<div class="hero-overlay">
		<div class="container">
			<div class="hero-content">
				@if(Model.IsShowHeaderContent != false)
				{
					<span class="hero-subtitle">@Model.Input1</span>
					<h1 class="hero-title">
						@Model.Input2
					</h1>
					<p class="hero-text">
						@Html.Raw(Model.Input3)
					</p>
				}
			</div>
		</div>
	</div>
</section>

<section id="CustomerSection" class="py-5">
	<div class="container">
		<div class="customer-box">
			<!-- Decor images -->
			<img src="/Data/Banner/summary-decor1.png" alt="decor" class="decor decor-left">
			<img src="/Data/Banner/summary-decor1.png" alt="decor" class="decor decor-topright">
			<img src="/Data/Banner/summary-decor2.png" alt="decor" class="decor decor-bottomright">
			<h2 class="price-title mb-5">@Localizer["OurCustomers"]</h2>
			@Html.Raw(Model.Input4)
		</div>
	</div>
</section>
<section id="GiaiPhapHoTro" class="py-5">

	<div class="container">
		<h2 class="price-title mb-4">@Localizer["ProductTitle"]</h2>

		<div class="row pdt20">
			<div class="col-lg-7 col-sm-12 mb-4">
				<div class="bao-item" style="overflow-y:auto;max-height: 600px;">
					@for (int i = 0; i < listFlowItems.Count; i++)
					{
						var item = listFlowItems[i];
						string path = PT.Shared.Functions.FormatUrl(item.Language, item.Link?.Slug);
						<div class="solution-item" data-img="@item.Input11">
							<a href="@path" title="@item.Name"><h4>@item.Name</h4></a>
							<p>@Html.Raw(item.RelatedNote)</p>
							<a href="@path" class="solution-link">@Localizer["Details"] <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
						</div>
					}
				</div>
			</div>
			<div class="col-lg-5 col-sm-12 text-center">
				<img src="@(Model.Input5 ?? "/Data/Banner/solution_giaiphap5.png")" class="img-fluid solution-img" alt="@Model.Name">
			</div>
		</div>
	</div>
</section>

<section id="WhatWe" class="py-5">
	<div class="container">
		@Html.Raw(Model.Input6)
	</div>
</section>

<partial name="~/Views/Home/_Register.cshtml" model="@(new ContactHomeModel { })" />

@if (lstTinLienQuan != null)
{
	<section id="Insights" class="py-5 mb-5">
		<div class="container">
			<h2 class="price-title mb-5"><span style="color: #0066CC;">@Localizer["Highlights"]</span></h2>
			<div class="row news-grid">
				@foreach (var item in lstTinLienQuan)
				{
					string path = PT.Shared.Functions.FormatUrl(item.Language, item.Link?.Slug);
					<div class="col-lg-4 col-sm-6 mb-4">
						<img src="@item.Banner" class="img-fluid w-100 img-item" alt="@item.Name" title="@item.Name" loading="lazy" />
						@if (item.Tags != null)
						{
							foreach (var tag in item.Tags)
							{
								<button class="mt-3 btn btn-news" data-action="login" data-tag="@tag?.Name">
									@tag?.Name
								</button>
							}
						}
						<div class="pt-3 pb-3">
							<div class="news-title text-break">
								<a href="@path" title="@item.Name">
									@(item.Name.Length > 58 ? item.Name.Substring(0, 58) + "..." : item.Name)
								</a>
							</div>
						</div>
						<div>@(item.Name.Length > 130 ? Html.Raw(item.Summary.Substring(0, 130)) + "..." : Html.Raw(item.Summary))</div>
						<div class="pt-4">
							<a class="show-more" href="@path" title="@item.Name">@Localizer["ShowMore"] <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}

<script>
	// Keep .bao-item height equal to .solution-img height.
	(function ($) {
		// when hovering solution items we change the image src — recalc height after image load
		$('.solution-item').hover(function () {
			let imgUrl = $(this).data('img');
			if (imgUrl && imgUrl !== "") {
				const $img = $('.solution-img');
				$img.attr('src', imgUrl);
			}
		});
	})(window.jQuery);
</script>