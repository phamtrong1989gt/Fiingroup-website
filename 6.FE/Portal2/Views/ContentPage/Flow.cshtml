                                        placeholder="Nhập số điện thoại">
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <label for="email" class="form-label">Email <span class="error">*</span></label>
                                    <input type="email" class="form-control" id="email" placeholder="Nhập email">
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <label for="tenCongTy" class="form-label">Tên công ty <span
                                            class="error">*</span></label>
                                    <input type="text" class="form-control" id="tenCongTy" placeholder="Nhập công ty">
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <label for="chucDanhCV" class="form-label">Chức danh công việc <span
                                            class="error">*</span></label>
                                    <input type="text" class="form-control" id="chucDanhCV"
                                        placeholder="Nhập chức danh công việc">
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <label for="dichVuQT" class="form-label">Dịch vụ quan tâm <span
                                            class="error">*</span></label>
                                    <select class="form-select" id="dichVuQT" aria-label="Default select example">
                                        <option selected>Chọn dịch vụ quan tâm</option>
                                        <option value="1">One</option>
                                        <option value="2">Two</option>
                                        <option value="3">Three</option>
                                    </select>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <label for="yeuCauCT" class="form-label">Yêu cầu chi tiết <span
                                            class="error">*</span></label>
                                    <textarea type="text" maxlength="200" class="form-control txt-area" id="yeuCauCT"
                                        placeholder="Nhập yêu cầu chi tiết"></textarea>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary col-sm-12 btn-yeucau">Gửi yêu cầu</button>
                        </form>
                    </div>
                    <div class="col-lg-6 col-sm-12 img d-none d-sm-block">
                        <img src="/Data/bg-dangky.jpg" alt="Đăng ký" />
                    </div>
                </div>
            </div>
        </section>

