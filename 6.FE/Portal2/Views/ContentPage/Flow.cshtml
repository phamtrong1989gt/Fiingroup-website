                    text-decoration: underline;
                    padding-left: 4px;
                }

                .solution-img {
                    border-radius: 12px;
                    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
                }

                .pdt20 {
                    padding-top: 20px;
