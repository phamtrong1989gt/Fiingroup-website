@using Microsoft.Extensions.Options
@using PT.Shared;
@using PT.UI.Models

@model PT.Domain.Model.ContentPage
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using static PT.Domain.Model.Contact
@inject IViewLocalizer Localizer
@inject ICategoryRepository _iCategoryRepository;
@inject IContentPageReferenceRepository _iContentPageReferenceRepository;
@inject IOptions<BaseSettings> _baseSettings;

@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;
}

<style>
	#StockEconomy {
		background: url('@(Model.Input12 ?? "/Data/Banner/about_banner.png")') no-repeat top;
		background-size: cover;
	}

	.box-center, .box-left, .box-right {
		min-height: 510px;
		position:relative;
		cursor: -webkit-grab;
	}

	.box-center .dang-ky-card-center, .box-left .dang-ky-card, .box-right .dang-ky-card
	{
		position: absolute;
		bottom: 40px;
		max-width: 250px;
		margin: 0 auto;
		left: 0;
		right: 0;
	}

		.box-center .corner-decor
		{
			display:none;
		}

	.tilte-card-center
	{
		font-size: 23px !important;
		color: #0066CC !important;
		margin-bottom: 10px !important;
	}

	.tilte-card
	{
		min-height:69px;
	}

	.box-left::before, .box-center::before,.box-right::before
	{
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 15px;
		padding: 2px;
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}

	.box-center::before
	{
		background:none !important;
	}

	.box-left:hover::before,
	.box-center:hover::before,
	.box-right:hover::before {
		background: linear-gradient(to right, #034EA2, #53DFFF) !important;
		-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		/* nếu cần giữ behavior cũ: */
		-webkit-mask-composite: xor;
		mask-composite: exclude;
	}

	.box-left:hover, .box-center:hover, .box-right:hover
	{
		transform: translateY(-16px);
	}

	.fa.fa-check-circle
	{
		padding-top: 3px !important;
	}

	.money-card
	{
		position:relative;
	}

	#FiinCard
	{
        margin-bottom: 0 !important;
	}
</style>

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "SanPhamDongChay", language = language, portalId = portalId })

<section id="StockEconomy" class="hero-section">
	<div class="hero-overlay">
		<div class="container">
			<div class="hero-content">
				@if (Model.IsShowHeaderContent != false)
				{
					<h1 class="hero-title pt-5">
						@Html.Raw(Model.Input2)
					</h1>
					<span class="hero-subtitle">@Html.Raw(Model.Input1)</span>
					<div class="hero-text">
						@Html.Raw(Model.Input3)
					</div>
				}
				@Html.Raw(Model.Input10)
			</div>
		</div>
	</div>
</section>

<section id="FiinProX">
	<div class="container">
		@Html.Raw(Model.Input4)
		@if (!string.IsNullOrEmpty(Model.Input9))
		{
			<img src="@Model.Input9" alt="@Model.Name" class="img-content" style="width:100%;" />
		}
	</div>
</section>

<!-- Find a rating-->
<section id="FinnRatings">
	<div class="whylastest mt-2">
		<div class="container">
			@Html.Raw(Model.Input5)
			@if (!string.IsNullOrEmpty(Model.Input8))
			{
				<img src="@Model.Input8" alt="@Model.Name" class="img-content" style="width:100%;" />
			}
		</div>
	</div>
</section>

<!-- Report -->
<section id="FiinReport">
	<div class="container">
		@Html.Raw(Model.Input6)
		@if (!string.IsNullOrEmpty(Model.Input13))
		{
			<img src="@Model.Input13" alt="@Model.Name" class="img-content" style="width:100%;" />
		}
	</div>
</section>

<!-- FiinCard -->
<section id="FiinCard">
	<div class="container">
		@Html.Raw(Model.Input7)
		@if (!string.IsNullOrEmpty(Model.Input14))
		{
			<img src="@Model.Input14" alt="@Model.Name" class="img-content" style="width:100%;" />
		}
	</div>
</section>

<partial name="~/Views/Home/_Register.cshtml" model="@(new ContactHomeModel {  })" />
