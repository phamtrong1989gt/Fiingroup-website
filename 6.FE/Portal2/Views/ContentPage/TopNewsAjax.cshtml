@model PT.Domain.Model.NewsListResponse
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Options
@using PT.Domain.Model
@using PT.Shared;
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;

@{
    Layout = null;
	string language = ViewData["language"]?.ToString();
}

@if (Model != null)
{
	@foreach (var item in Model.Items)
	{
		string url = $"/{language}/news-fg/{item.FriendlyTitle}-id{item.Id}.html".ToLower();

		<div class="col-lg-4 col-sm-6 mb-4">
			<img loading="lazy" class="news-img" onerror="this.onerror=null;this.src='/Data/Banner/news.jpg';" src="@(item.ImageUrl ?? "/Data/Banner/news.jpg")" alt="@item.Title">
			<div class="pt-3 pb-3">
				<div class=" text-break">
					<a href="@url" class='news-title' title="@item.Title">
						@item.Title
					</a>
				</div>
			</div>
			<div class="pt-4">
				<a class="show-more" href="@url" title="@item.Title">@Localizer["Show more"] <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
			</div>
		</div>
	}
}
