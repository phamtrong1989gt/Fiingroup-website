@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using PT.Domain.Model;
@using PT.Infrastructure.Interfaces;
@using PT.Shared;
@inject IViewLocalizer Localizer;
@using System.Linq.Expressions;
@using PT.UI.Models
@inject IOptions<BaseSettings> _baseSettings;

@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;
}

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "AboutUsBanner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "AboutUsStoryFiin", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "AboutUsCoreValue", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "AboutUsTimeLineFiin", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "AboutUsUserTeam", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.PhotoSlide, code = "AboutUsWordEnvironment", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "AboutUsDeliver", language = language, portalId = portalId })
<style>
    .member-card img
    {
        width:100%;
    }
</style>
<style>
    /* expand overlay and reveal description ONLY on hover */
    .member-card:hover .member-info,
    .team-grid > .team-grid:hover .member-info {
        height: 100%;
        background: #fffffff5;
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        top: 0;
        padding: 20px;
    }

        .member-card:hover .member-info .member-desc   {
            display:block;
        }

    .member-card:hover .member-desc,
    .team-grid > .team-grid:hover .member-desc {
        opacity: 1;
        max-height: 400px; /* adjust if needed */
    }

    /* keep cursor pointer for hover affordance */
    .member-card,
    .team-grid > .team-grid {
        cursor: pointer;
    }
</style>

<style>
        .tab-container {
            display: inline-flex;
            justify-content: center;
        border: 1px solid #0066cf !important;
            border-radius: 26px;
            overflow: hidden;
            font-size: 16px;
        }

    .tab.active {
        background: #0066cf !important;
    }
</style>

<!-- Consolidated scripts: links, tabs, and hover popup (deduplicated) -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    // smooth scroll for .narbarstory links
    const links = document.querySelectorAll('.narbarstory a');
    links.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            links.forEach(l => l.classList.remove('active'));
            link.classList.add('active');
            const targetId = link.getAttribute('href')?.trim();
            if (!targetId || !targetId.startsWith("#")) return;
            const targetEl = document.querySelector(targetId);
            if (targetEl) targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
        });
    });

    // Tabs handling
    const tabs = document.querySelectorAll('.tab');
    var language = '@language';
    const contents = {
        'Hội đồng quản trị': document.getElementById('hdqt'),
        'Ban điều hành': document.getElementById('ban-dieu-hanh')
    };

    if(language !== 'vi') {
        contents['Board of Directors'] = document.getElementById('hdqt');
        contents['Board of Managers'] = document.getElementById('ban-dieu-hanh');
    };

    const title = document.getElementById('team-title');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            Object.values(contents).forEach(content => { if (content) content.style.display = 'none'; });
            tab.classList.add('active');
            const selected = tab.textContent.trim();
            if (contents[selected]) contents[selected].style.display = 'block';
            if (selected === 'Hội đồng quản trị') {
                title.innerHTML = 'Đội ngũ quản lý';
            } else if (selected === 'Ban điều hành') {
                title.innerHTML = 'Đội ngũ quản lý <span style="color:#0078d4;">giàu kinh nghiệm</span>';
            }
        });
    });

</script>