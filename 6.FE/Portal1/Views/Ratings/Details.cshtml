@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using PT.Domain.Model;
@using PT.Infrastructure.Interfaces;
@using PT.Shared;
@inject IViewLocalizer Localizer;
@using System.Linq.Expressions;
@using PT.UI.Models
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@inject IOptions<BaseSettings> _baseSettings;

@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;
	var listFlow = await _iContentPageRepository.FlowGetsAsync(language, portalId);

}

<div style="display:none;">@ViewData["CacheTime"]</div>



@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "RatingsCompanyOverview", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "RatingsRankingSection", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "RatingsRatingCharts", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "RatingsDeliver", language = language, portalId = portalId })