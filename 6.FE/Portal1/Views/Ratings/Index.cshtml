@model PT.Domain.Model.Category
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Options
@using PT.Domain.Model
@using PT.Shared;
@using PT.UI.Models
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@inject PT.Infrastructure.Interfaces.ICategoryRepository _iCategoryRepository;
@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = _baseSettings.Value.PortalId;
}
<link asp-append-version="true" href="~/assets/css/views/ratings.index.css" rel="stylesheet" />
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.PhotoSlide, code = "FRRakingSliderBanner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRRakingMenuButton", language = language, portalId = portalId })

<section id="Find">
    <div class="container">
        <div class="box-find-top">
            <div class="find-top">
                <input type="text" id="companyName" name="companyName" placeholder="@Localizer["CompanyNamePlaceholder"]" class="find-input">

                <button class="btn-filter" type="button">
                    <i class="fa fa-sliders-h"></i>
                </button>

                <select id="industryTypeId" name="industryTypeId" class="find-input custom-dropdown-select" asp-items="ViewBag.Industries">
                    <option value="">@Localizer["AllIndustries"]</option>
                </select>

                <select id="scoreId" name="scoreId" class="find-input custom-dropdown-select" asp-items="ViewBag.Scores">
                    <option value="">@Localizer["AllScores"]</option>
                </select>

                <select id="prospectsId" name="prospectsId" class="find-input custom-dropdown-select" asp-items="ViewBag.Outlooks">
                    <option value="">@Localizer["AllOutlooks"]</option>
                </select>

                <span class="refresh" title="@Localizer["RefreshTitle"]"><i class="fa fa-undo"></i></span>

                <button class="find-button" id="btn-search" type="button">
                    <i id="icon-search" class="fa fa-search"></i>
                    <span id="rating-loading" class="loader d-none"></span>
                    @Localizer["SearchButton"]
                </button>
            </div>
        </div>
    </div>
</section>

<section id="TableRank" class="pt-4">
    <div class="container">
        <div class="table-responsive">
            <table class="TableRank">
                <thead class="head-table">
                    <tr>
                        <th style="width: 120px;">@Localizer["PublicationDate"]</th>
                        <th>@Localizer["IssuingOrganization"]</th>
                        <th>@Localizer["Industry"]</th>
                        <th>@Localizer["StatusRating"]</th>
                        <th>@Localizer["OpinionType"]</th>
                        <th>@Localizer["RatingScore"]</th>
                        <th style="width:150px;">@Localizer["Outlook"]</th>
                        <th>@Localizer["BondCode"]</th>
                        <th style="width: 235px;">@Localizer["CreditRatingReport"]</th>
                    </tr>
                </thead>
                <tbody class="body-table" id="content-bind">
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Rating Info Modal -->
<div id="ratingInfoModal" class="rating-info-modal">
    <div class="rating-info-content">
        <div class="rating-info-header">
            <div class="rating-header-info">
                <span class="rating-current-score" id="modal-rating"></span>
                <h3 id="modal-issuer"></h3>
            </div>
            <button class="rating-info-close" onclick="closeRatingInfoPopup()">&times;</button>
        </div>
        <div class="rating-info-body">
            <!-- Paste your HTML module content here -->
            <div id="rating-html-content">
                @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRScorescaleTNDai", language = language, portalId = portalId })
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Home/_Register.cshtml" model="@(new ContactHomeModel { })" />
@section Scripts {
    <script asp-append-version="true" src="~/assets/css/views/ratings.index.js"></script>
    <script>
        var rakingsAjaxUrl = '@Url.Action("IndexAjax", "Ratings", new { language = language })';
        var currentLanguage = '@language';
        var filterOpen = false;
        var errorLoadingDataMsg = '@Localizer["ErrorLoadingData"]';
        var reportNotAvailableMsg = '@Localizer["ReportNotAvailable"]';
    </script>
}