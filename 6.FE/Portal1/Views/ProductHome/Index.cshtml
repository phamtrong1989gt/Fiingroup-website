@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using PT.Domain.Model;
@using PT.Infrastructure.Interfaces;
@using PT.Shared;
@inject IViewLocalizer Localizer;
@using System.Linq.Expressions;
@using PT.UI.Models
@inject IOptions<BaseSettings> _baseSettings;

@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;
}

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductBanner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductFiinTrust", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductOutStand", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductWhyLastest", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductCustomer", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductPartner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductDetailPartner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductUserTeam", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProductDeliver", language = language, portalId = portalId })

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const links = document.querySelectorAll('.narbartrust a');
		links.forEach(link => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				links.forEach(l => l.classList.remove('active'));
				link.classList.add('active');
			});
		});
	});

	const tabs = document.querySelectorAll('.tab');
	const contents = {
		'Hội đồng xếp hạng': document.getElementById('hđqt'),
		'Chuyên viên phân tích': document.getElementById('ban-dieu-hanh')
	};

	tabs.forEach(tab => {
		tab.addEventListener('click', () => {
			// Xóa trạng thái active và ẩn toàn bộ nội dung
			tabs.forEach(t => t.classList.remove('active'));
			Object.values(contents).forEach(content => content.style.display = 'none');

			// Kích hoạt tab hiện tại
			tab.classList.add('active');

			// Hiển thị nội dung tương ứng với text của tab
			const selected = tab.textContent.trim();
			contents[selected].style.display = 'block';
		});
	});
</script>
