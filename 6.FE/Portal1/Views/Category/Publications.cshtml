@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "NewsDeliver", language = language, portalId = portalId })

@section Scripts {
	<script>
		(function ($) {
			var newsAjaxUrl = '@Url.Action("PublicationsAjax", "Category", new { language = language })';
			var currentLanguage = '@language';

			function toYMD(date) {
				var y = date.getFullYear();
				var m = (date.getMonth() +1).toString().padStart(2, '0');
				var d = date.getDate().toString().padStart(2, '0');
				return y + '-' + m + '-' + d;
			}

			function normalizeDateInput(selector) {
				var $el = $(selector);
				var val = $el.val();
				if (!val) return;

				// If already in yyyy-MM-dd, keep it
				if (/^\d{4}-\d{2}-\d{2}$/.test(val)) {
					return;
				}

				// Try parsing common formats (dd/MM/yyyy or MM/dd/yyyy)
				var parts;
				if (/^\d{2}\/\d{2}\/\d{4}$/.test(val)) {
					parts = val.split('/'); // dd/MM/yyyy
					var d = parseInt(parts[0],10);
					var m = parseInt(parts[1],10) -1;
					var y = parseInt(parts[2],10);
					var dt = new Date(y, m, d);
					if (!isNaN(dt)) {
						$el.val(toYMD(dt));
					}
					return;
				}

				// Try Date constructor fallback
				var dt = new Date(val);
				if (!isNaN(dt)) {
					$el.val(toYMD(dt));
				}
			}

			function formatDateInputsBeforeSubmit() {
				normalizeDateInput('#startDate');
				normalizeDateInput('#endDate');
			}

			function buildParams(page) {
				var keyword = $('#search-input').val() || '';
				var fromDate = $('#startDate').val() || '';
				var toDate = $('#endDate').val() || '';

				return {
					Page: page ||1,
					Keyword: keyword,
					FromDate: fromDate,
					ToDate: toDate,
					Language: currentLanguage,
					CategoryIds: '@ViewData["ExCategoryIds"]'
				};
			}

			function showLoading() {
				$('#news-loading').removeClass('d-none');
				$('#btn-search').prop('disabled', true).attr('aria-busy', 'true');
			}

			function hideLoading() {
				$('#news-loading').addClass('d-none');
				$('#btn-search').prop('disabled', false).removeAttr('aria-busy');
			}

			window.getNewsAjax = function(page) {
				page = page ||1;
				var params = buildParams(page);

				// normalize dates before sending
				formatDateInputsBeforeSubmit();

				showLoading();

				$.get(newsAjaxUrl, params)
					.done(function (html) {
						$('#content-bind').html(html);
					})
					.fail(function () {
						$('#content-bind').html('<div class="no-data-messege">No data</div>');
					})
					.always(function () {
						hideLoading();
					});
			};

			$(function () {
				// initial load (if page has query params, keep them)
				var urlParams = new URLSearchParams(window.location.search);
				var initialKey = urlParams.get('key');
				var initialFrom = urlParams.get('startDate');
				var initialTo = urlParams.get('endDate');

				if (initialKey) $('#search-input').val(initialKey);
				if (initialFrom) $('#startDate').val(initialFrom);
				if (initialTo) $('#endDate').val(initialTo);

				// Clear button should clear and submit form to reload server-side results
				$('.btn-clear').on('click', function () {
					$('#search-input').val('');
					$('#startDate, #endDate').val('');
				});
			});
		})(jQuery);
	</script>
}