@model PT.Domain.Model.Category
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Options
@using PT.Shared;
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@inject PT.Infrastructure.Interfaces.ICategoryRepository _iCategoryRepository;

@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;

	var listCategory = new List<Category>();
	listCategory = await _iCategoryRepository.SearchAsync(true, 0, 10, x => (x.CategoryType == ECategoryType.ContentPage_Publications) && x.Status && x.Language == language && x.PortalId == portalId);
	listCategory = listCategory.OrderBy(x => x.ParentId).ThenBy(m => m.Order).ToList();
	string allTab = "Tất cả";
	if(language == "en")
	{
		allTab = "All";
    }
}

