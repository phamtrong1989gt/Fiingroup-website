                    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
                    gap: 50px;
                    margin-top: 60px;
                }

                .bg-method1 {
                    background: url('/Data/FR/method_detail1.jpg') no-repeat center center;
                    background-size: cover;
                    border-radius: 12px;
                    position: relative;
                }

                .bg-method2 {
                    background: url('/Data/FR/method_detail2.jpg') no-repeat center center;
                    background-size: cover;
                    border-radius: 12px;
                    position: relative;
                }

                .method-box {
                    position: relative;
                    z-index: 2;
                    height: 260px;
                    display: flex;
                    flex-direction: column;
                    justify-content: flex-end;
                    padding: 0px 20px;
                    color: #fff;
                    border: none;
                    box-shadow: 0 4px 10px rgba(0, 76, 152, 0.05);
                }

                .bg-method1,
                .bg-method2 {
                    position: relative;
                    background-size: cover;
                    background-position: center;
                    border-radius: 12px;
                    overflow: hidden;
                }

                /* Overlay sáng hơn */
                .bg-method1::before,
                .bg-method2::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.25);
                    /* từ 0.55 → 0.25 */
                    z-index: 1;
                }

                /* Nội dung nổi lên trên overlay */
                .method-box {
                    position: relative;
                    z-index: 2;
                }

                .method-box h2 {
                    color: #fff;
                    font-size: 28px;
                    font-weight: 700;
                    z-index: 2;
                }



