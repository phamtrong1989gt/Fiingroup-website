            <script>
                document.addEventListener('DOMContentLoaded', () => {
            const links = document.querySelectorAll('.narbartrust a');
		            links.forEach(link => {
			            link.addEventListener('click', (e) => {
				            e.preventDefault();
				            // Xóa class active
				            links.forEach(l => l.classList.remove('active'));
				            link.classList.add('active');
				            // Lấy ID mục tiêu
				            const targetId = link.getAttribute('href')?.trim();
				            // Nếu href null hoặc không phải id hợp lệ thì thoát
				            if (!targetId || !targetId.startsWith("#")) {
					            return;
				            }
				            const targetEl = document.querySelector(targetId);
				            if (targetEl) {
					            targetEl.scrollIntoView({
						            behavior: "smooth",
						            block: "start"
					            });
				            }
			            });
		            });
	            });
            </script>
