<section id="Banner">
    <div class="container">
        <div class="row">
            <h1 class="text-white mb-6 mt-5">@Localizer["Title"] </h1>
            @if (Model.DataAPI != null && Model.DataAPI.Items != null && Model.DataAPI.Items.Count > 0 && Model.DataAPI.Items[0] != null)
            {
                var item = Model.DataAPI.Items[0];
                string url = $"/{language}/event-fg/{item?.FriendlyTitle}-id{item?.Id}.html"?.ToLower();
                <div class="col-lg-5 col-sm-6 mb-5 d-none d-lg-block d-sm-block">
                    <h2 class="text-white mb-4">@item.Title</h2>
                    <div class="item-date mb-2">
                        <i class="fa fa-calendar-o" aria-hidden="true"></i>
                        <span class="item-label">@Localizer["EventDate"]</span>
                        <span>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "---")</span>
                    </div>
                    <div class="item-date mb-2">
                        <i class="fa fa-clock-o" aria-hidden="true"></i>
                        <span class="item-label">@Localizer["EventTime"]</span>
                        <span>@(item.TimeFromTo ?? "---")</span>
                    </div>
                    <div class="item-date mb-2">
                        <i class="fa fa-map-marker" aria-hidden="true"></i>
                        <span class="item-label">@Localizer["Location"]</span>
                        <span>@(item.Address ?? "---")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(item.FilePath))
                    {
                        <div>
                            <a style="font-weight:500;color:#fff;" target="_blank" href="@item.FilePath"><i class="fa fa-download"></i> @Localizer["DownloadDocument"]</a>
                        </div>
                    }
                    <div class="mt-5">
                        <a class="btn btn-light btn-about btn-khampha" href="@url" target="_blank">@Localizer["ViewDetails"]</a>
                    </div>
                </div>
                <div class="col-lg-7 col-sm-6 mb-5 mt-4">
                    <a href="@url" title="@item.Title">
                        <img loading="lazy" class="news-img" onerror="this.onerror=null;this.src='/Data/Banner/no-img.jpg';" src="@(item.ImageUrl ?? "/Data/Banner/no-img.jpg")" alt="@item.Title" />
                    </a>
                </div>
            }
            else
            {
                <p style="color: #fff; font-size:20px;">@Localizer["NoEvent"]</p>
            }
        </div>
    </div>
</section>

