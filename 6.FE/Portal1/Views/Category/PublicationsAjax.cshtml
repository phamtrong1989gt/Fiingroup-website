@model PT.Domain.Model.NewsListResponse
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Options
@using PT.Domain.Model
@using PT.Shared;
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;

@{
    Layout = null;
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var stPage = Context.Request.Query["page"].ToString();
    var bindContentTag = Context.Request.Query["bindContentTag"].ToString();
    // Lấy pageIndex từ query string nếu có, mặc định =1
    var pageIndex = 1;
    if (stPage != null)
    {
        pageIndex = int.TryParse(stPage, out var result) ? result : 1;
    }
}
<div class="row mt-5">
    @if (Model != null && Model.Items.Any())
    {
        @foreach (var item in Model.Items)
        {
            string url = $"/{language}/news-fg/{item.FriendlyTitle}-id{item.Id}.html".ToLower();
            <div class="col-lg-4 col-sm-6">
                <a href="@url" title="@item.Title">
                    <img class="news-img" onerror="this.onerror=null;this.src='@item.ImageUrl';" src="@(item.ImageUrl ?? "/Data/Banner/news.jpg")" alt="@item.Title">
                </a>
                <h3 class="pt-4">
                    <a href="@url" title="@item.Title" class="news-title">@Html.Raw(item.Title)</a>
                </h3>
                <div class="pt-2 pb-4 mb-4">
                    <a href="@url" title="@item.Title" class="show-more">@Localizer["ViewDetails"] <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
        }
        <div class="pagination-area mt-2 mb-3">
            <div aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    @Html.Raw(PT.Shared.Functions.GenPageListAjax2("", pageIndex, Model.Total, 9, $"&key={Context.Request.Query["key"]}" + $"&startDate={Context.Request.Query["startDate"]}" + $"&endDate={Context.Request.Query["endDate"]}", "page-active", null, bindContentTag ?? "getNewsAjax"))
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-12 col-sm-12 text-center my-5">
            <img src="/Data/Banner/no-data.jpg" alt="No data" />
            <p class="no-data-messege my-5">@Localizer["NoEvent"]</p>
        </div>
    }

</div>