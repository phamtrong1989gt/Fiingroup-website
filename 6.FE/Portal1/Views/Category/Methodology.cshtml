<section id="FiinMethod" class="mb-5">
	<style>
		.narbarmodel {
			padding: 50px 0;
			display: flex;
			justify-content: space-around;
			align-items: center;
		}

			.narbarmodel a {
				color: #093461;
				text-decoration: none;
				font-size: 18px;
				padding: 8px 0;
				display: flex;
				justify-content: center;
				min-width: 33%;
				transition: color 0.3s, border-bottom 0.3s;
				cursor: pointer;
				border-bottom: 3px solid transparent;
			}

				.narbarmodel a.active,
				.narbarmodel a:hover {
					color: #0066CC;
					font-weight: 600;
					border-bottom: 3px solid #093461;
				}

		.info-fiinrate p {
			color: #093461;
		}

		.method-wrap {
			position: relative;
			z-index: 1;
		}

		/* ===== Các box xếp hạng ===== */
		.method-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
			gap: 50px;
			margin-top: 60px;
		}

		.bg-method1 {
			background: url('/Data/FR/method_detail1.jpg') no-repeat center center;
			background-size: cover;
			border-radius: 12px;
			position: relative;
		}

		.bg-method2 {
			background: url('/Data/FR/method_detail2.jpg') no-repeat center center;
			background-size: cover;
			border-radius: 12px;
			position: relative;
		}

		.method-box {
			position: relative;
			z-index: 2;
			height: 260px;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 0px 20px;
			color: #fff;
			border: none;
			box-shadow: 0 4px 10px rgba(0, 76, 152, 0.05);
		}

		.bg-method1,
		.bg-method2 {
			position: relative;
			background-size: cover;
			background-position: center;
			border-radius: 12px;
			overflow: hidden;
		}

			/* Overlay sáng hơn */
			.bg-method1::before,
			.bg-method2::before {
				content: "";
				position: absolute;
				inset: 0;
				background: rgba(0, 0, 0, 0.25);
				/* từ 0.55 → 0.25 */
				z-index: 1;
			}

		/* Nội dung nổi lên trên overlay */
		.method-box {
			position: relative;
			z-index: 2;
		}

		.gach {
			border-bottom: 2px solid #C3E4F6;
			width: 30%;
		}

		.gach2 {
			border-bottom: 2px solid #fff;
			width: 30%;
		}

		.method-box h2 {
			color: #fff;
			font-size: 28px;
			font-weight: 700;
			z-index: 2;
		}

		.method-box p {
			font-size: 14px;
			color: #fff;
			text-align: justify;
			text-justify: inter-word;
			z-index: 2;
		}

		.method-box:hover {
			transform: translateY(-5px);
		}

		.method-box .sub-section {
			display: flex;
			align-items: flex-start;
			margin-bottom: 15px;
			padding-top: 15px;
		}

			.method-box .sub-section p {
				color: #fff;
				margin: 0;
			}

		.method-box .method-title {
			font-size: 24px;
			margin-top: 15%;
		}

