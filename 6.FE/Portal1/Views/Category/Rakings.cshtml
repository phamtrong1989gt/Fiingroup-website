@{
	Layout = "~/Views/Shared/_Home.cshtml";
	string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
	var portalId = _baseSettings.Value.PortalId;
}
<style>
	#Find {
		background: url("/Data/FR/ranking_banner2.jpg") no-repeat center top;
		background-size: cover;
		position: relative;
		/* để có không gian cho box-find-top */
	}

	.box-find-top {
		text-align: center;
		padding: 50px 0;
	}

	.time-options {
		display: flex;
		gap: 20px;
	}

		.time-options label {
			margin: 0;
			font-size: 14px;
			color: #333;
			font-weight: bold;
		}

		.time-options input[type="radio"] {
			margin-right: 5px;
		}


	.find-top input {
		width: 320px;
	}

	.find-top input {
		width: 320px;
		background-color: #fff;
	}

	.find-top {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		align-items: center;
	}

	.find-input {
		padding: 8px;
		border: 1px solid #ededed;
		border-radius: 4px;
		font-size: 14px;
		flex: 1;
		min-width: 150px;
	}

	.custom-dropdown {
		position: relative;
		min-width: 150px;
	}

	.dropdown-selected {
		padding: 8px;
		border: 1px solid #ededed;
		border-radius: 4px;
		font-size: 14px;
		cursor: pointer;
		background-color: #ffffff;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

		.dropdown-selected .fas.fa-chevron-down {
			margin-left: 5px;
			font-size: 12px;
			color: #555;
			transition: transform 0.3s ease;
		}

		.dropdown-selected.active .fas.fa-chevron-down {
			transform: rotate(180deg);
		}

	.dropdown-options {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background-color: #fff;
		border: 1px solid #ccc;
		border-radius: 4px;
		list-style: none;
		padding: 0;
		margin: 0;
		z-index: 1000;
		max-height: 150px;
		overflow-y: auto;
	}

		.dropdown-options li {
			padding: 8px;
			cursor: pointer;
			display: block;
			font-size: 13px;
			text-align: left;
		}

			.dropdown-options li:hover {
				background-color: #f0f0f0;
			}

	.refresh {
		cursor: pointer;
		color: #ff0000;
		font-size: 18px;
		margin-left: 10px;
		transform: rotate(35deg);
		transition: transform 0.3s ease;
	}

		.refresh.spin i {
			transform: rotate(-360deg);
			transition: transform 0.6s ease;
		}


	.find-button {
		background-color: #007bff;
		color: white;
		padding: 8px 16px;
		border: none;
		border-radius: 20px;
		cursor: pointer;
		font-size: 14px;
		display: flex;
		align-items: center;
		gap: 5px;
		min-width: 120px;
		justify-content: center;
	}

		.find-button .fas.fa-find-top {
			font-size: 14px;
			color: #ffffff !important;
		}

		.find-button:hover {
			background-color: #0056b3;
		}

	.clear {
		clear: both;
	}

	.btn-filter {
		width: 40px;
		height: 40px;
		border: none;
		border-radius: 10px;
		background: #edf3ff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		display: none;
	}

	#TableRank {
		background: url(../Data/ranking_bgtable.png);
		background-size: contain;
	}

		#TableRank .head-table th,
		#TableRank td {
			padding: 12px;
			border: 1px solid #ddd;
			background: #fff;
		}

		#TableRank tbody,
		td,
		tfoot,
		th,
		thead,
		tr {
			border-top: 1px !important;
			border-right: 0px !important;
			border-left: 0px !important;
		}

		#TableRank th {
			background-color: #ffffff;
			color: #034ea2;
			font-weight: 600;
			text-align: left;
		}

		/* #TableRank tr:nth-child(even) {
								background-color: #f8f9fa;
							} */

		#TableRank .head-table th {
			background-color: #f7f8f9;
			border-bottom: 1px solid #ccc;
		}

		#TableRank .download-btn {
			background-color: #28a745;
			color: white;
			border: none;
			padding: 5px 10px;
			text-decoration: none;
			border-radius: 4px;
			cursor: pointer;
		}

			#TableRank .download-btn:hover {
				background-color: #218838;
			}

	.gmt-text {
		color: #ccc;
		font-size: 13px;
	}

	.phat-hanh-text {
		text-transform: uppercase;
		font-size: 16px;
		color: #1359a7;
		text-align: left;
	}

	.icon-info {
		float: right;
		color: #66b7f1;
		cursor: pointer;
	}

		.icon-info i:hover {
			color: #154a8c;
			/* Màu đậm hơn khi hover */
		}

		/* Ẩn tooltip mặc định của title */
		.icon-info i[title] {
			pointer-events: none;
			/* Vô hiệu hóa tương tác với title */
		}

		/* Tooltip tùy chỉnh */
		.icon-info i[data-tooltip]:hover:after {
			content: attr(data-tooltip);
			position: absolute;
			background-color: #6294c9;
			color: #ffffff;
			padding: 5px 12px;
			border-radius: 3px;
			font-size: 12px;
			white-space: nowrap;
			z-index: 1000;
			top: 50px;
			font-family: Arial, "Times New Roman", Roboto, Segoe UI, sans-serif !important;
			/* Fallback font */
		}

	.type-text {
		background-color: #eaf4ff;
		padding: 5px 10px;
		border-radius: 20px;
		color: #1f63ad;
	}

	.icon-down {
		font-size: 18px;
		color: #489efb;
		cursor: pointer;
	}

	.page-table {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 10px;
		font-size: 16px;
	}

	.numberpage {
		margin-right: 20px;
	}

	.pagination {
		display: flex;
		gap: 30px;
		align-items: center;
		cursor: pointer;
	}

		.pagination .active {
			padding: 5px 14px;
			border: 1px solid #4d94dc;
			border-radius: 5px;
			background: #fff;
			cursor: pointer;
			color: #1f78d3;
		}

	.btn-download {
		background: none;
		border: none;
		cursor: pointer;
		color: #2E90FA;
		border-left: 1px solid #E1F4FD;
	}

		.btn-download:hover {
			background: #007bff00;
			border-radius: 5px;
			color: rgb(0, 0, 0);
			box-shadow: 0 4px 10px #007bff33;
		}

	.language-switch {
		display: flex;
		align-items: center;
		gap: 25px;
		font-size: 16px;
		color: #1a1a1a;
	}

	.lang-option {
		display: flex;
		align-items: center;
		gap: 8px;
		cursor: pointer;
		user-select: none;
	}

		/* Ẩn radio mặc định */
		.lang-option input[type="radio"] {
			display: none;
		}

		/* Vòng ngoài có border gradient */
		.lang-option .radio {
			width: 16px;
			height: 16px;
			position: relative;
			border-radius: 50%;
			background: linear-gradient(135deg, #034ea2, #53dfff);
			padding: 1px;
			/* tạo khoảng cho border */
			transition: all 0.3s ease;
		}

			/* Lớp trắng bên trong để nhìn rõ border gradient */
			.lang-option .radio::before {
				content: "";
				position: absolute;
				inset: 1px;
				background: #fff;
				border-radius: 50%;
			}

		/* Chấm giữa khi chọn */
		.lang-option input[type="radio"]:checked + .radio::after {
			content: "";
			position: absolute;
			top: 3px;
			left: 3px;
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: linear-gradient(135deg, #034ea2, #53dfff);
			box-shadow: 0 0 5px rgba(83, 223, 255, 0.6);
			transition: all 0.2s ease;
		}

		/* Hiệu ứng hover */
		.lang-option:hover .radio {
			box-shadow: 0 0 5px rgba(83, 223, 255, 0.5);
		}
</style>
