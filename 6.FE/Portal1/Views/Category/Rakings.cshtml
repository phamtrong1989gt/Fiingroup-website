<script>
	document.addEventListener("DOMContentLoaded", function () {
		const filterBtn = document.querySelector(".btn-filter");
		const dropdownSelecteds = document.querySelectorAll(".dropdown-selected");
		const refhesh = document.querySelectorAll(".refresh");
		let filterOpen = false; // trạng thái đóng/mở

		// Function ẩn dropdown khi mobile
		function applyMobileDropdownHide() {
			if (window.innerWidth <= 768) {
				dropdownSelecteds.forEach(el => el.style.display = "none");
				refhesh.forEach(el => el.style.display = "none");

				filterOpen = false;
			} else {
				dropdownSelecteds.forEach(el => el.style.display = "");
				refhesh.forEach(el => el.style.display = "");
			}
		}

		// Gọi khi load trang
		applyMobileDropdownHide();

		// Toggle khi bấm FILTER
		filterBtn.addEventListener("click", () => {
			filterOpen = !filterOpen; // toggle trạng thái

			if (filterOpen) {
				dropdownSelecteds.forEach(el => el.style.display = "");
				refhesh.forEach(el => el.style.display = "");
			} else {
				dropdownSelecteds.forEach(el => el.style.display = "none");
				refhesh.forEach(el => el.style.display = "none");
			}
		});

		// Re-check khi resize (tránh bug khi xoay màn hình)
		window.addEventListener("resize", applyMobileDropdownHide);
	});

	document.addEventListener("DOMContentLoaded", function () {
		const refreshBtn = document.querySelector(".refresh");
		const searchInput = document.querySelector(".find-input");
		const dropdowns = document.querySelectorAll(".custom-dropdown");

		refreshBtn.addEventListener("click", function () {
			// Xóa nội dung input text
			searchInput.value = "";

			// Reset các dropdown về giá trị mặc định (item đầu tiên)
			dropdowns.forEach(dropdown => {
				const firstOption = dropdown.querySelector(".dropdown-options li:first-child");
				const selected = dropdown.querySelector(".dropdown-selected");

				if (firstOption && selected) {
					selected.textContent = firstOption.textContent + " ";
					selected.insertAdjacentHTML("beforeend", '<i class="fa fa-chevron-down"></i>');
				}

				// Nếu bạn đang dùng data-value để lưu giá trị đã chọn
				dropdown.dataset.value = firstOption ? firstOption.dataset.value : "";
			});

			// Nếu muốn bỏ checked radio → thêm dòng này
			// document.querySelectorAll('input[name="time"]').forEach(r => r.checked = false);

			// Thêm hiệu ứng nhẹ khi refresh xong
			refreshBtn.classList.add("spin");
			setTimeout(() => refreshBtn.classList.remove("spin"), 600);
		});
	});

	document.querySelectorAll('.custom-dropdown').forEach(dropdown => {
		const selected = dropdown.querySelector('.dropdown-selected');
		const options = dropdown.querySelector('.dropdown-options');
		const items = options.querySelectorAll('li');

		selected.addEventListener('click', () => {
			const isOpen = options.style.display === 'none';
			options.style.display = isOpen ? 'block' : 'none';
			selected.classList.toggle('active', isOpen); // Thêm/Loại bỏ class 'active' để xoay icon
		});

		items.forEach(item => {
			item.addEventListener('click', () => {
				selected.innerHTML = `${item.textContent} <i class="fa fa-chevron-down"></i>`;
				options.style.display = 'none';
				selected.classList.remove('active'); // Loại bỏ class 'active' khi chọn
				dropdown.dataset.value = item.dataset.value;
			});
		});

		document.addEventListener('click', (e) => {
			if (!dropdown.contains(e.target)) {
				options.style.display = 'none';
				selected.classList.remove('active'); // Loại bỏ class 'active' khi click ra ngoài
			}
		});
	});

	document.querySelectorAll('.pagination div').forEach(item => {
					item.addEventListener('click', () => {
						document.querySelectorAll('.pagination div').forEach(div => div.classList.remove('active'));
						item.classList.add('active');
					});
				});

				// Xử lý chevron
				let currentPage = 2; // Bắt đầu với trang 2 (do có class active mặc định)

				document.querySelector('.chevron-left').addEventListener('click', () => {
					if (currentPage > 1) {
						currentPage--;
						updateActivePage();
					}
				});

				document.querySelector('.chevron-right').addEventListener('click', () => {
					if (currentPage < 4) { // Giả sử có 4 trang
						currentPage++;
						updateActivePage();
					}
				});

				function updateActivePage() {
					document.querySelectorAll('.pagination div').forEach((div, index) => {
						div.classList.remove('active');
						if (parseInt(div.textContent) === currentPage) {
							div.classList.add('active');
						}
					});
				});
</script>