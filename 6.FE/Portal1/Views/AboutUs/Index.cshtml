        <script>
            const tabs = document.querySelectorAll('.tab');
            const contents = {
                'Hội đồng xếp hạng': document.getElementById('hđqt'),
                'Chuyên viên phân tích': document.getElementById('ban-dieu-hanh')
            };

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    // Xóa trạng thái active và ẩn toàn bộ nội dung
                    tabs.forEach(t => t.classList.remove('active'));
                    Object.values(contents).forEach(content => content.style.display = 'none');

                    // Kích hoạt tab hiện tại
                    tab.classList.add('active');

                    // Hiển thị nội dung tương ứng với text của tab
                    const selected = tab.textContent.trim();
                    contents[selected].style.display = 'block';
                });
            });
        </script>
