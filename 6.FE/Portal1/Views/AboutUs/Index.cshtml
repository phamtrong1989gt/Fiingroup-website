<script>
     document.addEventListener('DOMContentLoaded', () => {
        // smooth scroll for .narbarstory links
        const links = document.querySelectorAll('.narbarstory a');
        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                links.forEach(l => l.classList.remove('active'));
                link.classList.add('active');
                const targetId = link.getAttribute('href')?.trim();
                if (!targetId || !targetId.startsWith("#")) return;
                const targetEl = document.querySelector(targetId);
                if (targetEl) targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
            });
        });

        // Tabs handling (index-based mapping)
        const tabs = Array.from(document.querySelectorAll('.tab'));

        // Define content sections in the order that matches the visual order of tabs
        const contentIds = ['hdqt', 'ban-dieu-hanh', 'ban-cv'];
        const contents = contentIds.map(id => document.getElementById(id));


        function activateTab(index) {
            if (!tabs.length) return;
            tabs.forEach(t => t.classList.remove('active'));
            if (tabs[index]) tabs[index].classList.add('active');
            contents.forEach(c => { if (c) c.style.display = 'none'; });
            if (contents[index]) contents[index].style.display = 'block';
        }

        // initialize: activate existing .active tab or fall back to index 0
        const existingActive = tabs.findIndex(t => t.classList.contains('active'));
        activateTab(existingActive >= 0 ? existingActive : 0);

        tabs.forEach((tab, idx) => {
            tab.addEventListener('click', (e) => {
                e.preventDefault();
                activateTab(idx);
            });
        });
    });
</script>