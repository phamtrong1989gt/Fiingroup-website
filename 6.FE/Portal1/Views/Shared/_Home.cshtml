@using PT.Base.Services
@using PT.Domain.Model;
@using PT.UI.Models
@addTagHelper *, PT.UI
@inject Microsoft.Extensions.Options.IOptions<AuthorizeSettings> _authorizeSettings;
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Options.IOptions<BaseSettings> _baseSettings;
@inject ISettingService _settingService;
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _webHostEnvironment;

@{
    string domain = Context.Request.Host.ToString();
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var listLanguage = PT.Shared.ListData.ListLanguage;
    var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
    var portalId = _baseSettings.Value.PortalId;
    var seoSettings = await _settingService.SeoSettingGet(language, portalId);
    var bindContentSetting = await _settingService.BindContentSettingGet(portalId);
    var homeModel = new HomeModel
    {
        Domain = domain,
        SeoSetting = seoSettings ?? new SeoSetting()
    };
    var currentType = PT.Base.CookieExtensions.Get("CurrentPrice");

    var linkData = new Link();
    if (ViewData["linkData"] != null)
    {
        linkData = (Link)ViewData["linkData"];
    }
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex">
    <meta name="googlebot" content="noindex">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="assets/img/logo/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    </noscript>
    <link rel="stylesheet" href="/vendor.bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="/site.bundle.min.css" asp-append-version="true" />
    <partial name="_HomeHead" model="@(new Tuple<HomeModel, Link>(homeModel, linkData))" />
    <script src="/assets/js/jquery.min.js"></script>
    @Html.Raw(bindContentSetting.Head)
</head>

<body id="Body">
    <input type="hidden" id="linkId" value="@linkData?.Id" />

    <div class="body">
        <section id="Header">
            @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeBannerTop", language = language, portalId = portalId })
            @await Component.InvokeAsync("ViewModule", new { type = ModuleType.Menu, code = "FRMenuPC", language = language, portalId = portalId })
        </section>
        <main>
            @RenderBody()
        </main>
        <div class="footter hidden-login">
            @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeFooter", language = language, portalId = portalId })
            @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeFooterMenu", language = language, portalId = portalId })
        </div>
        @await Component.InvokeAsync("ViewModule", new { type = ModuleType.Menu, code = "FRMenuMobile", language = language, portalId = portalId })
        <partial name="~/Views/Home/_RegisterSolution.cshtml" model="@(new ContactSolotionModel { })" />
        <button aria-label="top" class="btn btn-info rounded-circle btn-lg" id="scroll-top"><i class="fa fa-chevron-up" style="color:white;"></i></button>
        <div id="recaptcha-backdrop"></div>
        <div id="recaptcha-wrapper">
            <button id="recaptcha-close-btn" type="button">&times;</button>
            <div id="recaptcha-loading">
                <div class="spinner"></div>
                <p>@Localizer["Đang tải xác thực..."]</p>
            </div>
            <div id="recaptcha-container"></div>
        </div>
    </div>
    <script>
        function prepareManualSlides($carousel){if(!$carousel||!$carousel.length)return;$carousel.find('.owl-stage .owl-item').each(function(){const $owlItem=$(this);let $content=$owlItem.children().first();if(!$content||!$content.length)return;if($content.hasClass('manual-slide')||$content.find('.manual-slide').length){$content.find('img').css({'max-width':'80%','max-height':'80%','object-fit':'contain'});return}
        $content.wrapInner('<div class="manual-slide"></div>');const $wrap=$content.find('.manual-slide').first();const $img=$wrap.find('img').first();if($img.length){$img.css({'max-width':'80%','max-height':'80%','object-fit':'contain','display':'block'})}else{const $bgEl=$wrap.find('[data-bg]').first();if($bgEl.length){const bg=$bgEl.attr('data-bg');if(bg)$bgEl.addClass('manual-bg').css('background-image','url('+bg+')')}}})}
        $(document).ready(function (){let owl=$('#owlour');owl.owlCarousel({margin:0,autoplay:true,autoplayTimeout:5000,nav:false,loop:true,dots:false,dotsData:true,pagination:false,margin:0,responsive:{0:{items:1},600:{items:2},1000:{items:3}}}); $('.counter').counterUp({delay:10,time:1200});let star='.star',selected='.selected';$(star).on('click',function (){$(selected).each(function (){$(this).removeClass('selected')});$(this).addClass('selected')});$(window).scroll(function (){if ($(this).scrollTop()>200){$('#scroll-top').fadeIn()}else{$('#scroll-top').fadeOut()}});$('#scroll-top').click(function (){$('html, body').animate({scrollTop:0},500);return false})});
    </script>

    <script>
        var recaptchaSiteKey = '@_authorizeSettings.Value.CapChaDataSitekey'; var recaptchaWidgetId = null; var isRecaptchaShown = false; var btnSend = null; function initRecaptcha() {
        if(typeof grecaptcha!=='undefined'&&recaptchaWidgetId===null){$('#recaptcha-container').empty();recaptchaWidgetId=grecaptcha.render('recaptcha-container',{'sitekey':recaptchaSiteKey,'callback':onRecaptchaSuccess,'expired-callback':onRecaptchaExpired});$('#recaptcha-loading').hide();$('#recaptcha-container').show()}}
        function onRecaptchaSuccess(token){$(".Capcha").val(token);hideRecaptchaPopup();$(this.btnSend).click()}
        function onRecaptchaExpired(){$(".Capcha").val("");if(recaptchaWidgetId!==null){grecaptcha.reset(recaptchaWidgetId)}}
        function showRecaptchaPopup(btnElement){this.btnSend=btnElement;if(!isRecaptchaShown){$('#recaptcha-loading').show();$('#recaptcha-container').hide();$("#recaptcha-backdrop").fadeIn(200);$("#recaptcha-wrapper").fadeIn(200);isRecaptchaShown=!0;if(typeof grecaptcha==='undefined'||recaptchaWidgetId===null){var checkInterval=setInterval(function(){if(typeof grecaptcha!=='undefined'&&grecaptcha.render){clearInterval(checkInterval);initRecaptcha()}},100);setTimeout(function(){clearInterval(checkInterval);if(recaptchaWidgetId===null){$('#recaptcha-loading p').text('Lỗi tải reCAPTCHA. Vui lòng thử lại.')}},5000)}else{grecaptcha.reset(recaptchaWidgetId);$('#recaptcha-loading').hide();$('#recaptcha-container').show()}}}
        function hideRecaptchaPopup(){$("#recaptcha-backdrop").fadeOut(300);$("#recaptcha-wrapper").fadeOut(300);isRecaptchaShown=!1}
        $("#recaptcha-close-btn").on("click",function(){hideRecaptchaPopup()})
        $(document).ready(function(){var linkId=$('#linkId').val()||'0';$('.btn-lang .dropdown-menu a').each(function(){var $link=$(this);var currentHref=$link.attr('href');var language=currentHref.replace('/','');var newHref='@Url.Action("ChangeLanguage", "Home")'+'?language='+language+'&linkId='+linkId;$link.attr('href',newHref)})})
    </script>
    <script src="/vendor.bundle.min.js" asp-append-version="true"></script>
    <script src="/site.bundle.min.js" asp-append-version="true"></script>
    <script>
        var recaptchaSiteKey = '@_authorizeSettings.Value.CapChaDataSitekey';
        var language = '@language';
    </script>
    @Html.Raw(bindContentSetting.Body)
</body>
</html>
@Html.Raw(bindContentSetting.Footer)
<partial name="_SettingHome" />
@RenderSection("Scripts", required: false)
