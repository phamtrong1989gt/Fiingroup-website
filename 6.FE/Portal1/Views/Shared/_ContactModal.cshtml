@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer  Localizer
@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
}
<div id="downloadModal" class="modal-overlay">
    <style>
        /* Nền mờ */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        /* Khung modal */
        .modal-box {
            width: 60%;
            max-width: 95%;
            background: #fff;
            border-radius: 14px;
            padding: 30px 40px;
            position: relative;
            animation: fadeIn .3s ease;
            display: flex;
            gap: 35px;
            margin-top: 10px;
        }

        .modal-left {
            flex: 0 0 55%;
        }

        .modal-right {
            flex: 0 0 45%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            /* Ảnh minh họa */
            .modal-right img {
                width: 100%;
                height: auto;
                object-fit: contain;
            }

        /* Icon đóng */
        .modal-close {
            position: absolute;
            right: 18px;
            top: 15px;
            font-size: 28px;
            color: #666;
            cursor: pointer;
        }

        /* Title */
        .modal-title {
            font-size: 32px;
            font-weight: 700;
            color: #093461;
            margin-bottom: 25px;
        }

        .highlight {
            color: #0066CC;
        }

        .red {
            color: red;
        }

        /* FORM GRID 2 CỘT */
        .modal-form {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px 25px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            margin-bottom: 6px;
            color: #093461;
            font-weight: 500;
        }

        .form-group input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #cdd7e3;
            font-size: 14px;
        }

        .form-group.full {
            grid-column: span 2;
        }

        /* Button */
        .btn-submit {
            display: block;
            margin: 30px 0 0 auto;
            /* nằm phía phải */
            padding: 12px 50px;
            background: #0066CC;
            color: #fff;
            font-size: 16px;
            font-weight: 500;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            transition: 0.2s;
            width: 100%;
        }

            .btn-submit:hover {
                background: #0053a5;
            }

        /* Animation */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }



        /* ===== RESPONSIVE MOBILE (≤ 768px) ===== */
        @@media (max-width: 768px) {

            .modal-box {
                flex-direction: column;
                /* chia từ 2 cột → 1 cột */
                width: 92% !important;
                /* modal rộng vừa màn hình */
                padding: 20px !important;
                gap: 20px !important;
                height: 400px;
            }
            /* Ảnh đưa lên trên form */
            .modal-right {
                order: -1;
                flex: unset;
                width: 100% !important;
                justify-content: center;
            }

                .modal-right img {
                    width: 80%;
                    max-width: 260px;
                    margin: 0 auto 10px auto;
                    display: block;
                }
            /* Form full width */
            .modal-left {
                flex: unset;
                width: 100% !important;
            }
            /* Form grid 1 cột */
            .modal-form {
                grid-template-columns: 1fr !important;
                gap: 15px !important;
            }

            .form-group.full {
                grid-column: span 1 !important;
            }
            /* Nút gửi */
            .btn-submit {
                width: 100% !important;
                margin: 20px 0 0 0 !important;
                padding: 12px 30px;
                font-size: 15px;
            }
            /* Tiêu đề mobile */
            .modal-title {
                font-size: 22px !important;
                text-align: center;
            }

            .modal-close {
                top: 10px;
                right: 12px;
            }

            .modal-box {
                max-height: 85vh;
                overflow-y: auto;
                overscroll-behavior: contain;
            }
                /* Ẩn thanh scroll xấu trên Chrome */
                .modal-box::-webkit-scrollbar {
                    width: 6px;
                }

                .modal-box::-webkit-scrollbar-thumb {
                    background: #c5d3e6;
                    border-radius: 4px;
                }
        }
    </style>

    <div class="modal-box">
        <span class="modal-close">&times;</span>
        <div class="modal-left">
            <h3 class="modal-title">
                Liên hệ <span class="highlight">với chúng tôi</span>
            </h3>

            <div class="modal-form">

                <div class="form-group">
                    <label>Họ và tên <span class="red">*</span></label>
                    <input type="text" placeholder="Nhập Họ và tên">
                </div>

                <div class="form-group">
                    <label>Số điện thoại <span class="red">*</span></label>
                    <input type="text" placeholder="Nhập Số điện thoại">
                </div>

                <div class="form-group full">
                    <label>Email <span class="red">*</span></label>
                    <input type="email" placeholder="Nhập Email">
                </div>

                <div class="form-group">
                    <label>Tên công ty <span class="red">*</span></label>
                    <input type="text" placeholder="Nhập Tên công ty">
                </div>

                <div class="form-group">
                    <label>Chức danh công việc <span class="red">*</span></label>
                    <input type="text" placeholder="Nhập Chức danh công việc">
                </div>
                <div class="form-group full">
                    <label for="dichVuQT" class="form-label">
                        Dịch vụ quan tâm <span class="error">*</span>
                    </label>
                    <select class="form-select" id="dichVuQT" aria-label="Default select example">
                        <option selected>Chọn dịch vụ quan tâm</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="form-group full">
                    <label for="yeuCauCT" class="form-label">
                        Yêu cầu chi tiết <span class="error">*</span>
                    </label>
                    <textarea type="text" maxlength="200" class="form-control txt-area" id="yeuCauCT"
                              placeholder="Nhập yêu cầu chi tiết"></textarea>
                </div>

            </div>
            <button class="btn-submit">Gửi thông tin liên hệ</button>
        </div>
        <!-- RIGHT (IMAGE) -->
        <div class="modal-right">
            <img src="Data/bg-dangky.png" alt="Đăng ký" />
        </div>

    </div>
</div>

<script>
    const modal = document.getElementById("downloadModal");
    const openBtn = document.querySelector(".btn-open-modal");
    const closeBtn = document.querySelector(".modal-close");

    if (openBtn) {
        openBtn.addEventListener("click", () => {
            modal.style.display = "flex";
        });
    }

    closeBtn.addEventListener("click", () => {
        modal.style.display = "none";
    });

    window.addEventListener("click", e => {
        if (e.target === modal) modal.style.display = "none";
    });
</script>