@model PT.Domain.Model.ContentPage
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@inject ICategoryRepository _iCategoryRepository;
@inject IContentPageReferenceRepository _iContentPageReferenceRepository;
@inject IOptions<BaseSettings> _baseSettings;
@inject IViewLocalizer  Localizer
@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    //var listLinkRefe = await _iContentPageReferenceRepository.SearchAsync(true, 0, 0, x => x.ContentPageId == Model.Id);
    var portalId = _baseSettings.Value.PortalId;
}

<section id="CompanyOverview" class="pt-5">
    <style>
        #CompanyOverview {
            padding: 60px 0;
            color: #093461;
        }

        .company-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 60px;
            align-items: start;
        }

        /* --- Cột trái --- */
        .company-title {
            font-size: 40px;
            font-weight: 700;
            color: #093461;
            margin-bottom: 15px;
            line-height: 1.3;
        }

        .company-desc {
            font-size: 16px;
            line-height: 1.7;
            color: #093461;
            margin-bottom: 25px;
        }

        .company-info-box {
            border: 1.5px solid #d7e4ff;
            border-radius: 12px;
            padding: 25px 30px;
            border: 1px solid transparent;
            background-image: linear-gradient(#fff, #fff), linear-gradient(to right, #0018A8, #166BF2, #3B7EEE);
            background-origin: border-box;
            background-clip: padding-box, border-box;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 18px;
        }

        .info-item {
            flex: 1;
        }

        #CompanyOverview .label {
            font-size: 14px;
            /* color: #6c7b92; */
            margin-bottom: 3px;
            font-weight: bold;
        }

        #CompanyOverview .value {
            font-size: 18px;
            font-weight: 600;
            color: #0066CC;
        }

        .value.highlight {
            color: #034EA2;
            font-size: 18px;
        }

        .value.status {
            background: #E1F4FD;
            /* color: #0066cc; */
            padding: 3px 15px;
            border-radius: 20px;
            display: inline-block;
            font-weight: unset !important;
        }

        .value.date {
            color: #0066cc;
            text-decoration: underline;
        }

        /* --- Cột phải --- */
        .news-title {
            font-size: 28px;
            font-weight: 700;
            color: #093461;
            margin-bottom: 15px;
        }

        .news-tab {
            color: #034EA2;
            font-weight: 600;
            border: none;
            padding: 8px 32px;
            border-radius: 8px;
            margin-bottom: 30px;
            font-size: 16px;
        }

            .news-tab.active {
                background: #E1F4FD;
            }

        .news-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .news-item {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }


            .news-item:not(:first-child) {
                border-top: 1px solid #ccc;
                padding: 20px 0;
            }


        .news-thumb {
            width: 140px;
            height: 75px;
            border-radius: 6px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .news-text {
            font-size: 15px;
            line-height: 1.4;
            color: #093461;
            font-weight: 500;
        }
    </style>
    <div class="container">
        <div class="company-grid">
            <!-- CỘT TRÁI -->
            <div class="company-left">
                <h2 class="company-title">Ngân hàng Thương mại Cổ phần Hàng Hải Việt Nam</h2>
                <p class="company-desc">
                    Một trong những ngân hàng thương mại cổ phần lớn tại Việt Nam, với tổng tài sản đạt hơn
                    230.000 tỷ đồng và vốn điều lệ 20.000 tỷ đồng.
                    MSB tập trung vào mảng bán lẻ và doanh nghiệp vừa và nhỏ, duy trì tỷ lệ an toàn vốn (CAR)
                    cao và đẩy mạnh chuyển đổi số trong hoạt động.
                </p>

                <div class="company-info-box">
                    <div class="info-row">
                        <div class="info-item">
                            <p class="label">Loại hình</p>
                            <p class="value">Ngân hàng Thương mại (NHTM)</p>
                        </div>
                        <div class="info-item">
                            <p class="label">Kết quả xếp hạng</p>
                            <p class="value">A</p>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-item">
                            <p class="label">Ngành</p>
                            <p class="value">Ngân hàng</p>
                        </div>
                        <div class="info-item">
                            <p class="label">Triển vọng</p>
                            <p class="value status">Ổn định</p>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-item">
                            <p class="label">Loại ý kiến</p>
                            <p class="value">XHTN Tổ chức phát hành</p>
                        </div>
                        <div class="info-item">
                            <p class="label">Ngày công bố</p>
                            <p class="value">27 / 06 / 2025</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI -->
            <div class="company-right">
                <h3 class="news-title">Tin tức ngành</h3>
                <!-- <button class="news-tab active">Ngân hàng</button> -->

                <div class="news-list">
                    <div class="news-item">
                        <img src="/Data/FR/think2.png" alt="news 1" class="news-thumb">
                        <p class="news-text">
                            Chủ tịch FiinGroup và FiinRatings chia sẻ tại Diễn đàn Ngân hàng
                            bán lẻ Việt Nam...
                        </p>
                    </div>

                    <div class="news-item">
                        <img src="/Data/FR/think3.png" alt="news 2" class="news-thumb">
                        <p class="news-text">
                            Chủ tịch FiinGroup và FiinRatings chia sẻ tại Diễn đàn Ngân hàng
                            bán lẻ Việt Nam...
                        </p>
                    </div>

                    <div class="news-item">
                        <img src="/Data/FR/think4.png" alt="news 3" class="news-thumb">
                        <p class="news-text">
                            Chủ tịch FiinGroup và FiinRatings chia sẻ tại Diễn đàn Ngân hàng
                            bán lẻ Việt Nam...
                        </p>
                    </div>
                </div>

                <div class="pt-5">
                    <a href="#" class="show-more">Xem tất cả <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>
<section id="RankingSection" class="pb-5">
    <style>
        .ranking-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 50px;
            align-items: start;
        }

        /* --- CỘT TRÁI --- */
        .ranking-block {
            margin-bottom: 40px;
        }

        .ranking-title {
            font-size: 26px;
            font-weight: 700;
            color: #093461;
            margin-bottom: 20px;
        }

        .ranking-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }

            .ranking-table td {
                padding: 8px 12px;
                font-size: 14px;
                text-align: left;
                border-bottom: 1px solid #e1e8f5;
            }

            .ranking-table th {
                padding: 15px 10px;
                font-size: 14px;
                color: #034EA2;
                font-weight: 600;
                background: #F7F8F9;
                border-bottom: 1px solid #e1e8f5;
            }

            .ranking-table td.rank {
                color: #034EA2;
                font-weight: 700;
            }

        .status {
            background: #E1F4FD;
            color: #0066cc;
            padding: 5px 12px;
            border-radius: 20px;
        }

        .language-switch {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 12px;
            color: #1a1a1a;
        }

        .lang-option {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
        }

            /* Ẩn radio mặc định */
            .lang-option input[type="radio"] {
                display: none;
            }

            .lang-option .radio {
                width: 16px;
                height: 16px;
                position: relative;
                border-radius: 50%;
                background: linear-gradient(135deg, #034ea2, #53dfff);
                padding: 1px;
                /* tạo khoảng cho border */
                transition: all 0.3s ease;
            }

                /* Lớp trắng bên trong để nhìn rõ border gradient */
                .lang-option .radio::before {
                    content: "";
                    position: absolute;
                    inset: 1px;
                    background: #fff;
                    border-radius: 50%;
                }

            /* Chấm giữa khi chọn */
            .lang-option input[type="radio"]:checked + .radio::after {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 3px;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: linear-gradient(135deg, #034ea2, #53dfff);
                box-shadow: 0 0 5px rgba(83, 223, 255, 0.6);
                transition: all 0.2s ease;
            }

            /* Hiệu ứng hover */
            .lang-option:hover .radio {
                box-shadow: 0 0 5px rgba(83, 223, 255, 0.5);
            }

        .btn-download {
            background: none;
            border: none;
            cursor: pointer;
            color: #2E90FA !important;
            border-left: 1px solid #E1F4FD;
        }

            .btn-download:hover {
                background: #007bff00;
                border-radius: 5px;
                color: rgb(0, 0, 0);
                box-shadow: 0 4px 10px #007bff33;
            }


        .no-data {
            text-align: center !important;
            color: #000;
            font-style: italic;
            padding: 15px !important;
            font-size: 12px !important;
            border: none !important;
        }

        /* --- CỘT PHẢI --- */
        .ranking-right {
            background: transparent;
        }

        .points-title {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .points-tab {
            color: #034EA2;
            font-weight: 600;
            border: none;
            padding: 8px 32px;
            border-radius: 8px;
            margin-bottom: 30px;
            font-size: 16px;
        }

            .points-tab.active {
                background: #E1F4FD;
            }

        .points-list {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-weight: 500;
            font-size: 17px;
        }

        .points-item {
            border-top: 1px solid #ccc;
            padding-top: 30px;
        }

            .points-item:first-child {
                border-top: none;
                padding-top: 0;
            }


        

    </style>

    <div class="container ranking-grid">

        <!-- CỘT TRÁI -->
        <div class="ranking-left">

            <!-- Xếp hạng tổ chức phát hành -->
            <div class="ranking-block">
                <h2 class="ranking-title">Xếp hạng Tổ chức Phát hành</h2>
                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th style="width: 165px;">Loại ý kiến</th>
                            <th>Ngày</th>
                            <th>Kết quả xếp hạng</th>
                            <th>Triển vọng</th>
                            <th>Báo cáo Xếp hạng Tín nhiệm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td data-label="Loại ý kiến">Cập nhật Xếp hạng - 27/06/2025</td>
                            <td data-label="Ngày">27/06/2025</td>
                            <td data-label="Kết quả xếp hạng" class="rank">A</td>
                            <td data-label="Triển vọng"><span class="status">Ổn định</span></td>
                            <td data-label="Báo cáo Xếp hạng Tín nhiệm">
                                <div class="language-switch">
                                    <label class="lang-option">
                                        <input type="radio" name="language_1" value="vn" checked="">
                                        <span class="radio"></span>
                                        VN
                                    </label>
                                    <label class="lang-option">
                                        <input type="radio" name="language_1" value="en">
                                        <span class="radio"></span>
                                        EN
                                    </label>
                                    <button class="btn-download" data-bs-toggle="modal" data-bs-target="#downloadModal" title="Tải báo cáo">
                                        <i class="fas fa-download"></i> Tải về
                                    </button>
                                </div>

                            </td>
                        </tr>
                        <tr>
                            <td data-label="Loại ý kiến">Xếp hạng Lần đầu - 17/07/2023</td>
                            <td data-label="Ngày">17/07/2023</td>
                            <td data-label="Kết quả xếp hạng" class="rank">BBB+</td>
                            <td data-label="Triển vọng"><span class="status">Ổn định</span></td>
                            <td data-label="Báo cáo Xếp hạng Tín nhiệm">
                                <div class="language-switch">
                                    <label class="lang-option">
                                        <input type="radio" name="language_2" value="vn" checked="">
                                        <span class="radio"></span>
                                        VN
                                    </label>
                                    <label class="lang-option">
                                        <input type="radio" name="language_2" value="en">
                                        <span class="radio"></span>
                                        EN
                                    </label>
                                    <button class="btn-download" data-bs-toggle="modal" data-bs-target="#downloadModal" title="Tải báo cáo">
                                        <i class="fas fa-download"></i> Tải về
                                    </button>
                                </div>

                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Xếp hạng công cụ nợ -->
            <div class="ranking-block">
                <h2 class="ranking-title">Xếp hạng Công cụ nợ</h2>
                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>Mã trái phiếu</th>
                            <th style="width: 165px;">Loại ý kiến</th>
                            <th style="width: 100px;">Ngày</th>
                            <th>Kết quả xếp hạng</th>
                            <th>Báo cáo Xếp hạng Tín nhiệm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="no-data">
                                Hiện tại tổ chức phát hành chưa thực hiện xếp hạng
                                tín nhiệm đối với công cụ nợ
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Xác nhận tài chính bền vững -->
            <div class="ranking-block">
                <h2 class="ranking-title">Xác nhận Tài chính Bền vững</h2>
                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>Loại ý kiến</th>
                            <th>Ngày</th>
                            <th>Chuẩn mực áp dụng</th>
                            <th>Báo cáo chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="4" class="no-data">
                                Hiện tại tổ chức phát hành chưa thực hiện xếp hạng
                                tín nhiệm đối với công cụ nợ
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="ranking-right">
            <h3 class="points-title">Điểm XHTN của các công ty cùng ngành khác</h3>
            <!-- <button class="points-tab active">Ngân hàng</button> -->

            <div class="points-list">
                <div class="points-item">
                    <p>FiinRatings công bố xếp hạng tín nhiệm Ngân hàng ACB ở mức <b>AA+</b></p>
                </div>
                <div class="points-item">
                    <p>
                        FiinRatings công bố xếp hạng tín nhiệm Ngân hàng thương mại cổ phần Kỹ thương Việt Nam
                        (Techcombank ở mức “<b>A+</b>” với triển vọng “Ổn đinh”.)
                    </p>
                </div>
                <div class="points-item">
                    <p>
                        FiinRatings công bố xếp hạng tín nhiệm Ngân hàng thương mại cổ phần Kỹ thương Việt Nam
                        (Techcombank ở mức “<b>A+</b>” với triển vọng “Ổn đinh”.)
                    </p>
                </div>
            </div>

            <div class="pt-5">
                <a href="#" class="show-more">Tham khảo thêm <i class="fa fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>
<section id="RatingCharts" class="py-5">
    <style>
        #RatingCharts {
            background: #ffffff;
            color: #093461;
        }

        .rating-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .chart-box {
            background: white;
            border-radius: 12px;
            padding: 20px 25px;
            /* box-shadow: 0 2px 10px rgba(0, 76, 152, 0.05); */
        }

        .chart-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .chart-filters {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        .filter-select,
        .filter-date {
            border: 1px solid #d5e4ff;
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 14px;
            color: #093461;
            outline: none;
            width: 50%;
        }

            .filter-select:focus,
            .filter-date:focus {
                border-color: #0066cc;
            }

        .chart-legend {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 10px;
            font-size: 14px;
            color: #093461;
            flex-wrap: wrap;
        }

        .legend-square {
            width: 14px;
            height: 14px;
            border-radius: 3px;
            display: inline-block;
            margin-right: 6px;
        }

            .legend-square.blue {
                background-color: #0066cc;
            }

            .legend-square.dark {
                background-color: #002d72;
            }

        .chart-img {
            padding: 20px 0;
        }
    </style>
    <div class="container">
        <div class="rating-grid">
            <!-- Xếp hạng dài hạn -->
            <div class="chart-box">
                <h3 class="chart-title">Xếp hạng dài hạn</h3>

                <div class="chart-filters">
                    <select class="filter-select">
                        <option>Loại xếp hạng</option>
                        <option>Tổ chức phát hành</option>
                        <option>Công cụ nợ</option>
                    </select>
                    <input type="date" class="filter-date">
                </div>
                <img src="/Data/FR/chart-long.png" class="chart-img d-block w-100" alt="chart-long">
                <!-- <div id="longTermChart"></div> -->

                <div class="chart-legend">
                    <span><i class="legend-square blue"></i> Xếp hạng Tổ chức phát hành</span>
                    <span><i class="legend-square dark"></i> Xếp hạng Công cụ nợ</span>
                </div>
            </div>

            <!-- Xếp hạng ngắn hạn -->
            <div class="chart-box">
                <h3 class="chart-title">Xếp hạng ngắn hạn</h3>

                <div class="chart-filters">
                    <select class="filter-select">
                        <option>Loại xếp hạng</option>
                        <option>Tổ chức phát hành</option>
                        <option>Công cụ nợ</option>
                    </select>
                    <input type="date" class="filter-date">
                </div>
                <img src="/Data/FR/chart-short.png" class="chart-img d-block w-100" alt="chart-short">

                <!-- <div id="shortTermChart"></div> -->

                <div class="chart-legend">
                    <span><i class="legend-square blue"></i> Xếp hạng Tổ chức phát hành</span>
                    <span><i class="legend-square dark"></i> Xếp hạng Công cụ nợ</span>
                </div>
            </div>
        </div>
    </div>
</section>

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRAboutUsLienHe", language = language, portalId = portalId })