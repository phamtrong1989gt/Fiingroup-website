                                </p>
                            </div>

                            <div class="info-item">
                                <p class="label">@Localizer["Outlook"]</p>
                                <p class="value status" id="detail_Rating">
                                    <span class="skeleton-text" style="display:inline-block;width=100px;height=20px;"></span>
                                </p>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-item">
                                <p class="label">@Localizer["OpinionType"]</p>
                                <p class="value" id="detail_OpinionType_lyk">
                                    <span class="skeleton-text" style="display:inline-block;width=140px;height=20px;"></span>
                                </p>
                            </div>
                            <div class="info-item">
                                <p class="label">@Localizer["PublicationDate"]</p>
                                <p class="value" id="detail_PublicationDate">
                                    <span class="skeleton-text" style="display:inline-block;width=100px;height=20px;"></span>
                                </p>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-item mb-0">
                                <p class="label">@Localizer["BondCode"]</p>
                                <p class="value" id="detail_BondCode">
                                    <span class="skeleton-text" style="display:inline-block;width=140px;height=20px;"></span>
                                </p>
                            </div>
                            <div class="info-item">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ranking-grid mt-5">
                    <!-- CỘT TRÁI -->
                    <div class="ranking-left">
                        <!-- Xếp hạng tổ chức phát hành -->
                        <div class="ranking-block">
                            <h2 class="ranking-title">@Localizer["RankingOfIssuingOrganizations"]</h2>
                            <div class="table-responsive">
                                <table class="ranking-table">
                                    <thead>
                                        <tr>
                                            <th>@Localizer["PublicationDate"]</th>
                                            <th style="width: 189px;">@Localizer["OpinionType"]</th>
                                            <th>@Localizer["RatingScore"]</th>
                                            <th>@Localizer["Outlook"]</th>
                                            <th>@Localizer["Report"]</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bindTTPH"></tbody>
                                </table>
                            </div>
                        

                        </div>

                        <!-- Xếp hạng công cụ nợ -->
                        <div class="ranking-block">
                            <h2 class="ranking-title">@Localizer["RankingOfDebtInstruments"]</h2>
                            <div class="table-responsive">
                                <table class="ranking-table">
                                    <thead>
                                        <tr>
                                            <th>@Localizer["PublicationDate"]</th>
                                            <th>@Localizer["BondCode"]</th>
                                            <th>@Localizer["OpinionType"]</th>
                                            <th>@Localizer["RatingScore"]</th>
                                            <th>@Localizer["Report"]</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bindTTPHDebit">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Xác nhận tài chính bền vững -->
                        <div class="ranking-block">
                            <h2 class="ranking-title">@Localizer["SustainableFinanceConfirmation"]</h2>
                            <div class="table-responsive">
                                <table class="ranking-table">
                                    <thead>
                                        <tr>
                                            <th>@Localizer["PublicationDate"]</th>
                                            <th>@Localizer["Announcement"]</th>
                                            <th>@Localizer["ApplicablePrinciples"]</th>
                                            <th>@Localizer["Report2"]</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bindSustainableFinance"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="rating-grid mt-5 mb-5">
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Xếp hạng dài hạn -->
                            <div class="chart-box">
                                <h3 class="chart-title">@Localizer["ChartLong_Title"]</h3>
                                <select id="longFilterSelect" class="filter-select" style="width:100%; margin-bottom:5px;">
                                    <option selected value="1">@Localizer["Filter_TypeIssuer"]</option>
                                    <option value="2">@Localizer["Filter_TypeDebtInstrument"]</option>
                                </select>
                                <div class="chart-filters">
                                    <div style="position: relative; width: 50%;">
                                        <input type="text" name="dhStartDate" class="dhStartDate form-control form-control-sm" placeholder="@Localizer["StartDate_Placeholder"]" readonly>
                                        <i class="fa fa-calendar calendar-icon" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #034ea2;"></i>
                                    </div>
                                    <div style="position: relative; width: 50%;">
                                        <input type="text" name="dhEndDate" class="dhEndDate form-control form-control-sm" placeholder="@Localizer["EndDate_Placeholder"]" readonly>
                                        <i class="fa fa-calendar calendar-icon" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #034ea2;"></i>
                                    </div>
                                </div>
                                
                                <!-- Loading Spinner -->
                                <div id="longChartLoading" class="chart-loading" style="display:none;">
                                    <div class="spinner-border" role="status"></div>
                                </div>
                                
                                <div style="height: 400px; position: relative;">
                                    <canvas id="longTermChart" class="chart-img d-block w-100" aria-label="@Localizer["Img_Alt_Long"]" role="img"></canvas>
                                </div>

                                <div class="chart-legend">
                                    <span><i class="legend-square blue"></i> @Localizer["Legend_Issuer"]</span>
                                    <span><i class="legend-square dark"></i> @Localizer["Legend_DebtInstrument"]</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Xếp hạng ngắn hạn -->
                            <div class="chart-box">
                                <h3 class="chart-title">@Localizer["ChartShort_Title"]</h3>
                                <select id="shortFilterSelect" class="filter-select" style="width:100%; margin-bottom:5px;" >
                                    <option selected value="1">@Localizer["Filter_TypeIssuer"]</option>
                                    <option value="2">@Localizer["Filter_TypeDebtInstrument"]</option>
                                </select>
                                <div class="chart-filters">
                                    <div style="position: relative; width: 50%;">
                                        <input type="text" name="nhStartDate" class="nhStartDate form-control form-control-sm" placeholder="@Localizer["StartDate_Placeholder"]" readonly>
                                        <i class="fa fa-calendar calendar-icon" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #034ea2;"></i>
                                    </div>
                                    <div style="position: relative; width: 50%;">
                                        <input type="text" name="nhEndDate" class="nhEndDate form-control form-control-sm" placeholder="@Localizer["EndDate_Placeholder"]" readonly>
                                        <i class="fa fa-calendar calendar-icon" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #034ea2;"></i>
                                    </div>
                                </div>
                                
                                <!-- Loading Spinner -->
                                <div id="shortChartLoading" class="chart-loading" style="display:none;">
                                    <div class="spinner-border" role="status"></div>
                                </div>
                                
                                <div style="height: 400px; position: relative;">
                                </div>

                                <div class="chart-legend">
                                    <span><i class="legend-square blue"></i> @Localizer["Legend_Issuer"]</span>
                                    <span><i class="legend-square dark"></i> @Localizer["Legend_DebtInstrument"]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div id="topNewsContainer"></div>
                <div class="mb-5"></div>
                <div id="topNewsContainer1"></div>
            </div>
        </div>
    </div>
</section>

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRAboutUsLienHe", language = language, portalId = portalId })
@section Scripts {
    <script src="~/plugins/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <link href="~/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.min.css" rel="stylesheet" />
    <script src="~/plugins/bootstrap-datepicker/locales/bootstrap-datepicker.en-au.min.js"></script>
    <script src="~/plugins/bootstrap-datepicker/locales/bootstrap-datepicker.vi.min.js"></script>
    <script src="~/plugins/chart.umd.min.js"></script>
    <script>
        // ============================================
        // CHART INITIALIZATION
        // ============================================
        $(function(){
            var lang = '@language';
            window.scoreMap = window.scoreMap || {};
            window.longTermChart = null;
            window.shortTermChart = null;
            
            window.formatDateForApi = function(d) {
                if (!d) return '';
                var year = d.getFullYear();
                var month = String(d.getMonth() + 1).padStart(2, '0');
                var day = String(d.getDate()).padStart(2, '0');
                return year + '-' + month + '-' + day;
            };
            
            var defaultStartDate = new Date(2020, 0, 1);
            var defaultEndDate = new Date();

            // Initialize LONG TERM datepickers WITHOUT event handlers
            $('.dhStartDate').datepicker({
                format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                language: lang,
                todayHighlight: true,
                autoclose: true
            });

            $('.dhEndDate').datepicker({
                format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                language: lang,
                todayHighlight: true,
                autoclose: true
            });

            // Initialize SHORT TERM datepickers WITHOUT event handlers
            $('.nhStartDate').datepicker({
                format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                language: lang,
                todayHighlight: true,
                autoclose: true
            });

            $('.nhEndDate').datepicker({
                format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                language: lang,
                todayHighlight: true,
                autoclose: true
            });

            // Set defaults for LONG TERM
            try {
                if (!$('.dhStartDate').val()) {
                    $('.dhStartDate').datepicker('setDate', defaultStartDate);
                }
                if (!$('.dhEndDate').val()) {
                    $('.dhEndDate').datepicker('setDate', defaultEndDate);
                }
            } catch (ex) {
                console.warn('Long term datepicker set default failed', ex);
            }

            // Set defaults for SHORT TERM
            try {
                if (!$('.nhStartDate').val()) {
                    $('.nhStartDate').datepicker('setDate', defaultStartDate);
                }
                if (!$('.nhEndDate').val()) {
                    $('.nhEndDate').datepicker('setDate', defaultEndDate);
                }
            } catch (ex) {
                console.warn('Short term datepicker set default failed', ex);
            }

            // NOW add event handlers AFTER setting defaults - LONG TERM
            $('.dhStartDate').on('changeDate', function() {
                loadLongTermChart();
            });

            $('.dhEndDate').on('changeDate', function() {
                loadLongTermChart();
            });

            // Handle calendar icon clicks - LONG TERM
            $('.dhStartDate').siblings('.calendar-icon').on('click', function() {
                $('.dhStartDate').datepicker('show');
            });

            $('.dhEndDate').siblings('.calendar-icon').on('click', function() {
                $('.dhEndDate').datepicker('show');
            });

            // NOW add event handlers AFTER setting defaults - SHORT TERM
            $('.nhStartDate').on('changeDate', function() {
                // loadShortTermChart(); // Uncomment when API ready
            });

            $('.nhEndDate').on('changeDate', function() {
                // loadShortTermChart(); // Uncomment when API ready
            });

            // Handle calendar icon clicks - SHORT TERM
            $('.nhStartDate').siblings('.calendar-icon').on('click', function() {
                $('.nhStartDate').datepicker('show');
            });

            $('.nhEndDate').siblings('.calendar-icon').on('click', function() {
                $('.nhEndDate').datepicker('show');
            });

            // Bind filter change
            $('#longFilterSelect').on('change', function() {
                loadLongTermChart();
            });

            // Initialize chart
            loadLongTermChart();
        });

        // Build score map
        function buildScoreMap(scores) {
            if (!scores || !Array.isArray(scores)) return {};
            
            var map = {};
            scores.forEach(function(item) {
                map[item.scoreValue] = item.value;
            });
            
            window.scoreMap = map;
            return map;
        }

        // Get numeric score
        function getNumericScore(scoreValue) {
            return window.scoreMap[scoreValue] || null;
        }

        // Show loading
        function showChartLoading(chartId) {
            if (chartId === 'longTermChart') {
                $('#longChartLoading').show();
                $('#longTermChart').css('opacity', '0.3');
            }
        }

        // Hide loading
        function hideChartLoading(chartId) {
            if (chartId === 'longTermChart') {
                $('#longChartLoading').hide();
                $('#longTermChart').css('opacity', '1');
            }
        }

        // Load long term chart
        function loadLongTermChart() {
            console.log('[Long Term] Loading chart...');
            var start = $('.dhStartDate').datepicker('getDate') || new Date(2020, 0, 1);
            var end = $('.dhEndDate').datepicker('getDate') || new Date();
            if (start > end) { var t = start; start = end; end = t; }
            var type = $('#longFilterSelect').val() || '1';
            
            // Show loading
            showChartLoading('longTermChart');
            
            // Call API
            var chartDataUrl = '/@(language)/Ratings/ChartData';
            var params = {
                organizationId: '@ViewBag.Id',
                lang: '@language',
                type: type,
                fromDate: window.formatDateForApi(start),
                toDate: window.formatDateForApi(end)
            };

            $.ajax({
                url: chartDataUrl,
                method: 'GET',
                data: params,
                dataType: 'json'
            })
            .done(function(apiData) {
                console.log('[Long Term] API data received:', apiData);
                
                if (apiData && apiData.scores) {
                    buildScoreMap(apiData.scores);
                }
                
                if (apiData && apiData.data) {
                    renderChart('longTermChart', apiData.data, 'Long Term Rating');
                } else {
                    console.warn('[Long Term] No data received');
                    renderChart('longTermChart', [], 'Long Term Rating');
                }
            })
            .fail(function(xhr, status, error) {
                console.error('[Long Term] Failed to load chart:', error);
                renderChart('longTermChart', [], 'Long Term Rating');
            })
            .always(function() {
                // Always hide loading
                hideChartLoading('longTermChart');
            });
        }

        // Render chart
        function renderChart(canvasId, data, label) {
            try {
                var labels = [];
                var values = [];
                var stringValues = [];

                if (data && Array.isArray(data) && data.length > 0) {
                    data.forEach(function(item) {
                        labels.push(item.label);
                        var numericValue = getNumericScore(item.value);
                        values.push(numericValue);
                        stringValues.push(item.value);
                    });
                }

                console.log('[renderChart] Preparing:', canvasId, labels, values);

                var ctx = document.getElementById(canvasId);
                if (!ctx) {
                    console.error('[renderChart] Canvas not found:', canvasId);
                    return;
                }
                ctx = ctx.getContext('2d');

                // Destroy existing chart
                if (canvasId === 'longTermChart' && window.longTermChart) {
                    window.longTermChart.destroy();
                }

                // Create reverse scoreMap
                var reverseScoreMap = {};
                Object.keys(window.scoreMap).forEach(function(key) {
                    reverseScoreMap[window.scoreMap[key]] = key;
                });

                // Get min/max scores
                var allScoreValues = Object.values(window.scoreMap);
                var minScore = Math.min.apply(null, allScoreValues);
                var maxScore = Math.max.apply(null, allScoreValues);

                // Create chart
                var chartConfig = {
                    type: 'line',
                    data: {
                        labels: labels.length > 0 ? labels : [''],
                        datasets: [{
                            label: label,
                            data: values,
                            borderColor: '#0066cc',
                            backgroundColor: 'rgba(0, 102, 204, 0.1)',
                            borderWidth: 2,
                            pointRadius: 4,
                            pointBackgroundColor: '#0066cc',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointHoverRadius: 6,
                            tension: 0.1,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: values.length > 0,
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                titleFont: {
                                    size: 14,
                                    weight: 'bold'
                                },
                                bodyFont: {
                                    size: 13
                                },
                                callbacks: {
                                    label: function(context) {
                                        var index = context.dataIndex;
                                        var rating = stringValues[index];
                                        return label + ': ' + rating;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    font: {
                                        size: 11
                                    },
                                    maxRotation: 45,
                                    minRotation: 0
                                }
                            },
                            y: {
                                reverse: true,
                                min: minScore,
                                max: maxScore,
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                },
                                ticks: {
                                    font: {
                                        size: 11
                                    },
                                    callback: function(value) {
                                        return reverseScoreMap[value] || '';
                                    },
                                    stepSize: 1,
                                    autoSkip: false
                                }
                            }
                        }
                    }
                };

                var chart = new Chart(ctx, chartConfig);
                
                if (canvasId === 'longTermChart') {
                    window.longTermChart = chart;
                }

                console.log('[renderChart] Chart created successfully:', canvasId);

            } catch (error) {
                console.error('[renderChart] Error:', error);
            }
        }

