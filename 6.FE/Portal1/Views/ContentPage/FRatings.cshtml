@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRAboutUsLienHe", language = language, portalId = portalId })
@section Scripts {
    <script src="~/plugins/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <link href="~/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.min.css" rel="stylesheet" />
    <script src="~/plugins/bootstrap-datepicker/locales/bootstrap-datepicker.en-au.min.js"></script>
    <script src="~/plugins/bootstrap-datepicker/locales/bootstrap-datepicker.vi.min.js"></script>
    <script src="~/plugins/chart.umd.min.js"></script>
    <script>
        $(function(){
                var lang = '@language';
                $('.dhStartDate').datepicker({
                    format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                    language: lang,
                    todayHighlight: true
                });

                $('.dhEndDate').datepicker({
                    format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                    language: lang,
                    todayHighlight: true
                });

                $('.nhStartDate').datepicker({
                    format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                    language: lang,
                    todayHighlight: true
                });

                $('.nhEndDate').datepicker({
                    format: lang == "vi" ? "dd/mm/yyyy" : "mm/dd/yyyy",
                    language: lang,
                    todayHighlight: true
                });
        });
        function showRatingInfoPopup(element) {
            var rating = $(element).data('rating');
            var issuer = $(element).data('issuer');
            // Update modal header with company name and rating
            $('#modal-issuer').text(issuer);
            $('#modal-rating').text(rating);
            // Show modal
            $('#ratingInfoModal').fadeIn(300);
        }

        function loadTopNews(containerId, url) {
            $(containerId).html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'html',
                success: function (response) {
                    console.log('Response received successfully');
                    $(containerId).html(response);
                },
                error: function (xhr, status, error) {
                    console.error('Error details:', {
                        status: xhr.status,
                        statusText: xhr.statusText,
                        responseText: xhr.responseText,
                        error: error
                    });
                    $(containerId).html('<div class="alert alert-danger">Không thể tải tin tức. Status: ' + xhr.status + '</div>');
                }
            });
        }
         $(".company-title").html('@cname');
        // ============================================
        // BIND DETAIL DATA TO COMPANY INFO BOX
        // ============================================
        window.bindDetail = function(data) {
            try {
                if (!data) {
                    $(".company-info-box").addClass('d-none');
                    $(".company-title").html('@cname');
                    return;
                }
                else
                {
                    $(".company-info-box").removeClass('d-none');
                }

                // Map fields to DOM elements
                const mappings = {
                    'detail_IssuingOrganization': data.IssuingOrganization || data.issuingOrganization || '---',
                    'detail_OrganizationType': '---', // Placeholder - add actual field if available
                    'detail_RatingScore': data.RatingScore || data.ratingScore || '---',
                    'detail_Industry': data.Industry || data.industry || '---',
                    'detail_Rating': data.Rating || data.rating || data.Prospects || data.prospects || '---',
                    'detail_OpinionType': data.OpinionType || data.opinionType || '---',
                    'detail_PublicationDate': data.PublicationDate || data.publicationDate || '---',
                    'detail_OpinionType_lyk': data.OpinionTypeName || data.opinionTypeName || '---',
                    'detail_BondCode': data.BondCode || data.bondCode || '---'
                };

                // Bind data to elements with animation
                Object.keys(mappings).forEach(function(id) {
                    const $element = $('#' + id);
                    const value = mappings[id];

                    if ($element.length) {
                        // ✅ FADE OUT skeleton, then FADE IN content
                        const $skeleton = $element.find('.skeleton-text');

                        if ($skeleton.length) {
                            // Fade out skeleton
                            $skeleton.fadeOut(200, function() {
                                $skeleton.remove();

                                // Set text content
                                if (id.includes('Date') && value !== '---') {
                                    const formattedDate = formatDate(value);
                                    $element.text(formattedDate);
                                } else {
                                    $element.text(value);
                                }

                                // Add fade-in + highlight animation
                                $element.addClass('fade-in-content highlight-update');

                                setTimeout(function() {
                                    $element.removeClass('highlight-update');
                                }, 1000);

                                setTimeout(function() {
                                    $element.removeClass('fade-in-content');
                                }, 500);
                            });
                        } else {
                            // No skeleton, just update text
                            if (id.includes('Date') && value !== '---') {
                                const formattedDate = formatDate(value);
                                $element.text(formattedDate);
                            } else {
                                $element.text(value);
                            }
                        }
                    } else {
                        console.warn('[bindDetail] Element not found:', id);
                    }
                });

                console.log('[bindDetail] Data binding completed');
            } catch (error) {
                console.error('[bindDetail] Error:', error);
            }
        };

        // Helper function to format date
        function formatDate(dateString) {
            if (!dateString || dateString === '---') return '---';

            try {
                // Try to parse date
                const date = new Date(dateString);
                if (isNaN(date.getTime())) return dateString;

                // Format as DD/MM/YYYY
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();

                return `${day}/${month}/${year}`;
            } catch (error) {
                console.error('[formatDate] Error:', error);
                return dateString;
            }
        }

