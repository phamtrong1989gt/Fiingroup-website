                            <td><div class="skeleton skeleton-cell"></div></td>
                            <td><div class="skeleton skeleton-cell"></div></td>
                            <td><div class="skeleton skeleton-cell"></div></td>
                            <td><div class="skeleton skeleton-cell"></div></td>
                        </tr>
                    `).join('')}
                `);

                $.get(sustainableAjaxUrl, params)
                    .done(function(html) {
                        console.log('[Sustainable Finance] Data loaded successfully');
                        $('#bindSustainableFinance').html(html);
                    })
                    .fail(function(xhr, status, error) {
                        console.error('[Sustainable Finance] Error:', {
