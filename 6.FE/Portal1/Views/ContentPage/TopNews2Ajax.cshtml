@model PT.Domain.Model.NewsListResponse
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Options
@using PT.Domain.Model
@using PT.Shared;
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;

@{
	Layout = null;
	string language = ViewData["language"]?.ToString();
	var param =  (Parameter)ViewData["param"];
}

@if (Model != null && param != null && Model.Items.Count > 0)
{
    var firstItem = Model.Items.FirstOrDefault();
    string firstrl = $"/{language}/news-fg/{firstItem.FriendlyTitle}-id{firstItem.Id}.html".ToLower();

    <div class="container">
        <h2 class="price-title mb-5">@param.Title</h2>
        <div class="thinks-grid">
            <div class="thinks-featured">
                <img loading="lazy" class="news-img" onerror="this.onerror=null;this.src='/Data/Banner/news.jpg';" src="@(firstItem.ImageUrl ?? "/Data/Banner/news.jpg")" alt="@firstItem.Title">
                <div class="thinks-info">
                    <h3 class="thinks-title">
                        @firstItem.Title
                    </h3>
                @*     <p class="thinks-desc">
                        @firstItem.ShortContent
                    </p> *@
                    <a href="@firstrl" class="show-more">
                        @param.LinkViewName <i class="fa fa-long-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
            <div class="thinks-list">
                @foreach (var item in Model.Items.Where(x => x.Id != firstItem.Id))
                {
                    <div class="thinks-item">
                        <img loading="lazy" class="news-img" onerror="this.onerror=null;this.src='/Data/Banner/news.jpg';" src="@(item.ImageUrl ?? "/Data/Banner/news.jpg")" alt="@item.Title">
                        <div class="thinks-content">
                            <div>
                                <a href="@firstrl" class="news-title">
                                    @item.Title
                                </a>
                            </div>
                            <div class="mt-2">
                                <a href="@firstrl" class="show-more">
                                    @param.LinkViewName <i class="fa fa-long-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="think-now-wrapper">
            <a href="@param.Link" class="think-now">
                <span>@param.LinkName</span>
            </a>
        </div>
    </div>
}

