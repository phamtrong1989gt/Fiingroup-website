@model PT.Domain.Model.Category
@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Options
@using PT.Domain.Model
@using PT.Shared;
@using PT.UI.Models
@inject IOptions<BaseSettings> _baseSettings;
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@inject PT.Infrastructure.Interfaces.ICategoryRepository _iCategoryRepository;
@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = _baseSettings.Value.PortalId;
}

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.PhotoSlide, code = "FRRakingSliderBanner2", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRRakingMenuButton2", language = language, portalId = portalId })
<link asp-append-version="true" href="~/assets/css/views/ratings2.index.css" rel="stylesheet" />

<section id="Find">
    <div class="container">
        <div class="box-find-top">
            <div class="find-top">
                <input type="text" id="companyName" name="companyName" placeholder="@Localizer["CompanyNamePlaceholder"]" class="find-input">

                <input type="text" id="title" name="title" placeholder="@Localizer["ReportName"]" class="find-input">

                <button class="btn-filter" type="button">
                    <i class="fa fa-expand"></i>
                </button>

                <select id="industryId" name="industryId" class="find-input custom-dropdown-select" asp-items="ViewBag.Industries">
                    <option value="">@Localizer["AllIndustries"]</option>
                </select>

                <select id="applicableStandardId" name="applicableStandardId" class="find-input custom-dropdown-select" asp-items="ViewBag.SustainableLevels">
                    <option value="">@Localizer["AllSustainableLevels"]</option>
                </select>

                <span class="refresh" title="@Localizer["RefreshTitle"]"><i class="fa fa-undo"></i></span>

                <button class="find-button" id="btn-search" type="button">
                    <i id="icon-search" class="fa fa-search"></i>
                    <span id="rating-loading" class="loader d-none"></span>
                    @Localizer["SearchButton"]
                </button>
            </div>
        </div>
    </div>
</section>

<section id="TableRank" class="pt-4">
    <div class="container">
        <div class="table-responsive">
            <table class="TableRank">
                <thead class="head-table">
                    <tr>
                        <th style="width: 150px;">@Localizer["PublicationDate"]</th>
                        <th>@Localizer["Publisher"]</th>
                        <th>@Localizer["Title"]</th>
                        <th>@Localizer["Industry"]</th>
                        <th>@Localizer["SustainabilityLevel"]</th>
                        <th style="width: 235px;">@Localizer["Report"]</th>
                    </tr>
                </thead>
                <tbody class="body-table" id="content-bind">
                </tbody>
            </table>
        </div>
    </div>
</section>

<partial name="~/Views/Home/_Register.cshtml" model="@(new ContactHomeModel { })" />

@section Scripts {
    <script asp-append-version="true" src="~/assets/css/views/ratings2.index.js"></script>
    <script>
        var rakingsAjaxUrl = '@Url.Action("IndexAjax", "Ratings2", new { language = language })';
        var currentLanguage = '@language';
        var filterOpen = false;
        var errorLoadingDataMsg = '@Localizer["ErrorLoadingData"]';
        var reportNotAvailableMsg = '@Localizer["ReportNotAvailable"]';
    </script>
}