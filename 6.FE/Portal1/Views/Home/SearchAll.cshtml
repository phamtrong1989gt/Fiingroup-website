@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using PT.Domain.Model;
@using PT.Infrastructure.Interfaces;
@using PT.Shared;
@inject IViewLocalizer Localizer;
@using System.Linq.Expressions;
@using PT.UI.Models
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@inject IOptions<BaseSettings> _baseSettings;

@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = _baseSettings.Value.PortalId;
    var queryKey = Context.Request.Query["key"].ToString();
}

<style>
    #Banner {
        background: url(/Data/Banner/news-bg.jpg) no-repeat top;
        background-size: cover;
        height: 350px;
    }

        #Banner h1 {
            font-style: normal;
            font-weight: 700;
            font-size: 50px;
            /* line-height: 190%; */
            text-align: center;
            padding: 100px;
        }


    #search #search-input {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 12px;
        gap: 10px;
        height: 38px;
        background: #FFFFFF;
        border: 1px solid #034EA2;
        border-radius: 4px;
    }

    #search {
        position: relative;
        font-size: 18px;
        width: 90%;
    }

        #search label {
            position: absolute;
            right: 8px;
            top: 6px;
            color: #034EA2;
        }


    .mr-2 {
        margin: 0 1rem 0 0;
    }

    .btn-search {
        width: 120px;
        height: 40px;
        background: #0066CC;
        border-radius: 200px;
    }


    @@media (max-width: 768px) {
        #Banner {
            height: 200px;
        }

            #Banner h1 {
                font-size: 24px;
                padding: 50px;
            }

        .btn-search {
            width: auto;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 20px;
            flex-shrink: 0;
        }

        .narbartrust {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            gap: 15px;
            padding: 15px 5px;
            scrollbar-width: none;
        }

            .narbartrust::-webkit-scrollbar {
                display: none;
            }

            .narbartrust a {
                flex: 0 0 auto;
                white-space: nowrap;
                font-size: 15px;
                padding: 8px 10px;
                border-bottom-width: 2px;
            }

        .page-table {
            flex-direction: column;
            row-gap: 18px;
        }

            .page-table .numberpage {
                line-height: 20px;
            }
    }

    .rating-card {
        border-radius: 14px;
        padding: 22px 0;
        margin-bottom: 20px;
        border: 1px solid transparent;
        background-image: linear-gradient(#fff, #fff), linear-gradient(to right, #0018A8, #166BF2, #3B7EEE);
        background-origin: border-box;
        background-clip: padding-box, border-box;
        width:100%;
    }

    .rating-left {
        width: 100%;
        padding-left: 20px;
        padding-right: 20px;
    }

    .rating-right {
        width: 45%;
    }

    .rating-header {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .rating-badge {
        width: 60px;
        height: 60px;
        border-radius: 10px;
        font-size: 22px;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rating-a {
        background: #F5F9FF;
        color: #0066cc;
        border: 1px solid #0066cc;
    }

    .rating-b {
        background: #F3FBF8;
        color: #12B76A;
        border: 1px solid #12B76A;
    }

    .rating-top-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .rating-date {
        background: #E9F4FF;
        color: #0B66C3;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        width: fit-content;
    }

    .rating-company {
        font-size: 18px;
        font-weight: 600;
        color: #093461;
    }

    .rating-info {
        margin-top: 18px;
        display: flex;
        justify-content: space-between;
        gap: 40px;
    }

    .info-label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        color: #093461;
    }

    .info-value {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #0066CC;
    }

    .status-tag {
        background: #E7F3FF;
        color: #0066CC;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 13px;
    }

    .btn-report {
        background: #0A6CDE;
        color: white;
        padding: 8px 18px;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 600;
        float: right;
    }


    .narbartrust {
        padding: 50px 0;
        display: flex;
        justify-content: space-around;
        align-items: center;
    }

        .narbartrust a {
            color: #093461;
            text-decoration: none;
            font-size: 18px;
            padding: 8px 10px;
            display: flex;
            justify-content: center;
            min-width: 20%;
            transition: color 0.3s, border-bottom 0.3s;
            cursor: pointer;
            border-bottom: 3px solid transparent;
        }

            .narbartrust a.active,
            .narbartrust a:hover {
                color: #0066CC;
                border-bottom: 3px solid #093461;
            }


    .news-title {
        font-weight: 700;
        font-size: 20px;
        height: 102px;
        line-height: 120%;
        display: flex;
        align-items: center;
        color: #1D2939;
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;
        overflow: hidden;
    }



    .page-table {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        font-size: 16px;
    }

    .numberpage {
        margin-right: 20px;
    }

        .pagination .active {
            padding: 5px 14px;
            border: 1px solid #4d94dc;
            border-radius: 5px;
            background: #fff;
            cursor: pointer;
            color: #1f78d3;
        }

    @@media (max-width: 768px) {

        .rating-card {
            padding: 18px;
            display: block;
        }

        .rating-left,
        .rating-right {
            width: 100% !important;
            padding-right:20px;
        }

        .rating-header {
            flex-direction: row;
            align-items: center;
            gap: 14px;
        }

        .rating-badge {
            width: 50px;
            height: 50px;
            font-size: 20px;
        }

        .rating-top-info .rating-company {
            font-size: 16px;
        }

        .rating-top-info .rating-date {
            font-size: 13px;
            padding: 5px 12px;
        }

        .rating-info {
            flex-direction: column;
            gap: 14px;
            margin-top: 14px;
        }
        /* Button */
        .btn-report {
            float: none;
            display: inline-block;
            margin-top: 18px;
            font-size: 14px;
            padding: 10px 20px;
            border-radius: 22px;
            align-self: flex-end;
        }

        .rating-right {
            display: flex;
            justify-content: flex-end;
        }
    }

    .issuer-card {
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
        border: 1px solid transparent;
        background-image: linear-gradient(#fff, #fff), linear-gradient(to right, #0018A8, #166BF2, #3B7EEE);
        background-origin: border-box;
        background-clip: padding-box, border-box;
    }

    .issuer-left {
        width: 100%;
    }
  
    .issuer-header {
        display: flex;
        align-items: center;
        gap: 20px;
        justify-content: space-between;
    }

    .issuer-badge {
        border-radius: 10px;
        font-size: 22px;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .issuer-a {
        background: #F5F9FF;
        color: #0066cc;
        border: 1px solid #0066cc;
    }

    .issuer-b {
        background: #F3FBF8;
        color: #12B76A;
        border: 1px solid #12B76A;
    }

    .issuer-top-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .issuer-date {
        background: #E9F4FF;
        color: #0B66C3;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        width: fit-content;
    }

    .issuer-company {
        font-size: 18px;
        font-weight: 600;
        color: #093461;
    }

    .issuer-info {
        font-size: 14px;
        color: #093461;
    }

    @@media (max-width: 768px) {

        .issuer-card {
            padding: 18px;
            display: block;
        }

        .issuer-left,
        .issuer-right {
            width: 100% !important;
        }

        .issuer-header {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .issuer-badge img {
            width: 50px;
            height: 50px;
            object-fit: contain;
        }

        .issuer-top-info .issuer-company {
            font-size: 16px;
        }

        .issuer-top-info .issuer-date {
            font-size: 13px;
            padding: 5px 12px;
        }

        .issuer-info {
            font-size: 13px;
        }

        .issuer-right {
            margin-top: 16px;
            display: flex;
            justify-content: flex-end;
        }
    }

    .news-title {
        display: block;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #1d2939;
        font-size: 20px;
        line-height: 30px;
        max-height: calc(30px * 3);
        word-break: break-word;
        font-weight: 600;
    }
    .news-img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: center;
        border-radius: 12px;
        border: 1px solid #eee;
    }

    .show-more {
        color: #034ea2;
    }

    .show-more {
        color: var(--primary-color);
        font-weight: 600;
    }
</style>

<section id="Banner">
    <div class="container">
        <div class="row">
            <h1 class="text-white mb-5 mt-5">
                @Localizer["SearchResultsTitle"]
            </h1>
        </div>
    </div>
</section>
<section id="Result">

    <div class="container">
        <div class="d-flex justify-content-between mt-5">
            <section id="search" class="mr-2">
                <input id="search-input" class="form-control input-lg" placeholder="@Localizer["SearchPlaceholder"]" autocomplete="off" spellcheck="false" autocorrect="off" tabindex="1">
                <label for="search-input"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">@Localizer["SearchPlaceholder"]</span></label>
            </section>
            <button type="button" onclick="onSearch()" class="btn btn-primary btn-search">@Localizer["SearchButton"]</button>
        </div>

        <div class="narbartrust">
            <a href="#Nav_Ratings" class="active">@Localizer["Nav_Ratings"]</a>
            <a href="#Nav_PublicationsReports" class="">@Localizer["Nav_PublicationsReports"]</a>
            <a href="#Nav_NewsEvents" class="">@Localizer["Nav_NewsEvents"]</a>
        </div>
        <div id="Nav_Ratings">
            @* <p id="search-info"></p> *@
            <h2 class="price-title mb-4">@Localizer["RatingsHeading"]</h2>
            <div id="bindRatingContent"></div>
            <div class="pb-5"></div>
            <h2 class="price-title mb-4">@Localizer["IssuerHeading"]</h2>
            <div id="bindIssuerContent"></div>
        </div>
        <div id="Nav_PublicationsReports">
            <div id="PublicationsReports_content-bind"></div>
        </div>
        <div id="Nav_NewsEvents">
            <div id="NewsEvents_content-bind"></div>
        </div>
    </div>
</section>

<div class="pb-5"></div>

@section Scripts {
    <script>
        var rakingsAjaxUrl = '@Url.Action("SearchAjax", "Ratings", new { language = language })';
        var issuerOrgansUrl = '/@language/Ratings/IssuerOrgansAsync';
        var publicationsAjaxUrl = '@Url.Action("SearchPublicationsAjax", "Category", new { language = language })';
        var newsAndEventAjaxUrl = '@Url.Action("NewsAndEventAjax", "Category", new { language = language })';

        var currentLanguage = '@language';
        var filterOpen = false;
        var errorLoadingDataMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ErrorLoadingData"].Value));
        var reportNotAvailableMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ReportNotAvailable"].Value));
        var initialKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(queryKey));
        var displayingResultsForFormat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["DisplayingResultsFor"].Value));


        
        function buildParams(page) {
            var keyVal = ($('#search-input').val() || '').trim();
            if (!keyVal && initialKey) keyVal = initialKey;
            return {
                companyName: keyVal,
                page: page || 1,
                pageSize: 10,
                lang: currentLanguage
            };
        }

        function showLoading() {
            if ($('#rating-loading').length) {
                $('#rating-loading').removeClass('d-none');
            }
            if ($('#icon-search').length) {
                $('#icon-search').addClass('d-none');
            }
            if ($('#btn-search').length) {
                $('#btn-search').prop('disabled', true);
            }
            $('.btn-search').prop('disabled', true);
        }

        function hideLoading() {
            if ($('#rating-loading').length) {
                $('#rating-loading').addClass('d-none');
            }
            if ($('#icon-search').length) {
                $('#icon-search').removeClass('d-none');
            }
            if ($('#btn-search').length) {
                $('#btn-search').prop('disabled', false);
            }
            $('.btn-search').prop('disabled', false);
        }

        function showContentLoading() {
            var skeleton = Array(3).fill().map(function () {
                return `
                    <div class="rating-card">
                        <div class="rating-left">
                            <div class="rating-header">
                                <div class="rating-badge rating-a skeleton-text">&nbsp;</div>

                                <div class="rating-top-info">
                                    <div class="rating-date skeleton-text">&nbsp;</div>
                                    <div class="rating-company skeleton-text">&nbsp;</div>
                                </div>
                            </div>

                            <div class="rating-info">
                                <div>
                                    <span class="info-label skeleton-text">&nbsp;</span>
                                    <span class="info-value skeleton-text">&nbsp;</span>
                                </div>
                                <div>
                                    <span class="info-label skeleton-text">&nbsp;</span>
                                    <span class="info-value skeleton-text">&nbsp;</span>
                                </div>
                                <div>
                                    <span class="info-label skeleton-text">&nbsp;</span>
                                    <span class="status-tag skeleton-text">&nbsp;</span>
                                </div>
                                <div>
                                   <a href="#" class="btn-report disabled">&nbsp;</a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            $('#bindRatingContent').html(skeleton);
        }

        function showIssuerLoading() {
            var skeleton = Array(2).fill().map(function () {
                return `
                    <div class="issuer-card">
                        <div class="issuer-left">
                            <div class="issuer-header">
                                <div class="issuer-badge skeleton-text">&nbsp;</div>
                                <div class="issuer-top-info">
                                    <div class="issuer-date skeleton-text">&nbsp;</div>
                                    <div class="issuer-company skeleton-text">&nbsp;</div>
                                    <div class="issuer-info skeleton-text">&nbsp;</div>
                                </div>
                            </div>
                        <div class="issuer-right">
                            <a href="#" class="btn-report disabled">&nbsp;</a>
                        </div>
                        </div>

                    </div>
                `;
            }).join('');
            $('#bindIssuerContent').html(skeleton);
        }

        function showPublicationsLoading() {
            var skeleton = Array(1).fill().map(function () {
                return `
                    <div class="row mb-3">
                        <div class="col-lg-4 col-sm-6">
                            <div class="news-img skeleton-text" style="height:80px; background:#f3f3f3"></div>
                        </div>
                                 <div class="col-lg-4 col-sm-6">
                            <div class="news-img skeleton-text" style="height:80px; background:#f3f3f3"></div>
                        </div>
                                 <div class="col-lg-4 col-sm-6">
                            <div class="news-img skeleton-text" style="height:80px; background:#f3f3f3"></div>
                        </div>
                    </div>
                `;
            }).join('');
            $('#PublicationsReports_content-bind').html(skeleton);
        }

        function showNewsLoading() {
            var skeleton = Array(3).fill().map(function () {
                return `
                    <div class="col-lg-4 col-sm-6 mb-3">
                        <div class="news-img" style="height:140px;background:#f3f3f3;border-radius:12px;"></div>
                        <h3 class="pt-3"><div style="height:18px;width:70%;background:#eee;border-radius:4px;"></div></h3>
                    </div>
                `;
            }).join('');
            $('#NewsEvents_content-bind').html('<div class="row">' + skeleton + '</div>');
        }

        window.getIssuerOrgansAjax = function (page) {
            page = page || 1;
            var keyword = ($('#search-input').val() || '').trim();
            if (!keyword && initialKey) keyword = initialKey;

            showIssuerLoading();

            $.get(issuerOrgansUrl, { keyword: keyword, page: page, lang: currentLanguage })
                .done(function (html) {
                    $('#bindIssuerContent').html(html);
                })
                .fail(function () {
                    $('#bindIssuerContent').html('<div class="text-center py-5 text-danger">' + errorLoadingDataMsg + '</div>');
                });
        };

        window.getRakingsAjax = function (page) {
            page = page || 1;
            var params = buildParams(page);

            showLoading();
            showContentLoading();

            $.get(rakingsAjaxUrl, params)
                .done(function (html) {
                    $('#bindRatingContent').html(html);

                    var key = params.companyName || '';
                    if (key && key.length) {
                        // format: contains {0}
                        var msg = displayingResultsForFormat.replace('{0}', key);
                        $('#search-info').text(msg);
                    } else {
                        $('#search-info').text('');
                    }
                })
                .fail(function () {
                    $('#bindRatingContent').html('<div class="text-center py-5 text-danger">' + errorLoadingDataMsg + '</div>');
                })
                .always(function () {
                    hideLoading();
                });
        };

        window.publicationsAjax = function(page) {
            page = page || 1;
             var keyword = ($('#search-input').val() || '').trim();
            if (!keyword && initialKey) keyword = initialKey;
            // show publications loading
            showPublicationsLoading();
            $.get(publicationsAjaxUrl, { page: page, language: currentLanguage, keyword: keyword, bindContentTag: "#publicationsAjax"})
                .done(function (html) {
                    $('#PublicationsReports_content-bind').html(html);
                    })
                    .fail(function () {
                        $('#PublicationsReports_content-bind').html('<div class="no-data-messege">No data</div>');
                    })
                    .always(function () {
                        hideLoading();
                });
        };

        window.newsAndEventAjax = function(page) {
            page = page || 1;
            var keyword = ($('#search-input').val() || '').trim();
            if (!keyword && initialKey) keyword = initialKey;
            // show loading skeleton
            showNewsLoading();
            $.get(newsAndEventAjaxUrl, { page: page, language: currentLanguage, keyword: keyword, bindContentTag: "newsAndEventAjax", skeleton: 0 })
                .done(function (html) {
                    $('#NewsEvents_content-bind').html(html);
                })
                .fail(function () {
                    $('#NewsEvents_content-bind').html('<div class="no-data-messege">No data</div>');
                })
                .always(function () {
                    hideLoading();
                });
        };

        function onSearch() {
            // Call loader according to currently selected tab
            var activeLink = document.querySelector('.narbartrust a.active');
            var href = activeLink ? activeLink.getAttribute('href') : '#Nav_Ratings';
            var targetId = href && href.startsWith('#') ? href.substring(1) : 'Nav_Ratings';

            switch (targetId) {
                case 'Nav_Ratings':
                    getRakingsAjax(1);
                    // also update issuer list together
                    getIssuerOrgansAjax(1);
                    break;
                case 'Nav_PublicationsReports':
                    publicationsAjax(1);
                    break;
                case 'Nav_NewsEvents':
                    newsAndEventAjax(1);
                    break;
                default:
                    getRakingsAjax(1);
                    getIssuerOrgansAjax(1);
            }
         }

        $(function () {
            if (initialKey && initialKey.length) {
                $('#search-input').val(initialKey);
                var msg = displayingResultsForFormat.replace('{0}', initialKey);
                $('#search-info').text(msg);
                getRakingsAjax(1);
            }
        });
    </script>
}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('.narbartrust a');
        const sectionIds = ['Nav_Ratings', 'Nav_PublicationsReports', 'Nav_NewsEvents'];

        function showSection(id) {
            sectionIds.forEach(sid => {
                const $el = $('#' + sid);
                if ($el.length) {
                    if (sid === id) $el.show(); else $el.hide();
                }
            });
        }

        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                links.forEach(l => l.classList.remove('active'));
                link.classList.add('active');

                const href = link.getAttribute('href') || '';
                const targetId = href.startsWith('#') ? href.substring(1) : 'Nav_Ratings';
                showSection(targetId);

                // trigger load for specific tabs
                if (targetId === 'Nav_Ratings') {
                    // load ratings + issuers
                    getRakingsAjax(1);
                }
                else if (targetId === 'Nav_PublicationsReports') {
                    publicationsAjax(1);
                }
                else if (targetId === 'Nav_NewsEvents') {
                    newsAndEventAjax(1);
                }
            });
        });

        // Initialize: show only the active tab's section
        const activeLink = document.querySelector('.narbartrust a.active');
        const initialTarget = (activeLink && activeLink.getAttribute('href') && activeLink.getAttribute('href').startsWith('#')) ? activeLink.getAttribute('href').substring(1) : 'Nav_Ratings';
        showSection(initialTarget);

        // If ratings is the initial tab and we have a search key or want to load default, trigger it
        if (initialTarget === 'Nav_Ratings') {
            // If initialKey exists we already call getRakingsAjax on page init; ensure content loads if not
            if (!initialKey || !initialKey.length) {
                getRakingsAjax(1);
            }
        }
    });
</script>