<style>

	/* Banner */
	#SliderBanner img {
		max-height: 100%;
	}

	.event-box {
		position: absolute;
		bottom: 30px;
		left: 30px;
		width: 26%;
		padding: 30px;
		border-radius: 12px;
		background: url('Data/Banner/bg-joinnew.png') no-repeat center/cover;
		background-blend-mode: overlay;
		/* tăng độ rõ của text */
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
		border: 1px solid rgba(255, 255, 255, 0.6);
		animation: fadeInUp 0.8s ease;
		transition: opacity 0.3s ease, transform 0.3s ease;
		z-index: 10;
	}

	@@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(15px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Tiêu đề và nội dung */
	.event-box h4 {
		font-size: 18px;
		color: #1D2939;
		font-weight: 600;
		margin-bottom: 5px;
	}

	.event-box p {
		font-size: 28px;
		color: #034EA2;
		font-weight: 500;
		margin-bottom: 12px;
	}

	/* Nút Join */
	.event-btn {
		display: inline-block;
		background: linear-gradient(135deg, #034EA2, #53DFFF);
		color: white;
		font-size: 14px;
		font-weight: 500;
		padding: 6px 18px;
		border-radius: 6px;
		text-decoration: none;
		transition: all 0.3s ease;
	}

		.event-btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 8px rgba(3, 78, 162, 0.3);
		}

	/* Nút đóng góc phải */
	.event-close {
		position: absolute;
		top: 8px;
		right: 8px;
		background: transparent;
		border: none;
		color: #004b8d;
		font-size: 16px;
		cursor: pointer;
		transition: color 0.2s ease, transform 0.2s ease;
	}

		.event-close:hover {
			color: #0078d4;
			transform: rotate(90deg);
		}

	/* Ẩn box khi nhấn nút */
	.event-box.hidden {
		opacity: 0;
		transform: translateY(10px);
		pointer-events: none;
	}

	/* Responsive cho mobile */
	@@media (max-width: 992px) {
		.event-box {
			width: 60%;
			padding: 20px;
			bottom: 20px;
			left: 20px;
		}

			.event-box p {
				font-size: 22px;
			}
	}

	@@media (max-width: 576px) {
		.event-box {
			display: none;
		}
	}


	/* FIND */
	#Find {
		background: url('Data/Banner/search_banner.png') no-repeat center;
		background-size: cover;
		background-position: center center;
	}


	/* WhyLastest */
	.view-now {
		display: inline-block;
		background-color: #0066cc;
		color: #ffffff;
		padding: 7px 70px;
		border-radius: 25px;
		cursor: pointer;
	}

