@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using PT.Domain.Model;
@using PT.Infrastructure.Interfaces;
@using PT.Shared;
@inject IViewLocalizer Localizer;
@using System.Linq.Expressions;
@using PT.UI.Models
@inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
@inject IOptions<BaseSettings> _baseSettings;

@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = _baseSettings.Value.PortalId;
}
<style>
   .thinks-grid{display:grid;grid-template-columns:0.8fr 1.1fr;gap:30px}.thinks-featured{border-radius:12px;overflow:hidden;transition:transform .3s ease}.thinks-featured:hover{transform:translateY(-3px)}.thinks-featured .thinks-img{width:100%;object-fit:cover}.thinks-info{padding:18px 0}.thinks-tags{display:flex;gap:10px;font-size:13px;margin-bottom:10px;align-items:center}.thinks-tags .tag{background:#eaf4ff;color:#06c;padding:10px;border-radius:4px;font-weight:600;font-size:15px}.thinks-tags .date{color:#777;font-size:15px}.thinks-title{color:#093461;font-weight:700;font-size:28px;margin-bottom:10px;line-height:1.4}.thinks-desc{color:#093461;font-size:12px;line-height:1.6;margin-bottom:10px}.thinks-list{display:flex;flex-direction:column;gap:18px}.thinks-item{display:flex;gap:15px;align-items:flex-start}.thinks-item:not(:first-child){border-top:1px solid #ccc;padding:20px 0}.thinks-item img{width:280px;height:140px;border-radius:6px;object-fit:cover}.thinks-content p{color:#093461;font-size:18px;margin:0;font-weight:500;line-height:1.5}.think-now{background-color:#06c;color:#fff;padding:8px 40px;border-radius:25px;cursor:pointer;display:inline-block;text-align:center;margin:40px auto 0;transition:all .3s ease}.think-now:hover{background-color:#004c9b}.think-now-wrapper{text-align:center}.news-img{width:100%;aspect-ratio:16 / 10;object-fit:cover;object-position:center;border-radius:12px;border:1px solid #eee}.news-title{color:#1d2939;font-size:20px;line-height:30px;word-break:break-word;font-weight:600}
</style>
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeSliderBanner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeFind", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeFiinRatings", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeWhatWeDo", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.PhotoSlide, code = "FRHomeSliderDauAn", language = language, portalId = portalId })

<section id="Thinking" class="py-5">
    <div id="topNewsContainer"></div>
</section>

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.PhotoSlide, code = "S&PGlobalRatings", language = language, portalId = portalId })

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.PhotoSlide, code = "FRHomeSliderTestimonials", language = language, portalId = portalId })

<partial name="_Register" />

<script>
    function loadTopNews(containerId, url) {
        $(containerId).html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
        $.ajax({
            url: url,
            type: 'GET',
            dataType: 'html',
            success: function (response) {
                $(containerId).html(response);
            },
            error: function (xhr, status, error) {
                $(containerId).html('<div class="alert alert-danger">Không thể tải tin tức. Status: ' + xhr.status + '</div>');
            }
        });
    }

    $(document).ready(function() {
         loadTopNews('#topNewsContainer','/@(language)/ContentPage/TopNewsAjax?parameter=Home_TopNews&view=TopNews2Ajax&pageSize=4');
    });
</script>