@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@inject IViewLocalizer  Localizer
@inject IOptions<BaseSettings> _baseSettings;

@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = _baseSettings.Value.PortalId;

}
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProcessBanner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProcessFiinMethod", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProcessPolicy", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProcessBasicInfo", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ProcessDeliver", language = language, portalId = portalId })

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('.narbarprocess a');
        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                links.forEach(l => l.classList.remove('active'));
                link.classList.add('active');
            });
        });
    });
    const dots = document.querySelectorAll(".pagination-dots .dot");
    const prevBtn = document.querySelector(".arrow-btn:first-child");
    const nextBtn = document.querySelector(".arrow-btn:last-child");

    let currentIndex = 0; // dot đang active

    function updateDots() {
        dots.forEach((d, i) => {
            d.classList.toggle("active", i === currentIndex);
        });
    }

    // Bấm nút next
    nextBtn.addEventListener("click", () => {
        currentIndex++;
        if (currentIndex >= dots.length) currentIndex = 0; // quay vòng
        updateDots();
    });

    // Bấm nút prev
    prevBtn.addEventListener("click", () => {
        currentIndex--;
        if (currentIndex < 0) currentIndex = dots.length - 1; // quay vòng
        updateDots();
    });

    // Bấm trực tiếp vào dot
    dots.forEach((dot, idx) => {
        dot.addEventListener("click", () => {
            currentIndex = idx;
            updateDots();
        });
    });

    document.querySelectorAll('.acc-header').forEach(header => {
        header.addEventListener('click', () => {
            const item = header.parentElement;
            const isOpen = item.classList.contains("open");

            // Đóng tất cả mục khác (nếu muốn accordion dạng chỉ mở 1)
            // document.querySelectorAll(".acc-item").forEach(i => i.classList.remove("open"));

            // Toggle chính nó
            if (!isOpen) {
                item.classList.add("open");
            } else {
                item.classList.remove("open");
            }
        });
    });
</script>

