@addTagHelper *, PT.UI
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@inject IViewLocalizer  Localizer
@inject IOptions<BaseSettings> _baseSettings;

@{
    Layout = "~/Views/Shared/_Home.cshtml";
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var portalId = _baseSettings.Value.PortalId;

}

@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "PolicyBanner", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "PolicyLaw", language = language, portalId = portalId })
@await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "PolicyDeliver", language = language, portalId = portalId })