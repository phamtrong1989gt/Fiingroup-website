@using Microsoft.Extensions.Options
@inject PT.Infrastructure.Interfaces.IContactRepository _iContactRepository;
@inject IOptions<BaseSettings> _baseSettings;

@{
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var listLanguage = PT.Shared.ListData.ListLanguage;
    @model PT.UI.Models.ContactHomeModel;
    @inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.AuthorizeSettings> _authorizeSettings;
    @inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
    var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
    var portalId = _baseSettings.Value.PortalId;
    var contactType = (int)Contact.ContactType.Product;
    
    // ============================================
    // HARDCODED SECTOR EXPERTISE LIST
    // ============================================
    var sectorExpertiseList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    
    if (language == "vi")
    {
        sectorExpertiseList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Ngân hàng/Dịch vụ Tài chính" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Chứng khoán" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Quản lý Quỹ" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "Doanh nghiệp FDI" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "5", Text = "Tập đoàn lớn" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "6", Text = "Tư vấn/Kiểm toán" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "7", Text = "Pháp lý" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "8", Text = "Giáo dục và Nghiên cứu" }
        };
    }
    else // English
    {
        sectorExpertiseList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Banking/Financial Services" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Securities" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Fund Management" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "FDI Enterprises" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "5", Text = "Large Corporations" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "6", Text = "Consulting & Audit" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "7", Text = "Legal Services" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "8", Text = "Education & Research" }
        };
    }
    
    // ============================================
    // HARDCODED PRODUCTS & SERVICES LIST
    // ============================================
    var productsServicesList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    
    if (language == "vi")
    {
        productsServicesList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Xếp hạng tín nhiệm Tổ chức phát hành" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Xếp hạng tín nhiệm Công cụ nợ" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Dịch vụ cho Nhà đầu tư" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "Dịch vụ Tài chính bền vững" }
        };
    }
    else // English
    {
        productsServicesList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Issuer Credit Rating" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Issue Credit Rating" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Investor Services" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "Sustainable Finance" }
        };
    }
}
<style>

</style>
<section class="py-5 mb-3 mt-3" id="DangKy">
    <div class="container">
        <h2 class="price-title mb-5">
            @if (language == "vi") 
            { 
                <text>Đăng ký ngay để <span style="color: #0066CC;">nhận tư vấn</span></text> 
            } 
            else 
            { 
                <text>Register now to <span style="color: #0066CC;">receive consultation</span></text> 
            }
        </h2>
        <div class="row">
            <div class="col-lg-6 col-sm-12">
                <input type="hidden" id="languageId" value="@language" />
                <form id="formLienHe" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-sm-12 mb-2">
                            <label for="hoTen" class="form-label">
                                @(language == "vi" ? "Họ và tên" : "Full Name") <span class="error">*</span>
                            </label>
                            <input type="text" class="form-control" id="hoTen" asp-for="FullName" placeholder="@(language == "vi" ? "Nhập họ và tên" : "Enter full name")">
                            <span class="validate-style" asp-validation-for="FullName"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label for="soDienThoai" class="form-label">
                                @(language == "vi" ? "Số điện thoại" : "Phone") <span class="error">*</span>
                            </label>
                            <input type="text" class="form-control" id="soDienThoai" asp-for="Phone" placeholder="@(language == "vi" ? "Nhập số điện thoại" : "Enter phone number")">
                            <span class="validate-style" asp-validation-for="Phone"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label for="email" class="form-label">Email <span class="error">*</span></label>
                            <input type="email" class="form-control" id="email" asp-for="Email" placeholder="@(language == "vi" ? "Nhập email" : "Enter email")">
                            <span class="validate-style" asp-validation-for="Email"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label for="tenCongTy" class="form-label">
                                @(language == "vi" ? "Tên công ty" : "Company Name") <span class="error">*</span>
                            </label>
                            <input type="text" class="form-control" id="tenCongTy" asp-for="ConpanyName" placeholder="@(language == "vi" ? "Nhập công ty" : "Enter company name")">
                            <span class="validate-style" asp-validation-for="ConpanyName"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label for="chucDanhCV" class="form-label">
                                @(language == "vi" ? "Chức danh công việc" : "Job Title") <span class="error">*</span>
                            </label>
                            <input type="text" class="form-control" id="chucDanhCV" asp-for="Position" placeholder="@(language == "vi" ? "Nhập chức danh công việc" : "Enter job title")">
                            <span class="validate-style" asp-validation-for="Position"></span>
                        </div>
                        <div class="col-sm-12 mb-2">
                            <label for="dichVuQT" class="form-label">
                                @(language == "vi" ? "Nhóm ngành" : "Sector Expertise") <span class="error">*</span>
                            </label>
                            <select asp-for="ServiceId" asp-items="sectorExpertiseList" class="form-select" id="dichVuQT">
                                <option value="">@(language == "vi" ? "Chọn nhóm ngành" : "Select sector")</option>
                            </select>
                            <span asp-validation-for="ServiceId" class="validate-style"></span>
                        </div>
                        <div class="col-sm-12 mb-2">
                            <label for="sanPhamQT" class="form-label">
                                @(language == "vi" ? "Sản phẩm & dịch vụ quan tâm" : "Products & Services of Interest")
                            </label>
                            <select class="form-select" id="sanPhamQT" asp-items="productsServicesList" multiple="multiple">
                            </select>
                        </div>
                        <div class="col-sm-12 mb-2">
                            <label for="yeuCauCT" class="form-label">
                                @(language == "vi" ? "Mô tả chi tiết" : "Description") <span class="error">*</span>
                            </label>
                            <textarea type="text" maxlength="1000" asp-for="Content" class="form-control txt-area" id="yeuCauCT" placeholder="@(language == "vi" ? "Nhập mô tả chi tiết" : "Enter description")"></textarea>
                            <span class="validate-style" asp-validation-for="Content"></span>
                            <input type="hidden" class="form-control" id="type" asp-for="Type" value="@contactType">
                            <input type="hidden" class="form-control" id="products" asp-for="Products">
                        </div>
                    </div>
                    <div class="mb-2"></div>
                    <button type="submit" class="btn btn-primary col-sm-12 btn-yeucau" btnSendLH>
                        @(language == "vi" ? "Gửi yêu cầu" : "Submit")
                    </button>
                    <input type="hidden" class="Capcha" id="g-recaptcha-response" name="capcha" />
                </form>
            </div>
            <div class="col-lg-6 col-sm-12 img">
                @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeBannerRegister", language = language, portalId = portalId })
            </div>
        </div>
    </div>
</section>
@section Scripts
{
}

<script>

    $(function () {
            $('#sanPhamQT').select2({
               placeholder: "@(language == "vi" ? "" : "")",
               closeOnSelect: false,
               allowHtml: true,
               allowClear: true,
               tags: true
            });
      const $form = $('#formLienHe');
      $form.on('submit', function (e) {
        e.preventDefault();
        if (!$form.valid()) {
          return;
        }
        const token = $form.find('input[name="__RequestVerificationToken"]').val();
        $.ajax({
          url: '@Url.Action("Contact", "ContactHome")',
          type: 'POST',
          data: $form.serialize(),
          headers: { 'RequestVerificationToken': token },
          success: function (res) {
            if(res.output == 1)
            {
                alertify.success(res.message);
                $form[0].reset();
                $("#products").val("");
                $('#sanPhamQT').val(null).trigger('change');
                hideRecaptchaPopup();
                if (recaptchaWidgetId !== null) {
                    grecaptcha.reset(recaptchaWidgetId);
                }
            }
            else if (res.output == 69) {
                showRecaptchaPopup("[btnSendLH]");
                return;
            }
          },
          error: function (xhr) {
            alertify.warning('@(language == "vi" ? "Đã xảy ra lỗi, vui lòng F5 trình duyệt và thử lại!" : "An error occurred, please refresh and try again!")');
          }
        });
      });
    });

    $("#sanPhamQT").on("change", function () {
        let selected = $(this).val();
        if (selected && selected.length > 0) {
            $("#products").val(selected.join("; "));
        } else {
            $("#products").val("");
        }
    });

</script>
