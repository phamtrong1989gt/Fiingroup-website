@using Microsoft.Extensions.Options
@inject PT.Infrastructure.Interfaces.IContactRepository _iContactRepository;
@inject IOptions<BaseSettings> _baseSettings;
@inject IViewLocalizer Localizer;

@{
    string language = PT.Base.CultureHelper.GetCurrentCulture.Id;
    var listLanguage = PT.Shared.ListData.ListLanguage;
    @model PT.UI.Models.ContactHomeModel;
    @inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.AuthorizeSettings> _authorizeSettings;
    @inject PT.Infrastructure.Interfaces.IContentPageRepository _iContentPageRepository;
    var dlLanguage = listLanguage.FirstOrDefault(x => x.Id == language);
    var portalId = _baseSettings.Value.PortalId;
    var contactType = (int)Contact.ContactType.Product;
    
    // ============================================
    // HARDCODED SECTOR EXPERTISE LIST
    // ============================================
    var sectorExpertiseList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    
    if (language == "vi")
    {
        sectorExpertiseList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Ngân hàng/Dịch vụ Tài chính" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Chứng khoán" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Quản lý Quỹ" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "Doanh nghiệp FDI" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "5", Text = "Tập đoàn lớn" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "6", Text = "Tư vấn/Kiểm toán" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "7", Text = "Pháp lý" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "8", Text = "Giáo dục và Nghiên cứu" }
        };
    }
    else // English
    {
        sectorExpertiseList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Banking/Financial Services" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Securities" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Fund Management" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "FDI Enterprises" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "5", Text = "Large Corporations" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "6", Text = "Consulting & Audit" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "7", Text = "Legal Services" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "8", Text = "Education & Research" }
        };
    }
    
    // ============================================
    // HARDCODED PRODUCTS & SERVICES LIST
    // ============================================
    var productsServicesList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    
    if (language == "vi")
    {
        productsServicesList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Xếp hạng tín nhiệm Tổ chức phát hành" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Xếp hạng tín nhiệm Công cụ nợ" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Dịch vụ cho Nhà đầu tư" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "Dịch vụ Tài chính bền vững" }
        };
    }
    else // English
    {
        productsServicesList = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        {
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "1", Text = "Issuer Credit Rating" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "2", Text = "Issue Credit Rating" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "3", Text = "Investor Services" },
            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Value = "4", Text = "Sustainable Finance" }
        };
    }
}
<style>

</style>
<section class="py-5 mb-3 mt-3" id="DangKy">
    <div class="container">
        <h2 class="price-title mb-5">@Localizer["Title"]</h2>
        <div class="row">
            <div class="col-lg-6 col-sm-12">
                <input type="hidden" id="languageId" value="@language" />
                <form id="formLienHe" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-sm-12 mb-2"><label class="form-label" asp-for="FullName"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="FullName" placeholder=""><span class="validate-style" asp-validation-for="FullName"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="Phone"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="Phone" placeholder=""><span class="validate-style" asp-validation-for="Phone"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="Email"></label> <strong class="error">*</strong><input type="email" class="form-control" asp-for="Email" placeholder=""><span class="validate-style" asp-validation-for="Email"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="ConpanyName"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="ConpanyName" placeholder=""><span class="validate-style" asp-validation-for="ConpanyName"></span></div>
                        <div class="col-sm-6 mb-2"><label class="form-label" asp-for="Position"></label> <strong class="error">*</strong><input type="text" class="form-control" asp-for="Position" placeholder=""><span class="validate-style" asp-validation-for="Position"></span></div>
                        <div class="col-sm-12 mb-2"><label class="form-label" for="dichVuQT" asp-for="ServiceId"></label> <strong class="error">*</strong><select asp-for="ServiceId" asp-items="sectorExpertiseList" class="form-select" id="dichVuQT"><option value="">@Localizer["SelectServiceId"]</option></select><span asp-validation-for="ServiceId" class="validate-style"></span></div>

                        <div class="col-sm-12 mb-2">
                            <label class="form-label" asp-for="Products" for="sanPhamQT"></label>
                            <strong class="error">*</strong>
                            <select class="form-select" id="sanPhamQT" asp-items="productsServicesList" multiple="multiple"></select>
                            <span class="validate-style" asp-validation-for="Products"></span>
                        </div>

                        <div class="col-sm-12 mb-2"><label class="form-label" for="yeuCauCT" asp-for="Content"></label><textarea type="text" maxlength="1000" asp-for="Content" class="form-control txt-area" id="yeuCauCT" placeholder="@Localizer["ContentPlaceholder"]"></textarea><span class="validate-style" asp-validation-for="Content"></span><input type="hidden" class="form-control" id="products" asp-for="Products"></div>
                        @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "ContactFormMsg", language = language, portalId = portalId })
                    </div><div class="mb-2"></div><button type="submit" class="btn btn-primary col-sm-12 btn-yeucau" btnSendLH>@Localizer["BtnSend"]</button><input type="hidden" class="Capcha" id="g-recaptcha-response" name="capcha" />
                </form>
            </div>
            <div class="col-lg-6 col-sm-12 img">
                @await Component.InvokeAsync("ViewModule", new { type = ModuleType.StaticInformation, code = "FRHomeBannerRegister", language = language, portalId = portalId })
            </div>
        </div>
    </div>
</section>
@section Scripts
{
}

<script>
    window.registerFormConfig = {
        // URLs
        urls: {
            contact: '@Url.Action("Contact", "ContactHome")',
            flowSelectList: '@Url.Action("FlowSelectList", "ContactHome")'
        },
        // Localized strings
        i18n: {
            selectProducts: '@Localizer["SelectProducts"]',
            otherProduct: '@Localizer["OtherProduct"]',
            msgNotUse: '@Localizer["MsgNotUse"]',
            noProducts: '@Localizer["NoProducts"]',
            errorMessage: 'Đã xảy ra lỗi, vui lòng F5 trình duyệt và thử lại!'
        },
        language: '@language',
        portalId: @portalId
    };

    $(document).ready(function() {
        if (typeof initRegisterForm === 'function') {
            initRegisterForm(window.registerFormConfig);
        } else {
            console.error('initRegisterForm function not found in site.js');
        }
    });
</script>