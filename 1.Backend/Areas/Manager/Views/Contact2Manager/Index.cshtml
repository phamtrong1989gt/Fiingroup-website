@addTagHelper *, Sakura.AspNetCore.Mvc.PagedList
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, PT.UI
@{
    Layout = "~/Views/Shared/_Admin.cshtml";
    var listSolution = (SelectList)ViewData["SolutionSelectList"];
}

<div grid-index data-url="@Url.Action("index")">
    <div class="row head-v2">
        <div class="col-md-12">
            <div class="block-header">
                <h2><i class="material-icons">markunread</i>QUẢN LÝ LIÊN HỆ NHẬN TIN <span class="label label-danger label-t">Danh sách</span></h2>
            </div>
        </div>
    </div>
    <div class="row clearfix">
        <div class="col-md-12">
            <div class="new-form-search">
                <div class="row">

                    <div class="col-md-2">
                        <div class="form-group" style="margin-bottom:0px;">
                            <label class="form-label">Thời gian gửi từ (>=)</label>
                            <div class="controls">
                                <input grid-input type="text" value="@DateTime.Now.ToString("dd/MM/yyyy 00:00")" class="form-control input-sm form-control-t" name="startTime" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group" style="margin-bottom:0px;">
                            <label class="form-label">Thời gian đến (@("<"))</label>
                            <div class="controls">
                                <input grid-input type="text" value="@DateTime.Now.AddDays(1).ToString("dd/MM/yyyy 00:00")" class="form-control input-sm form-control-t" name="endTime" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group" style="margin-bottom:0px;">
                            <label class="form-label">Tên công ty</label>
                            <div class="controls">
                                <input class="form-control input-sm form-control-t" grid-input type="text" name="conpanyName">
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-2">
                        <div class="form-group" style="margin-bottom:0px;">
                            <label class="form-label">Cổng</label>
                            <div class="controls">
                                <select grid-input name="portalId" asp-items="@((SelectList)ViewData["PortalSelectList"])" class="input-sm form-control-t show-tick">
                                    <option value="">Tất cả</option>
                                </select>
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-md-2">
                        <div class="can-button-search">
                            <a onclick="getDataGrid(1)" class="btn bg-indigo dropdown-toggle">
                                <i class="material-icons">search</i><span>Tìm kiếm</span>
                            </a>
                            <a onclick="exportExcel()" class="btn bg-green dropdown-toggle" title="Xuất Excel">
                                <i class="material-icons">get_app</i><span>Xuất Excel</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div grid-loading class="card card-t card-loading">
                <div class="header bg-indigo">
                    <h4 grid-num-row class="num-t m-l-20">
                        Đang tải...
                    </h4>
                    <ul class="header-dropdown m-r--5 header-dropdown-t">
                        <li class="dropdown">
                            <a href="javascript:void(0);" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="material-icons">apps</i>
                            </a>
                            <ul class="dropdown-menu pull-left">
                                <li><a href="javascript:void(0);">Đóng lại</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="controlOrderBy">
                        <div style="width:110px;" class="itemorder selectOrder">
                            <select grid-input onchange="getDataGrid(1)" data-header="Loại sắp xếp" name="ordertype" class="form-control input-sm form-control-t show-tick">
                                <option data-icon="glyphicon-sort-by-attributes-alt" value="desc">Giảm dần</option>
                                <option data-icon="glyphicon-sort-by-attributes" value="asc">Tăng dần</option>
                            </select>
                        </div>
                        <div style="width:200px;" class="itemorder selectOrder">
                            <select grid-input onchange="getDataGrid(1)" data-header="Xắp xếp theo" name="orderby" class="form-control input-sm form-control-t show-tick">
                                <option data-icon="glyphicon glyphicon-sort" value="datePosted">Xếp theo thời gian tạo</option>
                                <option data-icon="glyphicon glyphicon-sort" value="name">Xếp theo tên hiển thị</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="body body-t">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover table-t">
                            <thead>
                                <tr>
                                    <th style="width:60px;">STT</th>
                                    <th>Họ và tên</th>
                                    <th>SĐT</th>
                                    <th>Email</th>
                                    <th>Tên Công Ty</th>
                                    <th>Chức Danh Công Việc</th>
                                    <th>Lĩnh vực quan tâm</th>
                                    <th>Mô Tả Chi Tiết</th>
                                    <th style="width:160px;">Ngày Gửi</th>
                                </tr>
                            </thead>
                            <tbody grid-data></tbody>
                        </table>
                    </div>
                    <div class="pl-20 pr-20 divpagination">
                        <div class="row">
                            <div class="col-md-2 m-b-0">
                                <div class="input-group m-b-0">
                                    <span class="input-group-addon">
                                        Bản ghi/trang
                                    </span>
                                    <div class="form-line form-line-t form-line-pagesize">
                                        <select name="limit" onchange="getDataGrid(1)" class="form-control show-tick" grid-input>
                                            <option selected value="10">10</option>
                                            <option value="20">20</option>
                                            <option value="30">30</option>
                                            <option value="40">40</option>
                                            <option value="50">50</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-10 m-b-0">
                                <nav grid-pagination class="pg-t">
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/Content/Admin/plugins/ckeditor/ckeditor.js"></script>
    <script>
        var _page = 1;
        $(function () {
            $("[name='startTime']").toDateTimePicker();
            $("[name='endTime']").toDateTimePicker();

            $("[search-advance]").toSearch();
            $("[button-popup]").toPopup();
            $("[button-open-file-manager]").toButtonOpenFile();
            $("[button-submit]").toSubmit();
            $("[button-delete]").toDelete();
            getDataGrid(1, true);
        });
        function initRickText() {
            $("ricktextContent").toRickText({ customConfig: 'configRickText.js', filebrowserImageBrowseUrl: "@Url.Action("Manager", "FileManager", new { area="Base",path="Blog/" })" });
        }
        function getDataGrid(page, first = false) {
            _page = page;
            $("[grid-index]").toGridView(first, page);
        }
        function reGetDataGrid(e) {
            getDataGrid(_page, false);
        }

                function exportExcel() {
            // Show loading
            $("[grid-loading]").addClass("loading");

            // Collect filter parameters
            var key = $("[grid-input][name='key']").val();
            var status = $("[grid-input][name='status']").val();
            var startTime = $("[grid-input][name='startTime']").val();
            var endTime = $("[grid-input][name='endTime']").val();
            var serviceId = $("[grid-input][name='serviceId']").val();
            var portalId = $("[grid-input][name='portalId']").val();
            var ordertype = $("[grid-input][name='ordertype']").val();
            var orderby = $("[grid-input][name='orderby']").val();

            // Build body as application/x-www-form-urlencoded
            var params = new URLSearchParams();
            params.append('key', key || '');
            params.append('status', status || '');
            params.append('startTime', startTime || '');
            params.append('endTime', endTime || '');
            params.append('serviceId', serviceId || '');
            params.append('portalId', portalId || '');
            params.append('ordertype', ordertype || '');
            params.append('orderby', orderby || '');

            // If anti-forgery token exists in the page, include it
            var antiForgeryInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (antiForgeryInput) {
                params.append('__RequestVerificationToken', antiForgeryInput.value);
            }

            // Fetch - avoids jQuery trying to read xhr.responseText when responseType is blob
            fetch('@Url.Action("ExportExcel", "Contact2Manager", new { area = "Manager" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: params.toString(),
                credentials: 'same-origin'
            })
            .then(function (response) {
                if (!response.ok) {
                    // Attempt to read text for server error diagnostics (response.text() is safe here)
                    return response.text().then(function (text) {
                        throw new Error(text || ('HTTP error ' + response.status));
                    });
                }
                return Promise.all([response.blob(), Promise.resolve(response.headers)]);
            })
            .then(function (results) {
                var blob = results[0];
                var headers = results[1];

                // Hide loading
                $("[grid-loading]").removeClass("loading");

                // Determine filename from Content-Disposition header
                var filename = "DanhSachLienHe_" + new Date().toISOString().slice(0, 10) + ".xlsx";
                var disposition = headers.get('Content-Disposition') || headers.get('content-disposition');
                if (disposition && disposition.indexOf('attachment') !== -1) {
                    var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    var matches = filenameRegex.exec(disposition);
                    if (matches != null && matches[1]) {
                        filename = matches[1].replace(/['"]/g, '');
                    }
                }

                // Create download link
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                // Cleanup
                setTimeout(function () {
                    window.URL.revokeObjectURL(link.href);
                    document.body.removeChild(link);
                }, 100);

                // Success message
                swal({
                    title: "Thành công!",
                    text: "Xuất file Excel thành công",
                    type: "success",
                    confirmButtonText: "OK"
                });
            })
            .catch(function (err) {
                // Hide loading
                $("[grid-loading]").removeClass("loading");

                // Log and show friendly message
                console.error("Export error:", err);
                swal({
                    title: "Lỗi!",
                    text: "Có lỗi xảy ra khi xuất file Excel. Vui lòng thử lại.",
                    type: "error",
                    confirmButtonText: "OK"
                });
            });
        }
    </script>
}
