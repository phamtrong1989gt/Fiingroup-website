@model PT.Domain.Model.CategoryModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.BaseSettings> _baseSettings
@{
    Layout = null;
    var fileUploadSingleBanner = new PT.Domain.Model.PluginFileUploadModel
    {
        Extention = _baseSettings.Value.ImagesType + ",.webp",
        InputName = "Banner",
        MaxSize = _baseSettings.Value.DocumentsMaxSize,
        UrlUpload = Url.Action("UploadImage", new { id = Model.Id, oldPath = Model.Banner, portalId = Model.PortalId }),
        UrlDelete = Url.Action("DeleteFile"),
        ParentTagName = "file-parent-photos-1",
        FileDataString = Model.Banner,
        IsS = true,
        IsSingle = true
    };
}
<form form-edit asp-action="Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Language" />

    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="categoryIds" />
    <input asp-for="Language" type="hidden" />
    <div class="sumaryValidateForm" asp-validation-summary="All"></div>
    <div class="modal-header">
        <h4 class="modal-title"><i class="material-icons">edit</i> CẬP NHẬT DANH MỤC - <span class="text-warning">@Model.PortalName</span> - <span class="text-danger">@PT.Shared.ListData.ListLanguage.FirstOrDefault(x => x.Id == Model.Language)?.Name </span></h4>
    </div>
    <button title="Đóng cửa sổ" type="button" class="close btnclose-t" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <div class="modal-body">
        <div class="divmodal">
            <div class="row">
                <div class="col-md-3">
                    <div class="labelinfo-t bg-info mb-10">
                        Ảnh đại diện
                    </div>
                    <div>
                        <partial name="_FileUploadSingle" model="@fileUploadSingleBanner" />
                    </div>
                    <div class="labelinfo-t bg-info mb-10">
                        CẤU HÌNH HIỂN THỊ
                    </div>
                    <div class="pt-5"></div>

                    <div class="row">
       @*                  <div class="col-md-12">
                            <div class="form-group">
                                <label>Tìm kiếm danh mục DC</label>
                                <input type="text" id="treeDCCategorySearch" class="form-control" placeholder="Nhập từ khóa tìm kiếm..." />
                            </div>
                        </div> *@
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Cây danh mục DC chọn để hiển thị</label>
                                <div id="treeDCCategory" style="max-height: 500px; overflow-y: auto; border: 1px solid #ddd; padding: 15px; background: #fff;"></div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>IDs đã chọn (ExCategoryIds)</label>
                                <input type="text" name="ExCategoryIds" class="form-control" placeholder="Các ID được chọn sẽ hiện ở đây..." readonly />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="checkbox" asp-for="Status" class="filled-in chk-col-green" />
                        <label for="Status" asp-for="Status"></label>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="panel-group panel-website full-body" id="accordion_19" role="tablist" aria-multiselectable="true">
                        <div class="panel panel-default">
                            <div class="panel-heading" role="tab" id="headingOne_1">
                                <h4 class="panel-title">
                                    <a role="button" data-toggle="collapse" href="#collapseOne_1" aria-expanded="true" aria-controls="collapseOne_1">
                                        <i class="material-icons">perm_contact_calendar</i> Thông tin chung
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseOne_1" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne_1">
                                <div class="panel-body">
                                    <div class="row">
                                        <input type="hidden" asp-for="PortalId" />
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="form-label" asp-for="CategoryType"></label> <strong class="text-danger">*</strong> <span asp-validation-for="CategoryType"></span>
                                                <div class="controls">
                                                    <select required data-live-search="true" asp-for="CategoryType" class="input-sm form-control-t show-tick">
                                                        <option value="">Chọn</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Blog">@PT.Domain.Model.ECategoryType.ContentPage_Blog.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Service">@PT.Domain.Model.ECategoryType.ContentPage_Service.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Solution">@PT.Domain.Model.ECategoryType.ContentPage_Solution.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Event">@PT.Domain.Model.ECategoryType.ContentPage_Event.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Publications">@PT.Domain.Model.ECategoryType.ContentPage_Publications.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Report">@PT.Domain.Model.ECategoryType.ContentPage_Report.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_Product">@PT.Domain.Model.ECategoryType.ContentPage_Product.GetDisplayName()</option>
                                                        <option value="@PT.Domain.Model.ECategoryType.ContentPage_FAQ">@PT.Domain.Model.ECategoryType.ContentPage_FAQ.GetDisplayName()</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" asp-for="Name"></label> <strong class="text-danger">*</strong> <span asp-validation-for="Name"></span>
                                        <div class="controls">
                                            <input type="text" seo-page-name class="form-control input-sm form-control-t" placeholder="Tên danh mục" asp-for="Name">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">

                                            <div class="form-group">
                                                <label class="form-label" asp-for="ExCategoryIds"></label> <span asp-validation-for="ExCategoryIds"></span> <small class="text-muted">(Hoặc chọn từ cây danh mục bên trái)</small>
                                                <div class="controls">
                                                    <input type="text" class="form-control input-sm form-control-t" placeholder="Ví dụ: 1,2,3" asp-for="ExCategoryIds">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label" asp-for="ReferentCategoryId"></label> <span asp-validation-for="ReferentCategoryId"></span>
                                                <div class="controls">

                                                    <select required data-live-search="true" asp-for="ReferentCategoryId" data-size="10" class="input-sm form-control-t show-tick" asp-items="Model.CMCategorySelectList">
                                                        <option value="">Chọn</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" asp-for="Summary"></label> <span asp-validation-for="Summary"></span>
                                        <div class="controls">
                                            <textarea id="ricktextSummary" class="form-control form-control-t" rows="3" placeholder="Tóm tắt" asp-for="Summary"></textarea>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" asp-for="Content"></label> <span asp-validation-for="Content"></span>
                                        <div class="controls">
                                            <textarea id="ricktextContent" seo-page-content class="form-control form-control-t" rows="3" placeholder="Mô tả" asp-for="Content"></textarea>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <partial name="_ReferenceModule" model="@(new PT.Domain.Model.LinkReferenceBaseModel() { Language =Model.Language , Type = Model.Type,LinkId = Model.LinkId, PortalId = Model.PortalId ?? 1 })" />
                        <partial name="_SeoModule" model="@(PT.Shared.MapModel<PT.Domain.Model.SeoModel>.Go(Model))" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer" style="text-align:center;">
        <a class="btn btn-icon btn-default waves-effect" data-dismiss="modal"><i class="material-icons">reply</i><span>Đóng</span></a>
        <button button-delete data-language="@Model.Language" data-action="@Url.Action("Delete",new { id=Model.Id})" data-retur-nurl="@PT.Shared.Functions.FormatReturnUrl(Context.Request.Query["returnurl"], Url.Action("Index"))" data-loading-text="<i class='material-icons icon-spin'>autorenew</i> <span>Xóa</span>" type="button" class="btn btn-icon  btn-p-t  btn-danger waves-effect"><i class="material-icons">delete_forever</i> <span>Xóa</span></button>
        <a button-submit data-language="@Model.Language" data-loading-text="<i class='material-icons icon-spin'>autorenew</i> <span>Lưu thay đổi</span>" class="btn btn-icon bg-indigo waves-effect"><i class="material-icons">save</i> <span>Lưu thay đổi</span></a>
    </div>
</form>
<script>
    initRickText("@Url.Action("UploadImage", new { type = 1, id = Model.Id, portalId = Model.PortalId })");
    
    // Initialize tree with pre-selected nodes based on ExCategoryIds
    getTreeDCCategory('@Model.Language', @Model.Id);
</script>