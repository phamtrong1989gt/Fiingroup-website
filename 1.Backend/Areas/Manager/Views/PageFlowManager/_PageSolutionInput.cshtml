<div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingOne_101">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#collapseOne_101" aria-expanded="true" aria-controls="headingOne_101">
                <i class="material-icons">perm_contact_calendar</i> GIẢI PHÁP HỖ TRỢ TỪ FiinGroup
            </a>
        </h4>
    </div>
    <div id="collapseOne_101" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne_101">
        <div class="panel-body">
            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-10"></div>
            </div>

            <div class="form-group">
                <label class="form-label" for="FilePath">Ảnh đại diện sản phẩm</label>
                <div class="input-group input-group-t">
                    <input readonly type="text" class="form-control input-sm form-control-t" asp-for="Input6">
                    <div class="input-group-addon btn-group-addon btn-group-addon-form-group">
                        <a button-open-file-manager data-img="imgBanner" data-target="Input6" class="btn btn-icon btn-danger waves-effect"><i class="material-icons">attach_file</i></a>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="input-group input-group-t">
                            <div class="input-group-addon br-none">Chọn sản phẩm</div>
                            <input type="hidden" asp-for="ContentPageRelatedIds" />
                            <select data-live-search="true" id="BlogId" data-action="@Url.Action("SearchContentPage", new { language = Model.Language, portalId = Model.PortalId })" name="BlogId" class="input-sm form-control-t show-tick with-ajax"></select>
                            <div class="input-group-addon btn-group-addon btn-group-addon-form-group">
                                <a button-add-related class="btn btn-icon bg-indigo waves-effect"><i class="material-icons">add</i> Thêm</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <table class="table table-striped table-bordered table-hover table-t">
                        <thead>
                            <tr>
                                <th style="width:40px;" class="text-center">Stt</th>
                                <th>Tên</th>
                                <th style="width:60px;">Xóa</th>
                            </tr>
                        </thead>
                        <tbody bind-related></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

