                <div class="col-md-2"></div>
                <div class="col-md-10"></div>
            </div>

            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Tiêu đề phụ</label>
                        <div class="controls">
                            <input type="text" class="form-control input-sm form-control-t" placeholder="" asp-for="Input1">
                        </div>
                    </div>
                </div>
                <div class="col-md-10">
                    <div class="form-group">
                        <label class="form-label">Tiêu đề chính</label>
