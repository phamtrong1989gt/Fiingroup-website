@model PT.Domain.Model.PageModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Options.IOptions<PT.Domain.Model.BaseSettings> _baseSettings
@{
    Layout = null;
    string altId = Guid.NewGuid().ToString();
    string pathUpload = Url.Action("UploadImage", new { altId, type = 1, id = 0 });

    var fileUploadSingleBanner = new PT.Domain.Model.PluginFileUploadModel
    {
        Extention = _baseSettings.Value.ImagesType,
        InputName = "Banner",
        MaxSize = _baseSettings.Value.DocumentsMaxSize,
        UrlUpload = Url.Action("UploadImage", new { id = Model.Id, oldPath = Model.Banner, altId }),
        UrlDelete = Url.Action("DeleteFile"),
        ParentTagName = "file-parent-photos-2",
        FileDataString = Model.Banner,
        IsS = true,
        IsSingle = true
    };
    string title = "";
    @if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_Flow)
    {
        title = "THÊM MỚI TRANG HỖ TRỢ DÒNG CHẢY";
    }
    else if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_FlowItems)
    {
        title = "THÊM MỚI TRANG SẢN PHẨM DÒNG CHẢY";
    }
    else if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_Solution)
    {
        title = "THÊM MỚI TRANG GIẢI PHÁP";
    }
}
<style>
    .tt-menu {
        z-index: 999999;
    }
</style>
<form form-edit asp-action="Create">
    <input type="hidden" asp-for="Language" />

    <input type="hidden" name="categoryIds" />
    @Html.AntiForgeryToken()
    <input asp-for="Language" type="hidden" />  
    <input type="hidden" name="altId" value="@altId" />
    <div class="sumaryValidateForm" asp-validation-summary="All"></div>
    <div class="modal-header">
        <h4 class="modal-title"><i class="material-icons">edit</i> @title - <span class="text-warning">@Model.PortalName</span> - <span class="text-danger">@PT.Shared.ListData.ListLanguage.FirstOrDefault(x => x.Id == Model.Language)?.Name </span></h4>
    </div>
    <button title="Đóng cửa sổ" type="button" class="close btnclose-t" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <div class="modal-body">
        <div class="divmodal">
            <div class="row">
                <div class="col-md-3">
                    <div class="labelinfo-t bg-info mb-10">
                        Ảnh đại diện
                    </div>
                    <div>
                        <partial name="_FileUploadSingle" model="@fileUploadSingleBanner" />
                    </div>
                    <div class="labelinfo-t bg-info mb-10">
                        CẤU HÌNH HIỂN THỊ
                    </div>
                    <div class="pt-5"></div>
                    <div class="form-group">
                        <input type="checkbox" asp-for="Status" class="filled-in chk-col-green" />
                        <label for="Status" asp-for="Status"></label>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="panel-group panel-website full-body" id="accordion_19" role="tablist" aria-multiselectable="true">
                        <input type="hidden" asp-for="CategoryType" />
                        @if(Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_Flow)
                        {
                            <partial name="_PageFlowInput" model="@Model" />
                        }
                        else if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_FlowItems)
                        {
                            <partial name="_PageFlowItemInput" model="@Model" />
                        }
                        else if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_Solution)
                        {
                            <partial name="_PageSolutionInput" model="@Model" />
                        }
                        <input type="hidden" asp-for="ContentPageRelatedIds" />
                        <partial name="_ReferenceModule" model="@(new PT.Domain.Model.LinkReferenceBaseModel() { Language = Model.Language, Type = Model.Type, LinkId = Model.LinkId, PortalId = Model.PortalId })" />
                        <partial name="_SeoModule" model="@(PT.Shared.MapModel<PT.Domain.Model.SeoModel>.Go(Model))" />
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="modal-footer" style="text-align:center;">
        <a class="btn btn-icon btn-default waves-effect" data-dismiss="modal"><i class="material-icons">reply</i><span>Đóng</span></a>
        <a button-submit data-language="@Model.Language" data-loading-text="<i class='material-icons icon-spin'>autorenew</i> <span>Lưu thay đổi</span>" class="btn btn-icon bg-indigo waves-effect"><i class="material-icons">save</i> <span>Lưu thay đổi</span></a>
    </div>
</form>
<script>;
    $("[name='DatePosted']").toDateTimePicker();
    $("[name='Lastmod']").toDateTimePicker();
    initAutoComplate();
    paseRelated(@Html.Raw(Model.RelatedString));
</script>

@if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_Flow)
{
    <script>
        setTimeout(function () {
          pageEditors = createEditors(["Input4", "Input6"]);
        }, 200);
    </script>
}
else if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_FlowItems)
{
    <script>
        setTimeout(function () {
             pageEditors = createEditors(["Input3","Input4", "Input5", "Input6", "Input7"]);
        }, 200);
    </script>
}
else if (Model.CategoryType == PT.Domain.Model.ECategoryType.ContentPage_Solution)
{
    <script>
        setTimeout(function () {
             pageEditors = createEditors(["Input3","Input4", "Input5", "Input6", "Input7", "Input8"]);
        }, 200);
    </script>
}