@model PT.Domain.Model.PageModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingOne_1">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#collapseOne_1" aria-expanded="true" aria-controls="collapseOne_1">
                <i class="material-icons">perm_contact_calendar</i> Thông tin chung (hiển thị ngoài trang chủ)
            </a>
        </h4>
    </div>
    <div id="collapseOne_1" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne_1">
        <div class="panel-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label" asp-for="Name"></label> <strong class="text-danger">*</strong> <span asp-validation-for="Name"></span>
                        <div class="controls">
                            <input type="text" seo-page-name onkeydown="GenSlug()" onkeyup="GenSlug()" class="form-control input-sm form-control-t" placeholder="" asp-for="Name">
                        </div>
                    </div>
                </div>
                <input type="hidden" asp-for="PortalId" />
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Summary"></label> <span asp-validation-for="Summary"></span>
                <div class="controls">
                    <textarea id="ricktextSummary" class="form-control form-control-t" rows="3" placeholder="Tóm tắt" asp-for="Summary"></textarea>
                </div>
            </div>
            <input asp-for="Content" type="hidden" seo-page-content />
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label" asp-for="Order"></label> <span asp-validation-for="Order"></span>
                        <div class="controls">
                            <input type="number" class="form-control input-sm form-control-t" placeholder="" asp-for="Order">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingOne_100">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#collapseOne_100" aria-expanded="true" aria-controls="headingOne_100">
                <i class="material-icons">perm_contact_calendar</i> THÔNG TIN TRANG CHI TIẾT
            </a>
        </h4>
    </div>
    <div id="collapseOne_100" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne_100">
        <div class="panel-body">

            <div class="form-group">
                <div style="margin-bottom:10px;">
                    <img style="height:200px;" onerror="this.onerror=null;this.src = '/Content/Admin/images/no-avatar.jpg';" id="imgInput12" class="img-thumbnail img-preview-t" src="@(Model.Input12 ?? "/Content/Admin/images/no-avatar.jpg")" alt="Ảnh Head" />
                </div>
                <label class="form-label" for="FilePath">Ảnh Head</label>
                <div class="input-group input-group-t">
                    <input type="text" class="form-control input-sm form-control-t" asp-for="Input12">
                    <div class="input-group-addon btn-group-addon btn-group-addon-form-group">
                        <a button-open-file-manager data-img="imgInput12" data-target="Input12" class="btn btn-icon btn-danger waves-effect"><i class="material-icons">attach_file</i></a>
                    </div>
                </div>
            </div>

            <div>
                <div class="form-group">
                    <input type="checkbox" asp-for="IsShowHeaderContent" class="filled-in chk-col-green" />
                    <label for="IsShowHeaderContent" asp-for="IsShowHeaderContent"></label>
                </div>
            </div>

            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Tiêu đề mini</label>
                        <div class="controls">
                            <input type="text" class="form-control input-sm form-control-t" placeholder="" asp-for="Input1">
                        </div>
                    </div>
                </div>
                <div class="col-md-10">
                    <div class="form-group">
                        <label class="form-label">Tiêu đề chính</label>
                        <div class="controls">
                            <input type="text" class="form-control input-sm form-control-t" placeholder="" asp-for="Input2">
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Mô tả dòng chảy</label>
                <div class="controls">
                    <textarea class="form-control form-control-t" placeholder="" asp-for="Input3"></textarea>
                </div>
            </div>

           
        </div>
    </div>
</div>

<div class="panel panel-default">
