              // Utility to initialize CodeMirror editors for a set of textarea IDs.
        // Usage:
        //   const editors = createEditors(['Input1','Input2'], { defaultOptions });
        //   editors.refreshAll();
        //   editors.syncAllToTextareas();
        //   editors.disposeAll();
        var pageEditors;
        function createEditors(ids = [], globalOptions = {}) {
          const instances = {};

          const defaultOptions = {
            lineNumbers: true,
            mode: "text/html",
            matchBrackets: true,
            lineWrapping: true,
            autoRefresh: true
          };

          ids.forEach(id => {
            const ta = document.getElementById(id);
            if (!ta || ta.nodeName.toLowerCase() !== "textarea") return;
            try {
              const opts = Object.assign({}, defaultOptions, globalOptions[id] || {});
              instances[id] = CodeMirror.fromTextArea(ta, opts);
            } catch (err) {
              console.error(`createEditors: failed to init editor for ${id}`, err);
            }
          });

          return {
            instances,
            get(id) {
              return instances[id];
            },
            // Refresh all editors (useful after tab change / hidden -> visible)
            refreshAll() {
              Object.values(instances).forEach(ed => ed && ed.refresh && ed.refresh());
            },
            // Write editor contents back to corresponding textareas
            syncAllToTextareas() {
              Object.entries(instances).forEach(([id, ed]) => {
                try {
                  const ta = document.getElementById(id);
                  if (ta) ta.value = ed.getValue();
                } catch (err) { /* ignore per-editor error */ }
              });
            },
            // Dispose editors and put content back into original textarea
            disposeAll() {
              Object.entries(instances).forEach(([id, ed]) => {
                try {
                  if (ed && ed.toTextArea) ed.toTextArea();
                } catch (err) { /* ignore */ }
              });
              // clear collection
              for (const k in instances) delete instances[k];
            },
            // Convenience: init specific editor later
            initOne(id, options = {}) {
              const ta = document.getElementById(id);
              if (!ta) return null;
              const opts = Object.assign({}, defaultOptions, globalOptions[id] || {}, options);
              instances[id] = CodeMirror.fromTextArea(ta, opts);
              return instances[id];
            }
          };
        }
