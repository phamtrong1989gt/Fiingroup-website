@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, PT.UI
@{
    Layout = "~/Views/Shared/_Admin.cshtml";
}
<style>
    .bootstrap-tagsinput input {
        width: 500px !important;
    }
</style>
<div class="container" style="margin-top:40px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div style="text-align: center;">
            <h1>HỆ THỐNG QUẢN TRỊ WEBSITE</h1>
            <h6>V 10.2.0 <span style="font-size:10px;">23-12-2025</span></h6>
        </div>
        <div>
            <button id="refreshMetrics" class="btn btn-sm btn-primary">Refresh</button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @await Html.PartialAsync("_Metrics")
        </div>
    </div>
</div>

<script>
    document.getElementById('refreshMetrics').addEventListener('click', function(){
        // re-load the partial metrics by calling the Metrics endpoint and re-rendering using the same logic in the partial
        fetch('/Admin/Metrics').then(r => r.json()).then(res => {
            if(res.output === 1){
                // delegate to partial render function if available
                if(typeof renderMetrics === 'function') renderMetrics(res.data);
            }
        });
    });
</script>
