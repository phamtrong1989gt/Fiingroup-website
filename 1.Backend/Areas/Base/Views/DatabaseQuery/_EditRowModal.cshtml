<!-- Edit Row Modal -->
<div id="editRowModal" class="script-modal">
    <div class="script-modal-content" style="max-width: 600px;">
        <div class="script-modal-header">
            <h3><i class="material-icons" style="vertical-align: middle;">edit</i> Chỉnh sửa dòng dữ liệu</h3>
            <span class="script-modal-close" onclick="closeEditRowModal()">&times;</span>
        </div>
        <div id="editRowForm"></div>
        <div style="margin-top: 15px; text-align: right;">
            <button class="btn btn-secondary" onclick="closeEditRowModal()">Hủy</button>
            <button class="btn btn-success" onclick="saveRow()">
                <i class="material-icons" style="vertical-align: middle; font-size: 16px;">save</i> Lưu
            </button>
        </div>
    </div>
</div>

<!-- Full Backup Modal -->
<div id="fullBackupModal" class="script-modal">
    <div class="script-modal-content" style="max-width: 700px; max-height: 80vh;">
        <div class="script-modal-header">
            <h3><i class="material-icons" style="vertical-align: middle;">backup</i> Full Database Backup</h3>
            <span class="script-modal-close" onclick="closeFullBackupModal()">&times;</span>
        </div>
        <div style="margin-bottom: 15px;">
            <input type="text" id="backupSearchTable" placeholder="Tìm kiếm table..." 
                   style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
                   onkeyup="filterBackupTables()" />
        </div>
        <div style="margin-bottom: 15px; padding: 10px; background: #f0f0f0; border-radius: 4px;">
            <label>
                <input type="checkbox" id="selectAllTables" onchange="toggleSelectAllTables()" />
                <strong>Chọn tất cả (<span id="selectedTableCount">0</span>/<span id="totalTableCount">0</span>)</strong>
            </label>
            <span style="float: right;">
                Giới hạn rows/table:
                <input type="number" id="backupRowLimit" value="10000" min="100" max="100000" 
                       style="width: 100px; padding: 4px; border: 1px solid #ddd; border-radius: 4px;" />
            </span>
        </div>
        <div id="backupTablesList" style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; border-radius: 4px; padding: 10px;"></div>
        <div style="margin-top: 15px; text-align: right;">
            <button class="btn btn-secondary" onclick="closeFullBackupModal()">Hủy</button>
            <button class="btn btn-success" onclick="generateFullBackup()">
                <i class="material-icons" style="vertical-align: middle; font-size: 16px;">download</i> Generate Backup
            </button>
        </div>
    </div>
</div>

<!-- Query Action Modal -->
<div id="queryActionModal" class="script-modal">
    <div class="script-modal-content" style="max-width: 800px;">
        <div class="script-modal-header">
            <h3 id="queryActionTitle"><i class="material-icons" style="vertical-align: middle;">code</i> Query Action</h3>
            <span class="script-modal-close" onclick="closeQueryActionModal()">&times;</span>
        </div>
        <div id="queryActionContent" style="padding: 20px;"></div>
    </div>
</div>

