@model PT.Domain.Model.BaseSearchModel<List<PT.Domain.Model.Link>>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    int i = 1;
}
<tr style="display:none !important;">
    <td colspan="999999">
        <input type="hidden" grid-data-page value="@Model.Page" />
        <input type="hidden" grid-data-totalrows value="@Model.TotalRows" />
        <input type="hidden" grid-data-limit value="@Model.Limit" />
    </td>
</tr>
@if (Model.TotalRows == 0)
{
    <tr>
        <td colspan="999">Không tìm thấy bản ghi nào</td>
    </tr>
}
@foreach (var item in Model.Data)
{
    <tr class="tr-status-@(item.IncludeSitemap)">
        <td class="text-center">@PT.Shared.Functions.GenSTT(i, Model.Page, Model.Limit)</td>
        <td>
            <div>@item.Name</div>
            <div><a target="_blank" href="@item.FullPath">@item.FullPath</a></div>
        </td>
        <td>@item.Priority.ConvertToString()</td>
        <td>@item.Type.GetDisplayName()</td>
        <td>
            <div class="text-info">@(item.Title ?? "- - -")</div>
            <div>@(item.Description ?? "- - - ")</div>
        </td>
        <td>@item.Redirect301</td>
        <td>
            @if (item.IncludeSitemap)
            {
                <span class="label label-success">Có</span>
            }
            else
            {
                <span class="label label-danger">Không</span>
            }
        </td>
        <td>
            @if (item.Status)
            {
                <span class="label label-success">Có</span>
            }
            else
            {
                <span class="label label-danger">Không</span>
            }
        </td>
        <td>
            @if (item.Delete)
            {
                <span class="label label-danger">Xóa</span>
            }
            else
            {
                <span class="label label-default">Không</span>
            }
        </td>
        <partial name="_AdminTbodyTableModule" model="@(new Tuple<List<PT.Domain.Model.LinkReference>, string, string, bool>(item.LinkReferences, item.Language, Url.Action("Edit", new { id = "#Id#" }), true))" />
        <td>@item.Portal?.Name</td>
        <td>
            <div class="btn-group">
                <div class="btn-group btn- group-sm" role="group">
                    <a button-popup data-target="#myModalBig" asp-action="Edit" asp-route-id="@item.Id" title="Cập nhật" class="btn bg-indigo waves-effect btncontrolgrid"><i class="material-icons iconcontrol">edit</i></a>
                </div>
            </div>
        </td>
    </tr>
    i++;
}