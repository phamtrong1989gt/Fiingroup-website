@{
    Layout = "~/Views/Shared/_Admin.cshtml";
    // Lấy portalId từ query string nếu có, fallback sang Model.PortalId
    int iframePortalId = 0;
    var qPortal = Context.Request.Query["portalId"].FirstOrDefault();
    if (!string.IsNullOrEmpty(qPortal) && int.TryParse(qPortal, out var parsed))
    {
        iframePortalId = parsed;
    }
    else if (Model != null)
    {
        // Nếu view model có PortalId dùng nó
        try { iframePortalId = Model.PortalId; } catch { iframePortalId = 0; }
    }
}
<style>
    .bootstrap-tagsinput input {
        width: 500px !important;
    }
</style>
<div>
    <iframe frameborder="0" border="0" cellspacing="0" src="@Url.Action("Manager", new { portalId = iframePortalId })" style="width:100%;height:800px;"></iframe>
</div>